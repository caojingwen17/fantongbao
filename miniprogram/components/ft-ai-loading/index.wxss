.ft-ai-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 1600;
  background: linear-gradient(160deg, #fff5ec 0%, #ffe4c4 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  animation: ft-fade-in 0.2s ease-out both;
}
.ft-ai-finishing {
  animation: ft-fade-in 0.2s ease-out both;
}

.ft-ai-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx;
  animation: ft-scale-in 0.26s cubic-bezier(0.34, 1.4, 0.64, 1) both;
}

/* 锅 */
.ft-ai-pot {
  position: relative;
  width: 180rpx;
  height: 200rpx;
  margin-bottom: 32rpx;
}
.ft-ai-body {
  position: absolute;
  left: 20rpx;
  right: 20rpx;
  bottom: 36rpx;
  height: 84rpx;
  border-radius: 16rpx 16rpx 60rpx 60rpx;
  background: linear-gradient(135deg, #874e00 0%, #ff9800 100%);
  box-shadow: 0 12rpx 28rpx rgba(135, 78, 0, 0.28);
}
.ft-ai-lid {
  position: absolute;
  left: 12rpx;
  right: 12rpx;
  bottom: 112rpx;
  height: 22rpx;
  border-radius: 9999rpx;
  background: #fff0e5;
  box-shadow: 0 4rpx 10rpx rgba(135, 78, 0, 0.18);
  animation: ft-ai-lid-bounce 1.4s ease-in-out infinite;
}
@keyframes ft-ai-lid-bounce {
  0%, 100% { transform: translateY(0) rotate(0deg); }
  50% { transform: translateY(-8rpx) rotate(-2deg); }
}
.ft-ai-pot-done .ft-ai-lid {
  animation: none;
}

/* 蒸汽 */
.ft-ai-steam {
  position: absolute;
  bottom: 140rpx;
  width: 14rpx;
  height: 34rpx;
  border-radius: 9999rpx;
  background: rgba(135, 78, 0, 0.28);
  animation: ft-ai-steam-rise 1.6s ease-in-out infinite;
}
.ft-ai-steam-1 { left: 56rpx; animation-delay: 0s; }
.ft-ai-steam-2 { left: 84rpx; animation-delay: 0.4s; }
.ft-ai-steam-3 { left: 112rpx; animation-delay: 0.8s; }
@keyframes ft-ai-steam-rise {
  0% { transform: translateY(8rpx) scaleY(0.6); opacity: 0; }
  40% { opacity: 1; }
  100% { transform: translateY(-36rpx) scaleY(1.2); opacity: 0; }
}

/* 火苗 */
.ft-ai-flames {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  justify-content: center;
  gap: 18rpx;
}
.ft-ai-flame {
  width: 16rpx;
  height: 26rpx;
  border-radius: 50% 50% 50% 50% / 60% 60% 40% 40%;
  background: linear-gradient(to top, #ff9800, #ffd166);
  animation: ft-ai-flame-flicker 0.7s ease-in-out infinite;
}
.ft-ai-flame-2 { animation-delay: 0.2s; }
.ft-ai-flame-3 { animation-delay: 0.35s; }
@keyframes ft-ai-flame-flicker {
  0%, 100% { transform: scaleY(1); opacity: 0.9; }
  50% { transform: scaleY(1.25); opacity: 1; }
}

/* 文案 */
.ft-ai-stage {
  font-size: 38rpx;
  font-weight: 900;
  color: #432900;
  animation: ft-fade-up 0.3s ease-out both;
}
.ft-ai-sub {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #765524;
}

/* 进度条 */
.ft-ai-progress {
  margin-top: 32rpx;
  width: 420rpx;
  height: 14rpx;
  border-radius: 9999rpx;
  background: rgba(135, 78, 0, 0.12);
  overflow: hidden;
}
.ft-ai-progress-bar {
  height: 100%;
  border-radius: 9999rpx;
  background: linear-gradient(90deg, #874e00, #ff9800);
  transition: width 0.5s ease-out;
}
.ft-ai-time {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: rgba(118, 85, 36, 0.65);
}
