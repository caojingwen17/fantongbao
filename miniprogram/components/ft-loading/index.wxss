.ft-pl-wrap {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 1500;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 245, 236, 0.35);
  backdrop-filter: blur(6rpx);
  animation: ft-fade-in 0.16s ease-out both;
}
.ft-pl-through {
  pointer-events: none;
  background: transparent;
  backdrop-filter: none;
}
.ft-pl-closing {
  animation: ft-fade-out 0.16s ease-out both;
}
.ft-pl-card {
  min-width: 200rpx;
  max-width: 420rpx;
  padding: 36rpx 40rpx;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 20rpx 56rpx rgba(67, 41, 0, 0.18);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
  animation: ft-scale-in 0.22s cubic-bezier(0.34, 1.4, 0.64, 1) both;
}
.ft-pl-closing .ft-pl-card {
  animation: ft-scale-out 0.16s ease-out both;
}
.ft-pl-ring {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  border: 5rpx solid rgba(135, 78, 0, 0.12);
  border-top-color: var(--ft-primary, #874e00);
  animation: ft-pl-spin 0.7s linear infinite;
}
@keyframes ft-pl-spin {
  to {
    transform: rotate(360deg);
  }
}
.ft-pl-text {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--ft-on-surface-variant, #765524);
  text-align: center;
  line-height: 1.4;
}
