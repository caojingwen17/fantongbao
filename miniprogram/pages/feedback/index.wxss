.feedback-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  position: relative;
  overflow: hidden;
}

.blob {
  position: absolute;
  border-radius: 9999rpx;
  pointer-events: none;
  filter: blur(60rpx);
}

.blob-a {
  width: 520rpx;
  height: 520rpx;
  right: -200rpx;
  top: -220rpx;
  background: var(--ft-secondary-fixed, #f9e534);
  opacity: 0.18;
}

.blob-b {
  width: 520rpx;
  height: 520rpx;
  left: -240rpx;
  top: 320rpx;
  background: var(--ft-tertiary-fixed, #91f78e);
  opacity: 0.12;
}

.main {
  position: relative;
  z-index: 1;
  flex: 1;
  min-height: 0;
}

.main-inner {
  padding: 20rpx 40rpx calc(52rpx + env(safe-area-inset-bottom));
}

.card {
  background: var(--ft-surface, #fff);
  border-radius: 28rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(120, 53, 15, 0.06);
}

.intro-card {
  background: rgba(249, 229, 52, 0.12);
}

.intro-text {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--ft-on-surface-variant);
  line-height: 1.55;
}

.seg-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.seg-item {
  flex: 1;
  text-align: center;
  padding: 22rpx 16rpx;
  border-radius: 9999rpx;
  font-size: 28rpx;
  font-weight: 900;
  color: var(--ft-on-surface-variant);
  background: var(--ft-surface-container);
}

.seg-on {
  background: #f9e534;
  color: #422006;
}

.fb-textarea {
  width: 100%;
  min-height: 280rpx;
  padding: 24rpx 28rpx;
  box-sizing: border-box;
  border-radius: 24rpx;
  background: var(--ft-surface-container-lowest);
  font-size: 28rpx;
  line-height: 1.5;
  color: var(--ft-on-surface);
}

.counter {
  margin-top: 12rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: var(--ft-on-surface-variant);
  text-align: right;
}

.submit-btn {
  margin-top: 28rpx;
}
