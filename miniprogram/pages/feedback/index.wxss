.feedback-page {
  min-height: 100vh;
  position: relative;
  overflow: hidden;
}

.blob {
  position: absolute;
  border-radius: 9999rpx;
  pointer-events: none;
  filter: blur(60rpx);
}

.blob-a {
  width: 520rpx;
  height: 520rpx;
  right: -200rpx;
  top: -220rpx;
  background: var(--ft-secondary-fixed, #f9e534);
  opacity: 0.18;
}

.blob-b {
  width: 520rpx;
  height: 520rpx;
  left: -240rpx;
  top: 320rpx;
  background: var(--ft-tertiary-fixed, #91f78e);
  opacity: 0.12;
}

.topbar {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  z-index: 50;
  padding: 70rpx 40rpx 0;
  padding-top: calc(80rpx + constant(safe-area-inset-top));
  padding-top: calc(80rpx + env(safe-area-inset-top));
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: rgba(255, 247, 237, 0.82);
  backdrop-filter: blur(12rpx);
}

.top-left {
  display: flex;
  align-items: center;
  gap: 18rpx;
  min-width: 0;
}

.icon-btn {
  width: 80rpx;
  height: 80rpx;
  border-radius: 9999rpx;
  background: var(--ft-surface-container-lowest);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--ft-on-surface-variant);
}

.ico {
  font-size: 42rpx;
  font-weight: 900;
  line-height: 1;
  transform: translateY(-2rpx);
}

.top-title {
  font-size: 34rpx;
  font-weight: 900;
  letter-spacing: -0.5rpx;
}

.top-spacer {
  width: 80rpx;
  height: 80rpx;
}

.main {
  position: relative;
  z-index: 1;
  height: 100vh;
  padding-top: calc(246rpx + constant(safe-area-inset-top));
  padding-top: calc(246rpx + env(safe-area-inset-top));
}

.main-inner {
  padding: 0 40rpx calc(52rpx + env(safe-area-inset-bottom));
}

.card {
  background: var(--ft-surface, #fff);
  border-radius: 28rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(120, 53, 15, 0.06);
}

.intro-card {
  background: rgba(249, 229, 52, 0.12);
}

.intro-text {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--ft-on-surface-variant);
  line-height: 1.55;
}

.seg-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.seg-item {
  flex: 1;
  text-align: center;
  padding: 22rpx 16rpx;
  border-radius: 9999rpx;
  font-size: 28rpx;
  font-weight: 900;
  color: var(--ft-on-surface-variant);
  background: var(--ft-surface-container);
}

.seg-on {
  background: #f9e534;
  color: #422006;
}

.fb-textarea {
  width: 100%;
  min-height: 280rpx;
  padding: 24rpx 28rpx;
  box-sizing: border-box;
  border-radius: 24rpx;
  background: var(--ft-surface-container-lowest);
  font-size: 28rpx;
  line-height: 1.5;
  color: var(--ft-on-surface);
}

.counter {
  margin-top: 12rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: var(--ft-on-surface-variant);
  text-align: right;
}

.submit-btn {
  margin-top: 28rpx;
  height: 96rpx;
  border-radius: 9999rpx;
  background: linear-gradient(135deg, #874e00 0%, #ff9800 100%);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 900;
}

.submit-btn.disabled {
  opacity: 0.5;
  pointer-events: none;
}
