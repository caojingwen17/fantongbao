<view class="ft-page shopping-page">
  <ft-loading id="ft-loading" />
  <view class="blob blob-a"></view>
  <view class="blob blob-b"></view>

  <ft-topbar title="买菜清单" custom-back bind:back="goBack" />

  <scroll-view
    scroll-y="true"
    class="main"
    show-scrollbar="false"
    scrollbar-hidden="true"
    enhanced="true"
    refresher-enabled
    refresher-triggered="{{refreshing}}"
    bindrefresherrefresh="onRefresh"
  >
    <view class="main-inner">
      <view class="ft-loading-mask" wx:if="{{checklistLoading}}">
        <view class="ft-loading-mark"><view class="ft-ico ft-ico-cook"></view></view>
        <view class="ft-loading-dots">
          <view class="ft-loading-dot"></view>
          <view class="ft-loading-dot"></view>
          <view class="ft-loading-dot"></view>
        </view>
        <text class="ft-loading-text">加载采购清单…</text>
      </view>

      <view class="header-card" wx:if="{{!checklistLoading}}">
        <view class="header-row">
          <view>
            <view class="head-kicker">{{combined ? "一起买 · " + orders.length + " 单" : "点菜单"}}</view>
            <view class="head-name" wx:if="{{combined}}">{{orders.length ? orders[0].orderName : order.orderName}} 等 {{orders.length}} 单</view>
            <view class="head-name" wx:else>{{order.orderName || "未命名点菜单"}}</view>
            <view class="head-progress">采购进度：<text class="head-progress-v">{{progress.doneCount}}/{{progress.totalCount}}</text></view>
          </view>
          <view class="head-icon">
            <view class="ft-ico ft-ico-basket"></view>
          </view>
        </view>
      </view>

      <view class="section-head" wx:if="{{!checklistLoading}}">
        <view class="section-title">归并清单</view>
        <view
          class="manual-del-btn {{(order.status!=='pending_shopping' || !manualItemIdsFlat || !manualItemIdsFlat.length) ? 'hidden' : ''}}"
          bindtap="onDeleteManualAll"
          aria-label="删除手动项"
        >
          删除手动项
        </view>
      </view>

      <view class="items-group" wx:if="{{!checklistLoading && viewItems && viewItems.length}}">
        <view class="group-title-row" wx:if="{{viewItemsSeasoning && viewItemsSeasoning.length}}">
          <view class="group-title">调料</view>
          <view
            class="season-all-btn {{(order.status!=='pending_shopping' || actionBusy) ? 'hidden' : ''}}"
            bindtap="onConfirmAllSeasonings"
            aria-label="调料全部确认"
          >
            全部确认
          </view>
        </view>
        <view class="items" wx:if="{{viewItemsSeasoning && viewItemsSeasoning.length}}">
          <block wx:for="{{viewItemsSeasoning}}" wx:key="key">
            <view class="item-card" bindtap="onCheckItem" data-itemids="{{item.itemIds}}" data-alldone="{{item.allDone}}">
              <view
                class="cb {{item.allDone ? 'cb-on' : ''}} {{(order.status !== 'pending_shopping') ? 'cb-dis' : ''}}"
                aria-label="勾选采购项"
              ></view>
              <view class="item-mid">
                <view class="item-name">{{item.displayName}}</view>
                <view class="item-sub">{{item.displaySource}}</view>
              </view>
              <view class="item-tag {{item.tagClass}}">{{item.tagText}}</view>
            </view>
          </block>
        </view>

        <view class="group-title-row" wx:if="{{viewItemsFood && viewItemsFood.length}}">
          <view class="group-title">食材</view>
          <view
            class="season-all-btn {{(order.status!=='pending_shopping' || actionBusy) ? 'hidden' : ''}}"
            bindtap="onConfirmAllFood"
          >
            全部确认
          </view>
        </view>
        <view class="items" wx:if="{{viewItemsFood && viewItemsFood.length}}">
          <block wx:for="{{viewItemsFood}}" wx:key="key">
            <view class="item-card" bindtap="onCheckItem" data-itemids="{{item.itemIds}}" data-alldone="{{item.allDone}}">
              <view
                class="cb {{item.allDone ? 'cb-on' : ''}} {{(order.status !== 'pending_shopping') ? 'cb-dis' : ''}}"
                aria-label="勾选采购项"
              ></view>
              <view class="item-mid">
                <view class="item-name">{{item.displayName}}</view>
                <view class="item-sub">{{item.displaySource}}</view>
              </view>
              <view class="item-tag {{item.tagClass}}">{{item.tagText}}</view>
            </view>
          </block>
        </view>
      </view>
      <view class="ft-empty" wx:if="{{!checklistLoading && (!viewItems || viewItems.length===0)}}">
        <view class="ft-ico ft-ico-cart ft-ico-lg"></view>
        <view class="ft-empty-title">暂无采购清单</view>
        <view class="ft-empty-sub">去继续加菜生成清单</view>
      </view>

      <view class="bottom-spacer" aria-hidden="true"></view>
    </view>
  </scroll-view>

  <view class="ft-bottom-bar">
    <view class="ft-btn ft-btn-primary ft-btn-block {{actionBusy ? 'disabled' : ''}}" bindtap="onCompleteShopping">
      完成买菜
    </view>
  </view>

  <view class="expense-mask ft-anim-mask" wx:if="{{expenseDialogVisible}}" catchtap="closeExpenseDialog">
    <view class="expense-sheet ft-anim-sheet" catchtap="noop">
      <view class="expense-head">
        <view>
          <view class="expense-kicker">记录消费</view>
          <view class="expense-title">这次买菜花了多少钱？</view>
        </view>
        <view class="expense-close" bindtap="closeExpenseDialog">×</view>
      </view>
      <view class="expense-input-wrap">
        <text class="expense-yen">¥</text>
        <input
          class="expense-input"
          type="digit"
          placeholder="0.00"
          value="{{expenseInput}}"
          bindinput="onExpenseInput"
          focus="{{expenseDialogVisible}}"
        />
      </view>
      <view class="expense-hint" wx:if="{{combined}}">金额将平摊到 {{orderIds.length}} 个点菜单，并同步到家庭干饭日历</view>
      <view class="expense-hint" wx:else>填写后可在家族干饭日历中查看每日消费</view>

      <view class="expense-actions">
        <view class="expense-btn skip" bindtap="onSkipExpense">跳过</view>
        <view class="expense-btn ok" bindtap="onConfirmExpense">确认</view>
      </view>
    </view>
  </view>

  <ft-modal
    visible="{{confirmModal.visible}}"
    kicker="{{confirmModal.kicker}}"
    title="{{confirmModal.title}}"
    content="{{confirmModal.content}}"
    confirm-text="{{confirmModal.confirmText}}"
    danger="{{confirmModal.danger}}"
    bind:confirm="onConfirmModalOk"
    bind:cancel="onConfirmModalCancel"
  />
</view>

