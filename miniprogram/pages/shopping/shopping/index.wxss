.shopping-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  position: relative;
  overflow: hidden;
}

.blob {
  position: absolute;
  border-radius: 9999rpx;
  pointer-events: none;
  filter: blur(60rpx);
}
.blob-a {
  width: 512rpx;
  height: 512rpx;
  right: -192rpx;
  top: -192rpx;
  background: #f9e534;
  opacity: 0.18;
}
.blob-b {
  width: 512rpx;
  height: 512rpx;
  left: -192rpx;
  top: 416rpx;
  background: #91f78e;
  opacity: 0.12;
}

.main {
  position: relative;
  z-index: 1;
  flex: 1;
  height: auto;
}
.main::-webkit-scrollbar { display: none; }
.main-inner {
  padding: 20rpx 40rpx 0;
  padding-bottom: calc(220rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(220rpx + env(safe-area-inset-bottom));
}

.header-card {
  background: var(--ft-surface-container-lowest);
  border-radius: 32rpx;
  padding: 32rpx;
  margin-bottom: 20rpx;
}
.header-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}
.head-kicker { font-size: 18rpx; font-weight: 900; letter-spacing: 2rpx; color: var(--ft-on-surface-variant); }
.head-name { margin-top: 8rpx; font-size: 50rpx; font-weight: 900; letter-spacing: -0.6rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 420rpx; }
.head-progress { margin-top: 8rpx; font-size: 24rpx; color: var(--ft-on-surface-variant); font-weight: 700; }
.head-progress-v { color: var(--ft-primary); font-weight: 900; }
.head-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 9999rpx;
  background: #f9e534;
  color: #5b5300;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
}
.section-head { display: flex; align-items: center; justify-content: space-between; padding: 0 4rpx; margin-bottom: 10rpx; }
.section-title { font-size: 26rpx; font-weight: 900; }
.manual-del-btn {
  font-size: 20rpx;
  font-weight: 900;
  color: var(--ft-error);
  padding: 8rpx 16rpx;
  border-radius: 9999rpx;
  background: rgba(249, 86, 48, 0.15);
}

.items { display: flex; flex-direction: column; gap: 12rpx; }
.items-group { display: flex; flex-direction: column; gap: 10rpx; }
.group-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 8rpx;
}
.group-title {
  padding: 2rpx 0;
  font-size: 22rpx;
  font-weight: 900;
  color: var(--ft-on-surface-variant);
  letter-spacing: 1rpx;
}
.season-all-btn {
  font-size: 18rpx;
  font-weight: 900;
  color: #6b4a1f;
  background: #f3dcc2;
  padding: 8rpx 14rpx;
  border-radius: 9999rpx;
}
.item-card {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  background: var(--ft-surface-container-lowest);
  border-radius: 32rpx;
  padding: 24rpx;
}

.cb {
  width: 36rpx;
  height: 36rpx;
  border-radius: 9999rpx;
  border: 2rpx solid #ffe4c4;
  box-sizing: border-box;
  background: #ffffff;
  margin-top: 6rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.cb-on {
  background: #874e00;
  border-color: #874e00;
}
.cb-on::after {
  content: "✓";
  color: #fff;
  font-size: 20rpx;
  line-height: 1;
  font-weight: 900;
}
.cb-dis { opacity: 0.45; }

.item-mid { flex: 1; min-width: 0; }
.item-name { font-size: 34rpx; font-weight: 900; color: var(--ft-on-surface); }
.item-sub { margin-top: 8rpx; font-size: 20rpx; color: var(--ft-on-surface-variant); font-weight: 700; }
.item-tag {
  font-size: 16rpx;
  font-weight: 900;
  padding: 6rpx 14rpx;
  border-radius: 9999rpx;
  margin-left: 8rpx;
}
.item-tag.food { background: #f9e534; color: #5b5300; }
.item-tag.seasoning { background: #91f78e; color: #005e17; }
.item-tag.manual { background: var(--ft-surface-container); color: var(--ft-on-surface-variant); }

.hidden { display: none; }
.bottom-spacer { height: 20rpx; }

.expense-mask {
  position: fixed;
  inset: 0;
  z-index: 80;
  background: rgba(0, 0, 0, 0.42);
  display: flex;
  align-items: flex-end;
  justify-content: center;
}
.expense-sheet {
  width: 100%;
  padding: 36rpx 40rpx calc(36rpx + env(safe-area-inset-bottom));
  border-radius: 32rpx 32rpx 0 0;
  background: var(--ft-surface-container-lowest);
  box-sizing: border-box;
}
.expense-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}
.expense-kicker {
  font-size: 22rpx;
  font-weight: 800;
  color: rgba(118, 85, 36, 0.55);
  letter-spacing: 1rpx;
}
.expense-title {
  margin-top: 8rpx;
  font-size: 34rpx;
  font-weight: 900;
  color: var(--ft-on-surface);
}
.expense-close {
  width: 56rpx;
  height: 56rpx;
  border-radius: 9999rpx;
  background: rgba(0, 0, 0, 0.06);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  line-height: 1;
  color: rgba(0, 0, 0, 0.45);
}
.expense-input-wrap {
  margin-top: 32rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 24rpx 28rpx;
  border-radius: var(--ft-r-xl);
  background: rgba(255, 152, 0, 0.08);
  border: 1rpx solid rgba(135, 78, 0, 0.12);
}
.expense-yen {
  font-size: 40rpx;
  font-weight: 900;
  color: var(--ft-primary);
}
.expense-input {
  flex: 1;
  font-size: 44rpx;
  font-weight: 900;
  color: var(--ft-on-surface);
  min-height: 56rpx;
}
.expense-hint {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: rgba(0, 0, 0, 0.42);
}
.expense-actions {
  margin-top: 32rpx;
  display: flex;
  gap: 20rpx;
}
.expense-btn {
  flex: 1;
  height: 88rpx;
  border-radius: 9999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 900;
}
.expense-btn.skip {
  background: rgba(0, 0, 0, 0.06);
  color: rgba(0, 0, 0, 0.55);
}
.expense-btn.ok {
  background: linear-gradient(135deg, #874e00 0%, #ff9800 100%);
  color: var(--ft-on-primary);
}

