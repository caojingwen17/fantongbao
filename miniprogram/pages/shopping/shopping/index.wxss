.page{
  padding: 20rpx;
}
.p-card{
  padding: 22rpx;
}
.ft-card-lowest-pad{
  padding: 18rpx;
}
.header{
  margin-bottom: 18rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.header-left{
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.header{
  margin-bottom: 18rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.order-name{
  font-size: 36rpx;
}
.progress{
  font-size: 24rpx;
}
.backBtn{
  height: 64rpx;
  font-size: 22rpx;
  margin-left: auto;
  padding: 0 24rpx;
}
.merged{
  margin-bottom: 10rpx;
}
.group{
  margin-bottom: 20rpx;
}
.group-title{
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 10rpx;
}
.note{
  margin-bottom: 12rpx;
  font-size: 24rpx;
  color: rgba(0,0,0,0.45);
  word-break: break-all;
}
.row{
  display: flex;
  gap: 10rpx;
  align-items: center;
  margin-bottom: 14rpx;
}
.row-text{
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: flex-start;
}
.row-name{
  font-size: 26rpx;
  word-break: break-all;
}
.row-src{
  margin-top: 6rpx;
  font-size: 22rpx;
  word-break: break-all;
}
.delBtn{
  height: 56rpx;
  font-size: 22rpx;
  padding: 0 22rpx;
}
.del{
  font-size: 22rpx;
  color: rgba(0,0,0,0.45);
}
.extra{
  margin-top: 26rpx;
}
.section-title{
  font-size: 28rpx;
  margin-bottom: 12rpx;
}
.input{
  border: 1px solid var(--ft-outline-variant);
  border-radius: var(--ft-r-lg);
  padding: 14rpx 16rpx;
  background: var(--ft-surface-container-lowest);
  margin-bottom: 16rpx;
}
.btn{
  margin-top: 8rpx;
}

