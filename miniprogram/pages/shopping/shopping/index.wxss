.page{
  padding: 20rpx;
}
.header{
  margin-bottom: 18rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.order-name{
  font-size: 36rpx;
  font-weight: 800;
  margin-bottom: 10rpx;
}
.progress{
  font-size: 24rpx;
  color: rgba(0,0,0,0.5);
}
.backBtn{
  height: 50rpx;
  font-size: 22rpx;
  margin-left: auto;
}
.group{
  margin-bottom: 20rpx;
}
.group-title{
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 10rpx;
}
.note{
  margin-bottom: 12rpx;
  font-size: 24rpx;
  color: rgba(0,0,0,0.45);
  word-break: break-all;
}
.row{
  display: flex;
  gap: 10rpx;
  align-items: center;
  padding: 10rpx 0;
}
.row-text{
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1px solid rgba(0,0,0,0.06);
  padding-bottom: 10rpx;
}
.row-name{
  font-size: 26rpx;
  color: rgba(0,0,0,0.65);
  word-break: break-all;
}
.del{
  font-size: 22rpx;
  color: rgba(0,0,0,0.45);
}
.extra{
  margin-top: 26rpx;
  padding-top: 18rpx;
  border-top: 1px solid rgba(0,0,0,0.08);
}
.section-title{
  font-size: 28rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}
.input{
  border: 1px solid rgba(0,0,0,0.12);
  border-radius: 14rpx;
  padding: 14rpx 16rpx;
  background: rgba(0,0,0,0.02);
  margin-bottom: 16rpx;
}
.btn{
  margin-top: 8rpx;
}

