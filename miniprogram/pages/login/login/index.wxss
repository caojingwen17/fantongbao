.login-page {
  min-height: 100vh;
  position: relative;
  overflow: hidden;
  background: linear-gradient(165deg, #fff5ec 0%, #ffe4c4 100%);
}

.blob {
  position: absolute;
  border-radius: 9999rpx;
  pointer-events: none;
  filter: blur(60rpx);
}
.blob-a {
  width: 520rpx;
  height: 520rpx;
  right: -200rpx;
  top: -220rpx;
  background: #f9e534;
  opacity: 0.14;
}
.blob-b {
  width: 520rpx;
  height: 520rpx;
  left: -240rpx;
  bottom: -160rpx;
  background: #91f78e;
  opacity: 0.10;
}

.login-main {
  position: relative;
  z-index: 1;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 48rpx;
  box-sizing: border-box;
}

/* Brand */
.brand {
  text-align: center;
}
.brand-logo {
  width: 160rpx;
  height: 160rpx;
  border-radius: 44rpx;
  margin: 0 auto;
  overflow: hidden;
  box-shadow: 0 20rpx 56rpx rgba(135, 78, 0, 0.2);
}
.brand-logo-img {
  width: 100%;
  height: 100%;
  display: block;
}
.brand-title {
  margin-top: 28rpx;
  font-size: 44rpx;
  font-weight: 900;
  letter-spacing: 6rpx;
  color: var(--ft-on-surface, #432900);
}
.brand-sub {
  margin-top: 12rpx;
  font-size: 24rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  color: var(--ft-on-surface-variant, #765524);
  opacity: 0.85;
}

/* 恢复登录卡 */
.restore-card {
  margin-top: 64rpx;
  padding: 36rpx 40rpx;
  border-radius: 40rpx;
  background: var(--ft-surface-container-lowest, #fff);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  box-shadow: 0 12rpx 40rpx rgba(67, 41, 0, 0.08);
}
.restore-text {
  font-size: 26rpx;
  color: var(--ft-on-surface-variant, #765524);
}

/* 表单卡 */
.form-card {
  margin-top: 56rpx;
  padding: 48rpx 40rpx 36rpx;
  border-radius: 40rpx;
  background: var(--ft-surface-container-lowest, #fff);
  box-shadow: 0 12rpx 40rpx rgba(67, 41, 0, 0.08);
  animation: login-fade-up 0.4s cubic-bezier(0.32, 0.72, 0, 1) both;
}
@keyframes login-fade-up {
  from { opacity: 0; transform: translateY(24rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.login-error {
  padding: 20rpx 24rpx;
  margin-bottom: 28rpx;
  border-radius: 24rpx;
  background: var(--ft-error-bg, rgba(249, 86, 48, 0.12));
  font-size: 24rpx;
  line-height: 1.5;
  color: var(--ft-error, #b02500);
  word-break: break-all;
}

/* 头像选择 */
.avatar-block {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}
.avatar-wrap {
  position: relative;
  width: 160rpx;
  height: 160rpx;
}
.avatar-circle {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}
.avatar-circle.is-empty {
  border: 3rpx dashed var(--ft-outline-variant, rgba(208, 166, 109, 0.45));
  background: var(--ft-surface-container-low, #ffeedc);
}
.avatar-hit {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  padding: 0;
  margin: 0;
  opacity: 0;
}
.avatar-hit::after {
  border: none;
}
.avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  display: block;
}
.avatar-icon {
  opacity: 0.55;
}
.avatar-tip {
  font-size: 22rpx;
  font-weight: 700;
  color: var(--ft-on-surface-variant, #765524);
}

/* 昵称 */
.field {
  margin-top: 40rpx;
}
.field-label {
  font-size: 26rpx;
  font-weight: 900;
  color: var(--ft-on-surface, #432900);
  margin-bottom: 14rpx;
}
.field-input {
  width: 100%;
  height: 96rpx;
  padding: 0 28rpx;
  box-sizing: border-box;
  background: var(--ft-surface-container-low, #ffeedc);
  border: none;
  border-radius: 32rpx;
  color: var(--ft-on-surface, #432900);
  font-size: 30rpx;
}

/* 提交 */
.submit-btn {
  margin-top: 40rpx;
}
.submit-btn[disabled] {
  opacity: 0.8;
}
.form-tip {
  margin-top: 24rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--ft-on-surface-variant, #765524);
  opacity: 0.75;
}
