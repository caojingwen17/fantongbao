.page {
  padding: 40rpx 30rpx;
}
.title {
  font-size: 44rpx;
  font-weight: 700;
  margin-bottom: 20rpx;
}
.desc {
  font-size: 28rpx;
  color: rgba(0, 0, 0, 0.5);
  margin-bottom: 36rpx;
}
.checking {
  margin-top: 40rpx;
  font-size: 28rpx;
  color: rgba(0, 0, 0, 0.45);
}
.form {
  margin-top: 20rpx;
}
.avatar-btn {
  width: 200rpx;
  height: 200rpx;
  padding: 0;
  margin: 0 auto 32rpx;
  border-radius: 50%;
  overflow: hidden;
  background: rgba(0, 0, 0, 0.06);
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}
.avatar-btn::after {
  border: none;
}
.avatar-img {
  width: 200rpx;
  height: 200rpx;
}
.avatar-placeholder {
  font-size: 26rpx;
  color: rgba(0, 0, 0, 0.45);
  padding: 0 16rpx;
  text-align: center;
}
.nick-wrap {
  margin-bottom: 36rpx;
}
.nick-label {
  font-size: 26rpx;
  color: rgba(0, 0, 0, 0.55);
  margin-bottom: 12rpx;
}
.nick-input {
  border: 1px solid rgba(0, 0, 0, 0.12);
  border-radius: 14rpx;
  padding: 22rpx 20rpx;
  font-size: 30rpx;
  background: rgba(0, 0, 0, 0.02);
}
.login-btn {
  margin-top: 12rpx;
}
.tip {
  margin-top: 28rpx;
  font-size: 24rpx;
  color: rgba(0, 0, 0, 0.38);
  line-height: 1.5;
}
