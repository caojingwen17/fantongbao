/* Apricot Breeze - Home (v2) 1:1-ish */

.home-page {
  min-height: 100vh;
  position: relative;
  overflow: hidden;
  /* 你反馈“整体字体偏小”：先把页面基准字号抬一档，再按模块微调 */
  font-size: 30rpx;
  background: var(--ft-surface);
}

.blob {
  position: absolute;
  border-radius: 9999rpx;
  pointer-events: none;
  filter: blur(60rpx);
}
.blob-a {
  width: 520rpx;
  height: 520rpx;
  right: -200rpx;
  top: -220rpx;
  background: var(--ft-secondary-fixed, #f9e534);
  opacity: 0.14;
}
.blob-b {
  width: 520rpx;
  height: 520rpx;
  left: -240rpx;
  top: 520rpx;
  background: var(--ft-tertiary-fixed, #91f78e);
  opacity: 0.10;
}

.topbar {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  z-index: 50;
  /* 统一头部高度规范 */
  padding: 52rpx 40rpx 30rpx;
  padding-top: calc(52rpx + constant(safe-area-inset-top));
  padding-top: calc(52rpx + env(safe-area-inset-top));
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: rgba(255, 247, 237, 0.82);
  backdrop-filter: blur(12rpx);
}
.brand {
  font-size: 40rpx;
  font-weight: 900;
  font-style: italic;
  letter-spacing: -1rpx;
  color: #c2410c;
  line-height: 1.05;
  /* 头部高度不变，仅文字下移 */
  transform: translateY(40rpx);
}
.topbar-spacer {
  width: 80rpx;
  height: 80rpx;
}
.topbar-ico {
  font-size: 34rpx;
  opacity: 0.9;
}

.main {
  position: relative;
  z-index: 1;
  /* scroll-view 需要固定高度以接管滚动 */
  height: 100vh;
  min-height: 100vh;
  box-sizing: border-box;
  padding-top: calc(196rpx + constant(safe-area-inset-top));
  padding-top: calc(196rpx + env(safe-area-inset-top));
  /* padding 放到 inner，避免滚动条“往中间偏” */
  padding-bottom: 0;
}

.main-inner {
  box-sizing: border-box;
  padding: 0 40rpx 64rpx;
  padding-bottom: calc(64rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(64rpx + env(safe-area-inset-bottom));
  min-height: 100%;
}

.card {
  /* Tailwind in prototype: rounded-lg = 2rem */
  border-radius: 64rpx;
}

.family-card {
  padding: 40rpx;
  background: var(--ft-surface-container-lowest);
}
.family-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
}
.family-left {
  flex: 1 1 auto;
  min-width: 0;
}
.kicker {
  /* 原型 text-xs + font-black + tracking-widest：但视觉上不会这么小 */
  font-size: 24rpx;
  font-weight: 900;
  text-transform: uppercase;
  letter-spacing: 3rpx;
  color: var(--ft-on-surface-variant);
}
.family-name-btn {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 18rpx; /* 整体下移一些 */
  padding: 0;
  background: transparent;
}
.family-name-btn:active { transform: none; }
.family-name {
  font-size: 48rpx;
  font-weight: 900;
  color: var(--ft-on-surface);
  max-width: 520rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  line-height: 1.1;
  transform: none;
  margin-top: 0;
  display: block;
}

/* Family expand_more icon (drawn in WXSS, no icon font) */
.family-expand {
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  top: 6rpx; /* 箭头下移，和家庭名中心线对齐 */
  margin-top: 0;
  transform: none;
  transition: transform 180ms ease;
}
.family-expand-up {
  transform: rotate(180deg);
}
.family-expand-l,
.family-expand-r {
  position: absolute;
  width: 18rpx;
  height: 4rpx;
  background: rgba(149, 112, 60, 0.75);
  border-radius: 9999rpx;
}
.family-expand-l {
  transform: translateX(-6rpx) rotate(45deg);
}
.family-expand-r {
  transform: translateX(6rpx) rotate(-45deg);
}
.meta-row {
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
  flex-wrap: wrap;
  font-size: 24rpx;
  font-weight: 700;
  color: var(--ft-on-surface-variant);
}
.meta-ico {
  margin-right: 6rpx;
}
.dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 9999rpx;
  background: var(--ft-outline-variant);
}
.family-settings {
  width: 80rpx;
  height: 80rpx;
  border-radius: 9999rpx;
  background: var(--ft-surface-container);
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 80rpx;
}
.family-settings:active {
  transform: scale(0.9);
}

.avatar-stack {
  margin-top: 26rpx;
  display: flex;
  align-items: center;
}
.member-avatar,
.avatar-fallback {
  width: 80rpx;
  height: 80rpx;
  border-radius: 9999rpx;
  border: 8rpx solid var(--ft-surface-container-lowest); /* ring-4 */
  box-sizing: border-box;
}
.avatar-fallback {
  background: var(--ft-surface-container-high);
}
.avatar-a {
  margin-left: 0;
}
.avatar-b {
  margin-left: -24rpx; /* -space-x-3 */
}
.avatar-more {
  width: 80rpx;
  height: 80rpx;
  border-radius: 9999rpx;
  margin-left: -24rpx;
  background: var(--ft-surface-container-high);
  border: 8rpx solid var(--ft-surface-container-lowest);
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 900;
  color: var(--ft-on-surface-variant);
}

.section {
  margin-top: 48rpx;
}
.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 8rpx;
  margin-bottom: 20rpx;
}
.section-head-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.section-title {
  font-size: 34rpx;
  font-weight: 900;
  letter-spacing: -0.5rpx;
}
.section-add-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 9999rpx;
  background: var(--ft-primary);
  color: var(--ft-on-primary);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  font-weight: 900;
  line-height: 1;
}
.section-add-btn:active {
  opacity: 0.88;
  transform: scale(0.96);
}
.count-pill {
  font-size: 24rpx;
  font-weight: 900;
  color: var(--ft-primary);
  background: var(--ft-surface-container-high);
  padding: 10rpx 20rpx;
  border-radius: 9999rpx;
}

.create-order-mask {
  position: fixed;
  inset: 0;
  z-index: 200;
  background: rgba(0, 0, 0, 0.35);
}
.create-order-modal {
  position: fixed;
  left: 50%;
  top: 42%;
  transform: translate(-50%, -50%);
  z-index: 210;
  width: 620rpx;
  max-width: 90vw;
  background: rgba(255, 255, 255, 0.96);
  backdrop-filter: blur(12rpx);
  border-radius: 28rpx;
  padding: 32rpx 28rpx 28rpx;
  box-shadow: 0 16rpx 40rpx rgba(67, 41, 0, 0.14);
}
.create-order-kicker {
  font-size: 22rpx;
  font-weight: 900;
  letter-spacing: 2rpx;
  color: var(--ft-on-surface-variant);
}
.create-order-label {
  margin-top: 16rpx;
  font-size: 26rpx;
  font-weight: 800;
  color: var(--ft-on-surface);
}
.create-order-input {
  margin-top: 12rpx;
  height: 88rpx;
  padding: 0 22rpx;
  border-radius: 20rpx;
  background: var(--ft-surface-container-lowest);
  font-size: 28rpx;
  font-weight: 700;
}
.create-order-actions {
  margin-top: 28rpx;
  display: flex;
  gap: 16rpx;
}
.create-order-btn {
  flex: 1;
  height: 88rpx;
  border-radius: 9999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 900;
}
.create-order-btn.cancel {
  background: var(--ft-surface-container);
  color: var(--ft-on-surface-variant);
}
.create-order-btn.ok {
  background: var(--ft-primary);
  color: var(--ft-on-primary);
}

.order-grid {
  display: grid;
  gap: 18rpx;
}
.order-card {
  padding: 28rpx;
  border-radius: 64rpx;
  background: var(--ft-surface-container-lowest);
}
.order-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}
.order-left {
  flex: 1 1 auto;
  min-width: 0;
}
.order-badges {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.chip {
  padding: 8rpx 18rpx;
  border-radius: 9999rpx;
  font-size: 20rpx;
  font-weight: 900;
  letter-spacing: 1.6rpx;
}
.chip-warn {
  /* 原型：bg-secondary-container / text-on-secondary-container */
  background: #f9e534;
  color: #5b5300;
}
.chip-ok {
  /* 原型：bg-tertiary-container / text-on-tertiary-container */
  background: #91f78e;
  color: #005e17;
}
/* 仅「待点菜」（0 道菜） */
.chip-muted {
  background: #e8e6e3;
  color: #5f5f5f;
}
.order-sub {
  /* 原型 text-sm + font-semibold：比现在更醒目 */
  font-size: 26rpx;
  font-weight: 700;
  color: var(--ft-on-surface-variant);
}
.order-name {
  margin-top: 16rpx;
  font-size: 30rpx;
  font-weight: 900;
  color: var(--ft-on-surface);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.order-hint {
  margin-top: 8rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: var(--ft-on-surface-variant);
}
.chev {
  margin-top: 8rpx;
  font-size: 38rpx;
  color: rgba(149, 112, 60, 0.6);
}

.recipe-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
}
.recipe-tile {
  border-radius: 64rpx;
  overflow: hidden;
  background: var(--ft-surface-container-lowest);
}
.recipe-media {
  position: relative;
  width: 100%;
  height: 0;
  padding-bottom: 75%; /* 4/3 */
  background: var(--ft-surface-container);
  overflow: hidden;
}
.recipe-img {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}
.recipe-grad {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: linear-gradient(to top, rgba(0, 0, 0, 0.45), rgba(0, 0, 0, 0.10), rgba(0, 0, 0, 0));
}
.recipe-meta {
  position: absolute;
  left: 18rpx;
  right: 18rpx;
  bottom: 18rpx;
}
.recipe-tag {
  font-size: 18rpx;
  font-weight: 900;
  letter-spacing: 1.6rpx;
  color: rgba(255, 255, 255, 0.82);
}
.recipe-title {
  margin-top: 6rpx;
  font-size: 28rpx;
  font-weight: 900;
  color: #fff;
  line-height: 1.15;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.cta-row {
  margin-top: 22rpx;
  display: flex;
  gap: 18rpx;
  padding-top: 6rpx; /* 对齐原型的 pt-1 */
}
.cta {
  flex: 1 1 0;
  width: 0;
  height: 104rpx;
  padding: 0;
  border-radius: 9999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 900;
  font-size: 30rpx;
  gap: 12rpx;
  box-sizing: border-box;
}
.cta::after { border: none; }
.cta:active {
  transform: scale(0.95);
}
.cta.secondary {
  background: #f9e534;
  color: #5b5300;
}
.cta.primary {
  /* 原型 bubbly-gradient + 指定阴影 */
  background: linear-gradient(135deg, var(--ft-primary) 0%, #ff9800 100%);
  color: var(--ft-on-primary);
  box-shadow: 0 24rpx 48rpx rgba(135, 78, 0, 0.18);
}

/* CTA icons (no icon font available, draw in WXSS) */
.ico-apps {
  width: 40rpx;
  height: 40rpx;
  display: grid;
  grid-template-columns: 1fr 1fr;
  grid-template-rows: 1fr 1fr;
  gap: 6rpx;
}
.ico-apps-dot {
  width: 100%;
  height: 100%;
  border-radius: 10rpx;
  background: currentColor;
  opacity: 0.9;
}
.ico-add-circle {
  width: 44rpx;
  height: 44rpx;
  border-radius: 9999rpx;
  border: 4rpx solid currentColor;
  position: relative;
  box-sizing: border-box;
  opacity: 0.92;
}
.ico-add-plus-h,
.ico-add-plus-v {
  position: absolute;
  left: 50%;
  top: 50%;
  background: currentColor;
  border-radius: 9999rpx;
  transform: translate(-50%, -50%);
}
.ico-add-plus-h {
  width: 22rpx;
  height: 4rpx;
}
.ico-add-plus-v {
  width: 4rpx;
  height: 22rpx;
}

.empty {
  padding: 44rpx 0;
  text-align: center;
  color: rgba(118, 85, 36, 0.75);
  font-weight: 700;
}

/* bottom sheet */
.sheet-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 60;
  background: rgba(0, 0, 0, 0.30);
  backdrop-filter: blur(2rpx);
}
.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 70;
  background: rgba(255, 255, 255, 0.90); /* bg-white/90 */
  backdrop-filter: blur(24rpx); /* backdrop-blur-xl */
  border-top-left-radius: 64rpx; /* rounded-t-[2rem] */
  border-top-right-radius: 64rpx;
  padding: 40rpx 40rpx 64rpx; /* p-5 pb-8 */
  box-shadow: 0 -24rpx 48rpx rgba(67, 41, 0, 0.10); /* shadow-[0_-12px_24px...] */
}
.sheet-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}
.sheet-head-left {
  flex: 1 1 auto;
  min-width: 0;
}
.sheet-kicker {
  font-size: 20rpx;
  font-weight: 900;
  letter-spacing: 2rpx;
  text-transform: uppercase;
  color: var(--ft-on-surface-variant);
}
.sheet-close {
  width: 80rpx;
  height: 80rpx;
  border-radius: 9999rpx;
  background: var(--ft-surface-container);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--ft-on-surface-variant);
  flex: 0 0 80rpx;
  padding: 0;
}
.sheet-close:active {
  transform: scale(0.90);
}
.sheet-close-x {
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1;
}
.sheet-code {
  /* 原型：mt-1 + inline-flex items-center gap-2 */
  margin-top: 8rpx;
  display: inline-flex;
  align-items: center;
  gap: 16rpx;
  flex-wrap: wrap;
}
.sheet-code-text {
  font-size: 40rpx;
  font-weight: 900;
  color: var(--ft-on-surface);
  line-height: 1.05;
}
.sheet-copy {
  /* 原型：px-3 py-1.5 rounded-full bg-surface-container text-primary font-bold */
  padding: 10rpx 18rpx;
  min-height: 52rpx;
  min-width: 96rpx;
  border-radius: 9999rpx;
  background: var(--ft-surface-container);
  color: var(--ft-primary);
  font-weight: 900;
  font-size: 28rpx;
  line-height: 1;
  align-self: center;
  /* 关键：不要在 flex 中被拉伸成长条 */
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  width: auto;
  max-width: none;
  box-sizing: border-box;
}
.sheet-copy:active {
  transform: scale(0.95);
  opacity: 0.95;
}
.sheet-title {
  margin-top: 28rpx;
  padding: 0 8rpx;
  font-size: 26rpx;
  font-weight: 900;
  color: var(--ft-on-surface);
}
.sheet-list {
  margin-top: 18rpx;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}
.sheet-item {
  /* 原型：rounded-lg + p-4 + bg-surface-container-lowest */
  padding: 32rpx;
  border-radius: 64rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  background: var(--ft-surface-container-lowest);
  transition: transform 160ms ease, background 160ms ease;
}
.sheet-item:active {
  transform: scale(0.99);
}
.sheet-item-active {
  /* 原型当前项不“染色”，保持同背景 */
  background: var(--ft-surface-container-lowest);
}
.sheet-item-left {
  flex: 1 1 auto;
  min-width: 0;
}
.sheet-item-name {
  font-size: 30rpx;
  font-weight: 900;
  color: var(--ft-on-surface);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.sheet-item-sub {
  margin-top: 8rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: var(--ft-on-surface-variant);
}
.sheet-item-right {
  font-size: 34rpx;
  font-weight: 900;
  color: var(--ft-primary);
}
.sheet-manage {
  margin-top: 30rpx;
  height: 104rpx;
  border-radius: 9999rpx;
  background: #f9e534;
  color: #5b5300;
  font-weight: 900;
  font-size: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}
.sheet-manage:active {
  transform: scale(0.95);
}
.sheet-manage-ico {
  font-size: 34rpx;
  transform: translateY(-1rpx);
  opacity: 0.9;
}
