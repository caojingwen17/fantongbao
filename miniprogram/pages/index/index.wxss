/**index.wxss**/

page {
  padding-top: 54rpx;
  padding-bottom: 60rpx;
}

.container {
  font-family: PingFang SC;
}

.title {
  font-family: PingFang SC;
  font-weight: 500;
  color: #000000;
  font-size: 44rpx;
  margin-bottom: 40rpx;
}
.function_title {
  font-family: PingFang SC;
  font-weight: 500;
  color: #000000;
  font-size: 36rpx;
  text-align: left;
  width: 93%;
  margin-top: 50rpx;
}

.top_tip {
  font-size: 28rpx;
  font-family: PingFang SC;
  font-weight: 400;
  color: #888888;
  margin-bottom: 28rpx;
}

.examples_container {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  width: 100%;
  align-items: center;
}

.example_item {
  border: 3rpx solid #e5e5e5;
  border-radius: 10rpx;
  padding: 24rpx;
  width: 90%;
  background-color: #fff;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.power {
  margin-top: 30rpx;
  border-radius: 5px;
  background-color: white;
  width: 93%;
  padding-bottom: 1rpx;
}

.power_info {
  display: flex;
  padding: 30rpx 25rpx;
  align-items: center;
  justify-content: space-between;
}

.power_info_more {
  width: 30rpx;
  height: 30rpx;
  transform: rotate(90deg);
}

.power_info_less {
  width: 30rpx;
  height: 30rpx;
  transform: rotate(270deg);
}

.power_info_text {
  display: flex;
  flex-direction: column;
}

.power_info_text_title {
  margin-bottom: 10rpx;
  font-weight: 400;
  font-size: 32rpx;
  display: flex;
  align-items: center;
  font-family: 'PingFang SC';
  color: #000;
}

.power_info_text_tag {
  margin-left: 20rpx;
  background-color: #fbe0e0;
  color: #e54545;
  padding: 0 7px;
  font-size: 14px;
  vertical-align: middle;
  border-radius: 3px;
}

.power_info_text_tip {
  color: rgba(0, 0, 0, 0.6);
  font-size: 28rpx;
  padding-right: 30rpx;
}

.power_item {
  padding: 30rpx 25rpx;
  display: flex;
  justify-content: space-between;
}

.power_item_title {
  font-size: 28rpx;
  color: rgba(0, 0, 0, 0.9);
}

.power_item_icon {
  width: 30rpx;
  height: 30rpx;
}

.line {
  width: 95%;
  margin: 0 auto;
  height: 2rpx;
  background-color: rgba(0, 0, 0, 0.1);
}

.environment {
  color: rgba(0, 0, 0, 0.4);
  font-size: 24rpx;
  margin-top: 25%;
}

/* 家庭厨助手首页样式 */
.page{
  padding: 20rpx;
  padding-bottom: 60rpx;
}
.p-card{
  padding: 22rpx;
}
.header{
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}
.familyBlock{
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.familyNameRow{
  display: flex;
  align-items: baseline;
  gap: 10rpx;
}
.familyName{
  font-size: 36rpx;
}
.familyCaret{
  font-size: 28rpx;
  color: var(--ft-on-surface-variant);
  transform: translateY(-2rpx);
  transition: transform 180ms ease;
}
.caretUp{
  transform: translateY(-2rpx) rotate(180deg);
}
.familyMetaRow{
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex-wrap: wrap;
}
.familyMeta{
  font-size: 24rpx;
}
.home-refresh-hint{
  font-size: 22rpx;
  color: var(--ft-primary-container);
}
.picker-mask{
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 950;
  background: rgba(67, 41, 0, 0.22);
  padding: 180rpx 30rpx 30rpx;
  box-sizing: border-box;
}
.picker-panel{
  width: 100%;
  border-radius: var(--ft-r-xl);
  padding: 18rpx;
  box-sizing: border-box;
}
.picker-id{
  font-size: 28rpx;
  padding: 6rpx 10rpx 16rpx;
}
.picker-list{
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-bottom: 18rpx;
}
.picker-item{
  background: var(--ft-surface-container-low);
  border-radius: var(--ft-r-xl);
  padding: 18rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.picker-item-active{
  background: rgba(255, 152, 0, 0.18);
}
.picker-item-name{
  font-size: 32rpx;
}
.picker-item-sub{
  font-size: 24rpx;
}
.picker-manage{
  height: 84rpx;
}
.section{
  margin-bottom: 28rpx;
}
.sectionTitle{
  font-size: 30rpx;
  font-weight: 800;
  margin-bottom: 14rpx;
}
.orderList{
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.mergedOrderCard{
  padding: 18rpx;
  display: flex;
  flex-direction: column;
  gap: 0;
}
.pending-item{
  padding: 16rpx 0;
}
.pending-item + .pending-item{
  border-top: 0;
  margin-top: 10rpx;
  padding-top: 18rpx;
  background: var(--ft-surface-container-lowest);
  border-radius: var(--ft-r-lg);
  padding-left: 18rpx;
  padding-right: 18rpx;
}
.orderCard{
  padding: 18rpx;
  border-radius: 18rpx;
  background: rgba(0,0,0,0.03);
}
.orderStatus{
  font-size: 24rpx;
  color: rgba(0,0,0,0.45);
  margin-bottom: 10rpx;
}
.orderName{
  font-size: 32rpx;
  font-weight: 700;
}
.orderEmpty{
  padding: 20rpx 0;
  text-align: center;
  color: rgba(0,0,0,0.35);
}
.recipes{
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}
.recipeCard{
  display: flex;
  gap: 16rpx;
  align-items: center;
  padding: 16rpx;
}
.recipeImg{
  width: 120rpx;
  height: 90rpx;
  border-radius: 12rpx;
  background: var(--ft-surface-container-high);
}
.recipeName{
  font-size: 30rpx;
  flex: 1;
}
.empty{
  padding: 40rpx 0;
  text-align: center;
  color: rgba(0,0,0,0.35);
}
.actions{
  margin-top: 18rpx;
  display: flex;
  gap: 14rpx;
}
.btn{
  flex: 1;
}
