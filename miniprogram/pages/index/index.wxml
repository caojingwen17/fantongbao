<!--index.wxml-->
<view class="page">
  <view class="header">
    <view class="familyBlock">
      <view class="familyName">{{currentFamily.familyName || "未选择家庭"}}</view>
      <view class="familyMetaRow">
        <view class="familyMeta">
          成员 {{membersCount}} 人
        </view>
        <view class="home-refresh-hint" wx:if="{{homeRefreshing}}">更新中…</view>
      </view>
    </view>
    <button class="manageBtn" bindtap="goFamily">家庭管理</button>
  </view>

  <view class="section">
    <view class="sectionTitle">待处理点菜单</view>
    <view class="mergedOrderCard" wx:if="{{pendingOrders && pendingOrders.length}}">
      <block wx:for="{{pendingOrders}}" wx:key="_id">
        <view class="pending-item" bindtap="goPendingOrder" data-orderid="{{item._id}}">
          <view class="orderStatus">{{item.statusText}}</view>
          <view class="orderName">{{item.orderName}}</view>
        </view>
      </block>
    </view>
    <view class="orderEmpty" wx:if="{{!pendingOrders || pendingOrders.length===0}}">暂无待处理点菜单</view>
  </view>

  <view class="section">
    <view class="sectionTitle">常用菜谱</view>
    <view class="recipes">
      <block wx:for="{{recipes}}" wx:key="id">
        <view class="recipeCard" bindtap="goRecipeDetail" data-recipeid="{{item.id}}">
          <image class="recipeImg" mode="aspectFill" src="{{item.recipeImgDisplay || item.recipeImg}}" />
          <view class="recipeName">{{item.recipeName}}</view>
        </view>
      </block>
      <view class="empty" wx:if="{{!recipes || recipes.length===0}}">暂无菜谱</view>
    </view>

    <view class="actions">
      <button class="btn" bindtap="goRecipeList">查看全部</button>
      <button class="btn primary" bindtap="goRecipeAdd">添加菜谱</button>
    </view>
  </view>
</view>