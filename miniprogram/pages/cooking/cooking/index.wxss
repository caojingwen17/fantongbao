.cooking-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  position: relative;
  overflow: hidden;
}

.blob {
  position: absolute;
  border-radius: 9999rpx;
  pointer-events: none;
  filter: blur(60rpx);
}
.blob-a {
  width: 520rpx;
  height: 520rpx;
  left: -200rpx;
  top: 220rpx;
  background: #f9e534;
  opacity: 0.14;
}
.blob-b {
  width: 520rpx;
  height: 520rpx;
  left: -200rpx;
  top: 420rpx;
  background: #91f78e;
  opacity: 0.12;
}

.main {
  position: relative;
  z-index: 1;
  flex: 1;
  min-height: 0;
}
.main-inner {
  padding: 20rpx 40rpx calc(180rpx + env(safe-area-inset-bottom));
}

.header-card {
  background: var(--ft-surface-container-lowest);
  border-radius: 64rpx;
  padding: 40rpx;
  margin-bottom: 20rpx;
}
.header-row { display: flex; align-items: flex-start; justify-content: space-between; gap: 16rpx; }
.head-kicker {
  font-size: 18rpx;
  font-weight: 900;
  letter-spacing: 2rpx;
  color: var(--ft-on-surface-variant);
}
.head-name { margin-top: 8rpx; font-size: 48rpx; font-weight: 900; letter-spacing: -0.6rpx; }
.head-progress { margin-top: 8rpx; font-size: 24rpx; color: var(--ft-on-surface-variant); font-weight: 700; }
.head-progress-v { color: var(--ft-primary); font-weight: 900; }
.head-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 9999rpx;
  background: #91f78e;
  color: #005e17;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
}
.head-tip { margin-top: 12rpx; font-size: 20rpx; font-weight: 700; color: var(--ft-on-surface-variant); }

.group-list { display: flex; flex-direction: column; gap: 14rpx; }
.group-card {
  background: var(--ft-surface-container-lowest);
  border-radius: 64rpx;
  overflow: hidden;
}
.group-toggle {
  padding: 32rpx 40rpx;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 14rpx;
}
.group-main { flex: 1; min-width: 0; }
.group-name { font-size: 36rpx; font-weight: 900; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.group-note { margin-top: 8rpx; font-size: 20rpx; color: var(--ft-on-surface-variant); font-weight: 700; }
.group-right { display: flex; align-items: center; gap: 8rpx; margin-top: 2rpx; }
.group-count {
  font-size: 20rpx;
  font-weight: 900;
  color: var(--ft-primary);
  padding: 8rpx 18rpx;
  border-radius: 9999rpx;
  background: var(--ft-surface-container-high);
}
.group-chev { display: flex; align-items: center; justify-content: center; color: var(--ft-outline); }
.group-body { padding: 0 40rpx 32rpx; display: flex; flex-direction: column; gap: 14rpx; }
.phase { display: flex; flex-direction: column; gap: 8rpx; }
.phase-title { font-size: 28rpx; font-weight: 900; color: var(--ft-on-surface); }
.step-item {
  background: var(--ft-surface-container);
  border-radius: 64rpx;
  padding: 24rpx 32rpx;
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
}
.step-cb {
  width: 40rpx;
  height: 40rpx;
  border-radius: 9999rpx;
  border: 3rpx solid rgba(208, 166, 109, 0.45);
  background: #ffffff;
  box-sizing: border-box;
  margin-top: 2rpx;
}
.step-done {
  background: var(--ft-primary);
  border-color: var(--ft-primary);
  animation: ft-pop var(--ft-dur-fast, 0.18s) var(--ft-ease-spring, cubic-bezier(0.34, 1.4, 0.64, 1)) both;
}
.step-done::after {
  content: "✓";
  display: block;
  color: #fff;
  font-weight: 900;
  font-size: 24rpx;
  line-height: 34rpx;
  text-align: center;
}
.step-text { font-size: 30rpx; font-weight: 700; color: var(--ft-on-surface); line-height: 1.45; flex: 1; }

