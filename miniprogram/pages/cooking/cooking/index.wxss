.page{
  padding: 20rpx;
}
.p-card{
  padding: 22rpx;
}
.header-left{
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.header{
  margin-bottom: 18rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.order-name{
  font-size: 36rpx;
}
.progress{
  font-size: 24rpx;
}
.backBtn{
  height: 64rpx;
  font-size: 22rpx;
  margin-left: auto;
  padding: 0 24rpx;
}
.group{
  margin-bottom: 22rpx;
}
.group-header{
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.group-title{
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 10rpx;
}
.toggle-text{
  font-size: 22rpx;
  color: rgba(0,0,0,0.45);
}
.note{
  margin-bottom: 12rpx;
  font-size: 24rpx;
  color: rgba(0,0,0,0.45);
  word-break: break-all;
}
.phase-title{
  margin-top: 14rpx;
  margin-bottom: 8rpx;
  font-size: 26rpx;
  color: rgba(0,0,0,0.45);
  font-weight: 600;
}
.row{
  display: flex;
  gap: 10rpx;
  align-items: center;
  padding: 10rpx 0;
}
.row-text{
  flex: 1;
  background: var(--ft-surface-container-lowest);
  border-radius: var(--ft-r-lg);
  padding: 14rpx 16rpx;
}
.step-text{
  font-size: 26rpx;
  word-break: break-all;
}

