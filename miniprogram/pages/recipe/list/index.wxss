.recipe-list-page { min-height: 100vh; position: relative; overflow: hidden; }
.blob { position: absolute; border-radius: 9999rpx; pointer-events: none; filter: blur(60rpx); }
.blob-a { width: 520rpx; height: 520rpx; right: -200rpx; top: -220rpx; background: var(--ft-secondary-fixed,#f9e534); opacity: 0.18; }
.blob-b { width: 520rpx; height: 520rpx; left: -240rpx; top: 320rpx; background: var(--ft-tertiary-fixed,#91f78e); opacity: 0.12; }

.topbar {
  position: fixed; left: 0; right: 0; top: 0; z-index: 50;
  padding: 70rpx 40rpx 0rpx;
  padding-top: calc(80rpx + constant(safe-area-inset-top));
  padding-top: calc(80rpx + env(safe-area-inset-top));
  display: flex; align-items: center; justify-content: space-between;
  background: rgba(255, 247, 237, 0.82);
  backdrop-filter: blur(12rpx);
}
.top-left { display: flex; align-items: center; gap: 18rpx; min-width: 0; }
.icon-btn { width: 80rpx; height: 80rpx; border-radius: 9999rpx; background: var(--ft-surface-container-lowest); display: flex; align-items: center; justify-content: center; color: var(--ft-on-surface-variant); }
.ico { font-size: 42rpx; font-weight: 900; line-height: 1; transform: translateY(-2rpx); }
.top-title { font-size: 34rpx; font-weight: 900; letter-spacing: -0.5rpx; white-space: nowrap; }
.top-spacer { width: 80rpx; height: 80rpx; }

.main {
  position: relative; z-index: 1; height: 100vh;
  padding-top: calc(246rpx + constant(safe-area-inset-top));
  padding-top: calc(246rpx + env(safe-area-inset-top));
}
.main-inner { padding: 0 40rpx calc(52rpx + env(safe-area-inset-bottom)); }

.search-wrap { position: relative; height: 112rpx; border-radius: 24rpx; background: var(--ft-surface-container-lowest); }
.search-icon { position: absolute; left: 24rpx; top: 50%; transform: translateY(-50%); font-size: 32rpx; color: var(--ft-outline); }
.search-input { height: 112rpx; padding-left: 72rpx; padding-right: 76rpx; font-size: 28rpx; }
.clear-btn {
  position: absolute; right: 16rpx; top: 50%; transform: translateY(-50%);
  width: 56rpx; height: 56rpx; border-radius: 9999rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 30rpx; color: var(--ft-on-surface-variant);
  background: var(--ft-surface-container);
}

.add-btn {
  margin-top: 20rpx;
  height: 96rpx;
  border-radius: 9999rpx;
  background: linear-gradient(135deg, #874e00 0%, #ff9800 100%);
  color: var(--ft-on-primary);
  display: flex; align-items: center; justify-content: center;
  font-size: 30rpx; font-weight: 900;
  box-shadow: 0 12rpx 24rpx rgba(135,78,0,0.16);
}

.count-row { margin-top: 24rpx; padding: 0 4rpx; display: flex; justify-content: space-between; align-items: center; }
.count-text { font-size: 24rpx; font-weight: 900; color: var(--ft-on-surface); }
.hint-text { font-size: 20rpx; font-weight: 700; color: var(--ft-on-surface-variant); }

.recipe-list { margin-top: 18rpx; display: flex; flex-direction: column; gap: 12rpx; }
.recipe-item { background: var(--ft-surface-container-lowest); border-radius: 24rpx; padding: 16rpx; }
.recipe-row { display: flex; gap: 16rpx; }
.recipe-media { width: 160rpx; height: 160rpx; border-radius: 16rpx; overflow: hidden; background: var(--ft-surface-container); flex: 0 0 160rpx; }
.recipe-img { width: 100%; height: 100%; }
.recipe-img-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #d9d9d9;
  color: #666;
  font-size: 22rpx;
  font-weight: 800;
}
.recipe-body { min-width: 0; flex: 1; display: flex; flex-direction: column; justify-content: space-between; padding: 4rpx 0; }
.recipe-name { font-size: 34rpx; font-weight: 900; line-height: 1.28; }
.recipe-date { margin-top: 6rpx; font-size: 20rpx; font-weight: 700; color: var(--ft-on-surface-variant); }
.recipe-foot { margin-top: 12rpx; display: flex; align-items: center; justify-content: space-between; }
.recipe-foot-right { display: flex; align-items: center; gap: 12rpx; }
.recipe-row-del {
  font-size: 22rpx;
  font-weight: 900;
  color: var(--ft-error, #c62828);
  padding: 8rpx 14rpx;
  border-radius: 9999rpx;
  background: rgba(198, 40, 40, 0.08);
}
.recipe-tag { font-size: 20rpx; font-weight: 800; color: var(--ft-secondary); }
.recipe-arrow { font-size: 34rpx; color: var(--ft-outline); }

.list-hint-delete {
  margin-top: 8rpx;
  padding: 0 4rpx;
  font-size: 20rpx;
  font-weight: 700;
  color: var(--ft-on-surface-variant);
}

.empty-card { margin-top: 20rpx; background: var(--ft-surface-container-lowest); border-radius: 24rpx; padding: 64rpx 30rpx; text-align: center; }
.empty-ico {
  margin: 0 auto; width: 112rpx; height: 112rpx; border-radius: 9999rpx;
  display: flex; align-items: center; justify-content: center;
  background: var(--ft-surface-container);
  font-size: 42rpx; color: var(--ft-outline);
}
.empty-title { margin-top: 20rpx; font-size: 32rpx; font-weight: 900; }
.empty-sub { margin-top: 8rpx; font-size: 24rpx; font-weight: 700; color: var(--ft-on-surface-variant); }

.loading-mask {
  position: fixed; inset: 0; z-index: 60;
  background: rgba(255, 255, 255, 0.60);
  backdrop-filter: blur(4rpx);
  display: flex; align-items: flex-start; justify-content: center;
  padding-top: 280rpx;
}
.loading-card {
  width: 670rpx; max-width: 90vw;
  background: rgba(255,255,255,0.92);
  border-radius: 24rpx;
  padding: 24rpx;
  box-shadow: 0 12rpx 24rpx rgba(67,41,0,0.10);
}
.loading-title { font-size: 24rpx; font-weight: 900; color: var(--ft-on-surface); margin-bottom: 14rpx; }
.skeleton {
  height: 160rpx;
  border-radius: 16rpx;
  background: linear-gradient(90deg, rgba(255, 228, 196, 0.55) 25%, rgba(255, 214, 162, 0.7) 37%, rgba(255, 228, 196, 0.55) 63%);
  background-size: 800rpx 160rpx;
  animation: shimmer 1.2s infinite linear;
  margin-top: 10rpx;
}
@keyframes shimmer {
  0% { background-position: -468rpx 0; }
  100% { background-position: 468rpx 0; }
}

.sheet-overlay { position: fixed; inset: 0; z-index: 70; background: rgba(0,0,0,0.30); }
.action-sheet {
  position: fixed; left: 0; right: 0; bottom: 0; z-index: 80;
  background: rgba(255,255,255,0.92);
  backdrop-filter: blur(12rpx);
  border-top-left-radius: 32rpx;
  border-top-right-radius: 32rpx;
  padding: 22rpx 22rpx calc(32rpx + env(safe-area-inset-bottom));
}
.sheet-head { display: flex; align-items: flex-start; justify-content: space-between; }
.sheet-kicker { font-size: 18rpx; font-weight: 900; color: var(--ft-on-surface-variant); letter-spacing: 2rpx; }
.sheet-title { margin-top: 6rpx; font-size: 36rpx; font-weight: 900; }
.sheet-close { width: 80rpx; height: 80rpx; border-radius: 9999rpx; background: var(--ft-surface-container); display: flex; align-items: center; justify-content: center; font-size: 40rpx; color: var(--ft-on-surface-variant); }
.sheet-list { margin-top: 20rpx; display: flex; flex-direction: column; gap: 10rpx; }
.sheet-item { height: 96rpx; border-radius: 20rpx; background: var(--ft-surface-container-lowest); padding: 0 24rpx; display: flex; align-items: center; justify-content: space-between; font-size: 30rpx; font-weight: 900; color: var(--ft-on-surface); }
.sheet-item.danger { color: var(--ft-error); }
.sheet-cancel { height: 96rpx; border-radius: 9999rpx; background: var(--ft-surface-container); display: flex; align-items: center; justify-content: center; font-size: 30rpx; font-weight: 900; margin-top: 6rpx; }

.confirm-overlay { position: fixed; inset: 0; z-index: 90; background: rgba(0,0,0,0.35); }
.confirm-modal {
  position: fixed; left: 50%; top: 50%; transform: translate(-50%, -50%);
  z-index: 100; width: 670rpx; max-width: 90vw;
  background: rgba(255,255,255,0.92);
  backdrop-filter: blur(12rpx);
  border-radius: 24rpx;
  box-shadow: 0 12rpx 24rpx rgba(67,41,0,0.12);
  padding: 24rpx;
}
.confirm-kicker { font-size: 18rpx; font-weight: 900; color: var(--ft-on-surface-variant); letter-spacing: 2rpx; }
.confirm-title { margin-top: 6rpx; font-size: 36rpx; font-weight: 900; }
.confirm-desc { margin-top: 12rpx; font-size: 24rpx; color: var(--ft-on-surface-variant); font-weight: 700; }
.confirm-actions { margin-top: 22rpx; display: grid; grid-template-columns: 1fr 1fr; gap: 12rpx; }
.confirm-btn { height: 92rpx; border-radius: 9999rpx; background: var(--ft-surface-container); display: flex; align-items: center; justify-content: center; font-size: 28rpx; font-weight: 900; }
.confirm-btn.danger { background: var(--ft-error-container); color: var(--ft-on-error-container); }

