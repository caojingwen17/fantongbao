.page{
  padding: 20rpx;
}
.search{
  margin-bottom: 18rpx;
}
.search-input{
  border-radius: var(--ft-r-xl);
  background: var(--ft-surface-container-lowest);
  border: 1px solid var(--ft-outline-variant);
  padding: 14rpx 16rpx;
}
.add-btn{
  margin-bottom: 20rpx;
}
.list{
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.card{
  display: flex;
  gap: 16rpx;
  align-items: center;
  padding: 16rpx;
  border-radius: var(--ft-r-xl);
  background: var(--ft-surface-container-low);
}
.img{
  width: 120rpx;
  height: 90rpx;
  border-radius: 10rpx;
}
.meta{
  flex: 1;
}
.name{
  font-size: 30rpx;
  font-weight: 600;
}
.time{
  font-size: 22rpx;
  color: var(--ft-on-surface-variant);
  margin-top: 8rpx;
}
.empty{
  padding: 50rpx 0;
  text-align: center;
  color: rgba(0,0,0,0.35);
}

