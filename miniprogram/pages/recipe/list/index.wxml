<view class="ft-page recipe-list-page">
  <ft-loading id="ft-loading" />
  <view class="blob blob-a"></view>
  <view class="blob blob-b"></view>

  <ft-topbar title="家庭菜谱" custom-back bind:back="onBack" />

  <scroll-view scroll-y="true" class="main" show-scrollbar="false" scrollbar-hidden="true" enhanced="true" refresher-enabled refresher-triggered="{{refreshing}}" bindrefresherrefresh="onRefresh" bindscrolltolower="loadMoreRecipes" lower-threshold="80">
    <view class="main-inner">
      <view class="search-wrap">
        <view class="search-icon ft-ico ft-ico-search ft-ico-sm"></view>
        <input class="search-input" placeholder="搜索菜名" value="{{keyword}}" bindinput="onKeywordInput" />
        <view class="clear-btn" wx:if="{{keyword}}" bindtap="onClearKeyword">×</view>
      </view>

      <view class="ft-btn ft-btn-primary ft-btn-block add-recipe-btn" bindtap="goAdd">添加菜谱</view>

      <view class="count-row">
        <view class="count-text">共 {{viewRecipes.length}}{{hasMore ? "+" : ""}} 个菜谱</view>
        <view class="hint-text" wx:if="{{keyword}}">已按关键词筛选</view>
      </view>
      <view class="list-hint-delete" wx:if="{{viewRecipes.length}}">长按条目可编辑，点右侧图标删除</view>

      <view class="recipe-list" wx:if="{{viewRecipes.length}}">
        <block wx:for="{{viewRecipes}}" wx:key="id">
          <view class="recipe-item" bindtap="goDetail" bindlongpress="onLongPressRecipe" data-recipeid="{{item.id}}">
            <view class="recipe-row">
              <view class="recipe-media">
                <ft-cloud-image imgClass="recipe-img" src="{{item.recipeImg}}" familyId="{{familyId}}" />
              </view>
              <view class="recipe-body">
                <view class="recipe-name">{{item.recipeName}}</view>
                <view class="recipe-date">添加于 {{item.createDateText}}</view>
              </view>
              <view
                class="recipe-del"
                catchtap="onTapDeleteRecipe"
                data-recipeid="{{item.id}}"
                aria-label="删除菜谱"
              >
                <view class="ft-ico ft-ico-trash ft-ico-sm"></view>
              </view>
            </view>
          </view>
        </block>
      </view>

      <view class="list-footer" wx:if="{{loadingMore}}">加载中…</view>
      <view class="list-footer" wx:elif="{{viewRecipes.length && !hasMore}}">没有更多了</view>

      <view class="ft-empty" wx:if="{{!viewRecipes.length}}">
        <view class="ft-ico ft-ico-dish ft-ico-lg"></view>
        <view class="ft-empty-title">暂无菜谱</view>
        <view class="ft-empty-sub">先添加一份家庭常用菜谱吧</view>
        <view class="ft-btn ft-btn-primary ft-btn-sm" bindtap="goAdd">添加菜谱</view>
      </view>
    </view>
  </scroll-view>

  <view class="ft-loading-mask" wx:if="{{listLoading}}">
    <view class="ft-loading-mark"><view class="ft-ico ft-ico-cook"></view></view>
    <view class="ft-loading-dots">
      <view class="ft-loading-dot"></view>
      <view class="ft-loading-dot"></view>
      <view class="ft-loading-dot"></view>
    </view>
    <text class="ft-loading-text">加载菜谱…</text>
  </view>

  <view class="sheet-overlay ft-anim-mask" wx:if="{{sheetVisible}}" catchtap="closeSheet"></view>
  <view class="action-sheet ft-anim-sheet" wx:if="{{sheetVisible}}">
    <view class="sheet-head">
      <view>
        <view class="sheet-kicker">操作</view>
        <view class="sheet-title">{{selectedRecipeName}}</view>
      </view>
      <view class="sheet-close" bindtap="closeSheet">×</view>
    </view>
    <view class="sheet-list">
      <view class="sheet-item" bindtap="onEditSelected">
        <text>编辑</text>
        <text>›</text>
      </view>
      <view class="sheet-item danger" bindtap="onAskDeleteSelected">
        <text>删除</text>
        <text>›</text>
      </view>
      <view class="sheet-cancel" bindtap="closeSheet">取消</view>
    </view>
  </view>

  <ft-modal
    visible="{{confirmModal.visible}}"
    kicker="{{confirmModal.kicker}}"
    title="{{confirmModal.title}}"
    content="{{confirmModal.content}}"
    confirm-text="{{confirmModal.confirmText}}"
    danger="{{confirmModal.danger}}"
    bind:confirm="onConfirmModalOk"
    bind:cancel="onConfirmModalCancel"
  />
</view>

