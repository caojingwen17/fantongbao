<view class="ft-page recipe-add-page">
  <!-- Decorative blobs -->
  <view class="blob blob-a"></view>
  <view class="blob blob-b"></view>

  <!-- Top App Bar -->
  <view class="topbar">
    <view class="top-left">
      <view class="icon-btn" bindtap="onBack" aria-label="返回">
        <text class="ico" aria-hidden="true">‹</text>
      </view>
      <view class="top-title">新增菜谱</view>
    </view>
    <view class="top-spacer" aria-hidden="true"></view>
  </view>

  <scroll-view scroll-y="{{!stepDrag.active}}" class="main" show-scrollbar="false" scrollbar-hidden="true" enhanced="true">
    <view class="main-inner">
      <!-- 基础信息 -->
      <view class="card base-card">
        <view class="card-head">
          <view class="card-title">基础信息</view>
        </view>

        <view class="field">
          <view class="field-head">
            <view class="field-label">菜名</view>
          <view class="pill pill-warn" aria-hidden="true">必填</view>
          </view>
          <view class="input-wrap">
            <view class="input-ico" aria-hidden="true">🍽️</view>
            <input
              class="input input-name"
              placeholder="例如：西红柿炒蛋"
              value="{{recipeName}}"
              bindinput="onRecipeNameInput"
            />
          </view>
        </view>

        <view class="field">
          <view class="field-head">
            <view class="field-label">菜品展示图</view>
          </view>

          <view class="cover-upload {{!canImport ? 'disabled' : ''}}" wx:if="{{!recipeImg}}">
            <view class="cover-left">
              <view class="cover-title">上传展示图</view>
              <view class="cover-sub">建议 1:1 或 16:10</view>
            </view>
            <view class="cover-btn {{!canImport ? 'disabled' : ''}}" bindtap="onChooseImage" aria-label="上传图片">
              上传
            </view>
          </view>

          <view class="cover-preview" wx:if="{{recipeImg}}">
            <image class="cover-img" mode="aspectFill" src="{{recipeImgDisplay || recipeImg}}" aria-label="展示图预览" />
            <view class="cover-grad" aria-hidden="true"></view>
            <view class="cover-bottom">
              <view class="cover-btm-left">
                <view class="cover-state">已上传</view>
                <view class="cover-tip">可重新上传替换图片</view>
              </view>
              <view class="reupload-btn" bindtap="onChooseImage" aria-label="重新上传图片">
                <text class="reupload-ico" aria-hidden="true">⤒</text>
                重新上传
              </view>
            </view>
          </view>
        </view>
      </view>

      <!-- 导入 -->
      <view class="import-head">
        <view class="import-title">导入</view>
        <view class="import-status {{canImport ? 'import-status-ok' : ''}}">{{canImport ? "已解锁" : "未解锁"}}</view>
      </view>

      <view class="card import-card {{canImport ? '' : 'disabled'}}">
        <view class="import-tabs" aria-label="导入方式">
          <view
            class="import-tab {{importTab === 'image' ? 'import-tab-active' : ''}}"
            bindtap="onImportTabChange"
            data-tab="image"
            aria-label="多图识别"
          >多图识别</view>
          <view
            class="import-tab {{importTab === 'text' ? 'import-tab-active' : ''}}"
            bindtap="onImportTabChange"
            data-tab="text"
            aria-label="文字识别"
          >文字识别</view>
          <view
            class="import-tab {{importTab === 'auto' ? 'import-tab-active' : ''}}"
            bindtap="onImportTabChange"
            data-tab="auto"
            aria-label="自动生成"
          >自动生成</view>
        </view>

        <!-- 多图识别 -->
        <view class="import-block" wx:if="{{importTab === 'image'}}">
          <view class="import-hint import-hint-below-title">可从小红书下载或截图菜谱图片，最多 6 张 · 单张 ≤ 10MB</view>
          <view class="import-actions import-actions-single">
            <view class="pick-btn {{(!canImport || isImportingImage) ? 'disabled' : ''}}" bindtap="onImportFromLocalImage" aria-label="选择图片">
              选择图片
            </view>
          </view>
        </view>

        <!-- 文字识别 -->
        <view class="import-block" wx:if="{{importTab === 'text'}}">
          <view class="import-hint import-hint-below-title">粘贴小红书文案、食材清单或做法步骤等文字内容</view>
          <textarea
            class="paste-textarea"
            placeholder="粘贴菜谱文字，例如食材、调料、备菜与做菜步骤…"
            value="{{pastedRecipeText}}"
            bindinput="onPastedRecipeTextInput"
            maxlength="8000"
            disabled="{{!canImport}}"
          />
          <view class="import-actions import-actions-paste">
            <view class="import-hint">已输入 {{pastedLen}} 字 · 至少 8 字</view>
            <view class="pick-btn {{(!canImport || isExtractingFromText || pastedLen < 8) ? 'disabled' : ''}}" bindtap="onExtractFromPastedText" aria-label="识别文字">
              识别
            </view>
          </view>
        </view>

        <!-- 自动生成 -->
        <view class="import-block" wx:if="{{importTab === 'auto'}}">
          <view class="import-hint import-hint-below-title">根据菜名自动生成常用家常菜谱，可继续手动调整</view>
          <view class="import-actions import-actions-single">
            <view class="pick-btn {{(!canImport || isGeneratingCommon) ? 'disabled' : ''}}" bindtap="onGenerateCommonRecipe" aria-label="一键生成">
              生成
            </view>
          </view>
        </view>
      </view>

      <!-- 折叠组：食材 -->
      <view class="acc card">
        <view class="acc-head" bindtap="toggleAccordion" data-key="ingredients" aria-label="展开/收起 食材">
          <view class="acc-left">
            <view class="acc-ico acc-ico-warn" aria-hidden="true">🧺</view>
            <view class="acc-meta">
              <view class="acc-title-row">
                <view class="acc-title">食材</view>
                <view class="pill pill-warn" aria-hidden="true">至少 1</view>
              </view>
              <view class="acc-sub">已填 {{ingredients.length}} 项</view>
            </view>
          </view>
          <view class="acc-chev" aria-hidden="true">{{accordion.ingredients ? "˄" : "˅"}}</view>
        </view>
        <view class="acc-body" wx:if="{{accordion.ingredients}}">
          <block wx:for="{{ingredients}}" wx:key="index">
            <view class="pair-row">
              <view class="pair-left">
                <input class="pair-input" placeholder="食材名称" data-index="{{index}}" value="{{item.name}}" bindinput="onIngredientNameInput" />
                <input class="pair-input pair-amt" placeholder="用量" data-index="{{index}}" value="{{item.amount}}" bindinput="onIngredientAmountInput" />
              </view>
              <view class="remove-btn" bindtap="removeIngredient" data-index="{{index}}" aria-label="删除">－</view>
            </view>
          </block>
          <view class="add-row-btn" bindtap="addIngredient" aria-label="添加食材">＋ 添加食材</view>
        </view>
      </view>

      <!-- 调料 -->
      <view class="acc card">
        <view class="acc-head" bindtap="toggleAccordion" data-key="seasonings" aria-label="展开/收起 调料">
          <view class="acc-left">
            <view class="acc-ico acc-ico-ok" aria-hidden="true">⚗️</view>
            <view class="acc-meta">
              <view class="acc-title-row">
                <view class="acc-title">调料</view>
                <view class="acc-optional">可选</view>
              </view>
              <view class="acc-sub">已填 {{seasonings.length}} 项</view>
            </view>
          </view>
          <view class="acc-chev" aria-hidden="true">{{accordion.seasonings ? "˄" : "˅"}}</view>
        </view>
        <view class="acc-body" wx:if="{{accordion.seasonings}}">
          <block wx:for="{{seasonings}}" wx:key="index">
            <view class="pair-row">
              <view class="pair-left">
                <input class="pair-input" placeholder="调料名称" data-index="{{index}}" value="{{item.name}}" bindinput="onSeasoningNameInput" />
                <input class="pair-input pair-amt" placeholder="用量" data-index="{{index}}" value="{{item.amount}}" bindinput="onSeasoningAmountInput" />
              </view>
              <view class="remove-btn" bindtap="removeSeasoning" data-index="{{index}}" aria-label="删除">－</view>
            </view>
          </block>
          <view class="add-row-btn" bindtap="addSeasoning" aria-label="添加调料">＋ 添加调料</view>
        </view>
      </view>

      <!-- 备菜步骤 -->
      <view class="acc card">
        <view class="acc-head" bindtap="toggleAccordion" data-key="prep" aria-label="展开/收起 备菜步骤">
          <view class="acc-left">
            <view class="acc-ico acc-ico-neutral" aria-hidden="true">①</view>
            <view class="acc-meta">
              <view class="acc-title-row">
                <view class="acc-title">备菜步骤</view>
                <view class="pill pill-warn" aria-hidden="true">至少 1</view>
              </view>
              <view class="acc-sub">已填 {{prepareSteps.length}} 步</view>
            </view>
          </view>
          <view class="acc-chev" aria-hidden="true">{{accordion.prep ? "˄" : "˅"}}</view>
        </view>
        <view class="acc-body" wx:if="{{accordion.prep}}">
          <view class="step-drag-tip">按住左侧把手拖动可调整顺序</view>
          <block wx:for="{{prepareSteps}}" wx:key="id">
            <view
              class="step-row js-prep-step {{stepDrag.active && stepDrag.listKey === 'prepareSteps' && stepDrag.index === index ? 'step-row-dragging' : ''}} {{stepDrag.active && stepDrag.listKey === 'prepareSteps' && stepDrag.targetIndex === index && stepDrag.index !== index ? 'step-row-target' : ''}}"
              style="{{stepDrag.active && stepDrag.listKey === 'prepareSteps' && stepDrag.index === index ? 'transform: translateY(' + stepDrag.offsetY + 'px);' : ''}}"
            >
              <view
                class="step-drag-handle"
                catchtouchstart="onStepDragStart"
                catchtouchmove="onStepDragMove"
                catchtouchend="onStepDragEnd"
                catchtouchcancel="onStepDragEnd"
                data-list="prepareSteps"
                data-index="{{index}}"
                aria-label="拖动排序"
              >⋮⋮</view>
              <input class="step-input" placeholder="输入备菜步骤" data-index="{{index}}" value="{{item.text}}" bindinput="onPrepareStepInput" />
              <view class="remove-btn" bindtap="removePrepareStep" data-index="{{index}}" aria-label="删除">－</view>
            </view>
          </block>
          <view class="add-row-btn" bindtap="addPrepareStep" aria-label="添加步骤">＋ 添加步骤</view>
        </view>
      </view>

      <!-- 做菜步骤 -->
      <view class="acc card">
        <view class="acc-head" bindtap="toggleAccordion" data-key="cook" aria-label="展开/收起 做菜步骤">
          <view class="acc-left">
            <view class="acc-ico acc-ico-neutral" aria-hidden="true">🍳</view>
            <view class="acc-meta">
              <view class="acc-title-row">
                <view class="acc-title">做菜步骤</view>
                <view class="pill pill-warn" aria-hidden="true">至少 1</view>
              </view>
              <view class="acc-sub">已填 {{cookingSteps.length}} 步</view>
            </view>
          </view>
          <view class="acc-chev" aria-hidden="true">{{accordion.cook ? "˄" : "˅"}}</view>
        </view>
        <view class="acc-body" wx:if="{{accordion.cook}}">
          <view class="step-drag-tip">按住左侧把手拖动可调整顺序</view>
          <block wx:for="{{cookingSteps}}" wx:key="id">
            <view
              class="step-row js-cook-step {{stepDrag.active && stepDrag.listKey === 'cookingSteps' && stepDrag.index === index ? 'step-row-dragging' : ''}} {{stepDrag.active && stepDrag.listKey === 'cookingSteps' && stepDrag.targetIndex === index && stepDrag.index !== index ? 'step-row-target' : ''}}"
              style="{{stepDrag.active && stepDrag.listKey === 'cookingSteps' && stepDrag.index === index ? 'transform: translateY(' + stepDrag.offsetY + 'px);' : ''}}"
            >
              <view
                class="step-drag-handle"
                catchtouchstart="onStepDragStart"
                catchtouchmove="onStepDragMove"
                catchtouchend="onStepDragEnd"
                catchtouchcancel="onStepDragEnd"
                data-list="cookingSteps"
                data-index="{{index}}"
                aria-label="拖动排序"
              >⋮⋮</view>
              <input class="step-input" placeholder="输入做菜步骤" data-index="{{index}}" value="{{item.text}}" bindinput="onCookingStepInput" />
              <view class="remove-btn" bindtap="removeCookingStep" data-index="{{index}}" aria-label="删除">－</view>
            </view>
          </block>
          <view class="add-row-btn" bindtap="addCookingStep" aria-label="添加步骤">＋ 添加步骤</view>
        </view>
      </view>

      <view class="bottom-spacer" aria-hidden="true"></view>
    </view>
  </scroll-view>

  <!-- Sticky submit bar -->
  <view class="submit-bar">
    <view class="submit-btn" bindtap="onSubmit" aria-label="提交保存">💾 提交保存</view>
  </view>
</view>

