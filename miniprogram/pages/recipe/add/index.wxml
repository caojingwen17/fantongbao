<wxs module="m">
  function nonEmpty(s) {
    if (!s) return false;
    for (var j = 0; j < s.length; j++) {
      var c = s.charAt(j);
      if (c !== " " && c !== "\n" && c !== "\t" && c !== "\r") return true;
    }
    return false;
  }
  function filled(list) {
    var n = 0;
    for (var i = 0; i < list.length; i++) {
      var it = list[i];
      if (nonEmpty(it.name) || nonEmpty(it.text)) n++;
    }
    return n;
  }
  module.exports = { filled: filled };
</wxs>
<view class="ft-page recipe-add-page">
  <ft-loading id="ft-loading" />
  <ft-ai-loading id="aiLoading" />
  <!-- Decorative blobs -->
  <view class="blob blob-a"></view>
  <view class="blob blob-b"></view>

  <!-- Top App Bar -->
  <ft-topbar title="新增菜谱" />

  <scroll-view scroll-y="{{!stepDrag.active}}" class="main" show-scrollbar="false" scrollbar-hidden="true" enhanced="true" scroll-top="{{stepScrollTop}}" scroll-with-animation="{{true}}">
    <view class="main-inner">
      <!-- 基础信息 -->
      <view class="card base-card">
        <view class="card-head">
          <view class="card-title">基础信息</view>
        </view>

        <view class="field">
          <view class="field-head">
            <view class="field-label">菜名</view>
          <view class="pill pill-warn" aria-hidden="true">必填</view>
          </view>
          <view class="input-wrap">
            <view class="input-ico ft-ico ft-ico-dish ft-ico-sm"></view>
            <input
              class="input input-name"
              placeholder="例如：西红柿炒蛋"
              value="{{recipeName}}"
              bindinput="onRecipeNameInput"
            />
          </view>
        </view>

        <view class="field">
          <view class="field-head">
            <view class="field-label">菜品展示图</view>
          </view>

          <view class="cover-upload {{!canImport ? 'disabled' : ''}}" wx:if="{{!recipeImg}}" bindtap="onTapCoverUpload">
            <view class="cover-upload-ico">
              <view class="ft-ico ft-ico-upload"></view>
            </view>
            <view class="cover-left">
              <view class="cover-title">上传展示图</view>
              <view class="cover-sub">将按 4:3 比例裁切，建议真实菜品照片</view>
            </view>
          </view>

          <view class="cover-preview" wx:if="{{recipeImg}}">
            <ft-cloud-image imgClass="cover-img" src="{{recipeImgDisplay || recipeImg}}" familyId="{{familyId}}" />
            <view class="cover-grad" aria-hidden="true"></view>
            <view class="cover-bottom">
              <view class="cover-btm-left">
                <view class="cover-state">已上传</view>
                <view class="cover-tip">可重新上传替换图片</view>
              </view>
              <view class="reupload-btn" bindtap="onChooseImage">
                <view class="reupload-ico ft-ico ft-ico-upload ft-ico-sm"></view>
                重新上传
              </view>
            </view>
          </view>
        </view>
      </view>

      <!-- 导入 -->
      <view class="import-head">
        <view class="import-title">导入</view>
        <view class="import-status {{canImport ? 'import-status-ok' : ''}}">{{canImport ? "已解锁" : "填菜名后可用"}}</view>
      </view>

      <view class="import-card-wrap">
        <view class="import-lock-mask" wx:if="{{!canImport}}" catchtap="onImportLockedTap"></view>
        <view class="card import-card {{canImport ? '' : 'disabled'}}">
        <view class="import-tabs" aria-label="导入方式">
          <view
            class="import-tab {{importTab === 'link' ? 'import-tab-active' : ''}}"
            bindtap="onImportTabChange"
            data-tab="link"
            aria-label="链接识别"
          >链接识别</view>
          <view
            class="import-tab {{importTab === 'image' ? 'import-tab-active' : ''}}"
            bindtap="onImportTabChange"
            data-tab="image"
            aria-label="多图识别"
          >多图识别</view>
          <view
            class="import-tab {{importTab === 'text' ? 'import-tab-active' : ''}}"
            bindtap="onImportTabChange"
            data-tab="text"
            aria-label="文字识别"
          >文字识别</view>
          <view
            class="import-tab {{importTab === 'auto' ? 'import-tab-active' : ''}}"
            bindtap="onImportTabChange"
            data-tab="auto"
            aria-label="自动生成"
          >自动生成</view>
        </view>

        <!-- 链接识别 -->
        <view class="import-block" wx:if="{{importTab === 'link'}}">
          <view class="import-hint import-hint-below-title">粘贴小红书 App 的分享口令或链接，支持图文/视频笔记，自动读取文案、图片与口播字幕进行识别</view>
          <textarea
            class="paste-textarea"
            placeholder="例如：48 家常菜做法… http://xhslink.com/xxxxxx，复制本条信息，打开【小红书】App查看精彩内容！"
            value="{{linkText}}"
            bindinput="onLinkTextInput"
            maxlength="1000"
            disabled="{{!canImport}}"
          />
          <view class="import-actions import-actions-paste">
            <view class="import-hint">已输入 {{linkLen}} 字 · 识别失败可用截图导入</view>
            <view class="pick-btn {{(!canImport || isExtractingFromLink || linkLen < 10) ? 'disabled' : ''}}" bindtap="onExtractFromLink" aria-label="解析链接">
              识别
            </view>
          </view>
        </view>

        <!-- 多图识别 -->
        <view class="import-block" wx:if="{{importTab === 'image'}}">
          <view class="import-hint import-hint-below-title">可从小红书下载或截图菜谱图片，最多 6 张 · 单张 ≤ 10MB</view>
          <view class="import-actions import-actions-single">
            <view class="pick-btn {{(!canImport || isImportingImage) ? 'disabled' : ''}}" bindtap="onImportFromLocalImage" aria-label="选择图片">
              选择图片
            </view>
          </view>
        </view>

        <!-- 文字识别 -->
        <view class="import-block" wx:if="{{importTab === 'text'}}">
          <view class="import-hint import-hint-below-title">粘贴小红书文案、食材清单或做法步骤等文字内容</view>
          <textarea
            class="paste-textarea"
            placeholder="粘贴菜谱文字，例如食材、调料、备菜与做菜步骤…"
            value="{{pastedRecipeText}}"
            bindinput="onPastedRecipeTextInput"
            maxlength="8000"
            disabled="{{!canImport}}"
          />
          <view class="import-actions import-actions-paste">
            <view class="import-hint">已输入 {{pastedLen}} 字 · 至少 8 字</view>
            <view class="pick-btn {{(!canImport || isExtractingFromText || pastedLen < 8) ? 'disabled' : ''}}" bindtap="onExtractFromPastedText" aria-label="识别文字">
              识别
            </view>
          </view>
        </view>

        <!-- 自动生成 -->
        <view class="import-block" wx:if="{{importTab === 'auto'}}">
          <view class="import-hint import-hint-below-title">根据菜名自动生成常用家常菜谱，可继续手动调整</view>
          <view class="import-actions import-actions-single">
            <view class="pick-btn {{(!canImport || isGeneratingCommon) ? 'disabled' : ''}}" bindtap="onGenerateCommonRecipe" aria-label="一键生成">
              生成
            </view>
          </view>
        </view>
      </view>
      </view>

      <!-- 折叠组：食材 -->
      <view class="acc card" id="acc-ingredients">
        <view class="acc-head" bindtap="toggleAccordion" data-key="ingredients" aria-label="展开/收起 食材">
          <view class="acc-left">
            <view class="acc-ico acc-ico-warn"><view class="ft-ico ft-ico-basket"></view></view>
            <view class="acc-meta">
              <view class="acc-title-row">
                <view class="acc-title">食材</view>
                <view class="pill {{m.filled(ingredients) ? 'pill-ok' : 'pill-warn'}}">{{m.filled(ingredients) ? "已填 " + m.filled(ingredients) + " 项" : "至少 1"}}</view>
              </view>
              <view class="acc-sub">已填 {{ingredients.length}} 项</view>
            </view>
          </view>
          <view class="acc-chev ft-ico ft-ico-chev-down ft-ico-sm {{accordion.ingredients ? 'acc-chev-up' : ''}}"></view>
        </view>
        <view class="acc-body {{accordion.ingredients ? 'acc-body-open' : ''}}">
          <block wx:for="{{ingredients}}" wx:key="index">
            <view class="pair-row">
              <view class="pair-left">
                <input class="pair-input" placeholder="食材名称" data-index="{{index}}" value="{{item.name}}" bindinput="onIngredientNameInput" />
                <input class="pair-input pair-amt" placeholder="用量" data-index="{{index}}" value="{{item.amount}}" bindinput="onIngredientAmountInput" />
              </view>
              <view class="remove-btn" bindtap="removeIngredient" data-index="{{index}}" aria-label="删除">－</view>
            </view>
          </block>
          <view class="add-row-btn" bindtap="addIngredient" aria-label="添加食材">＋ 添加食材</view>
        </view>
      </view>

      <!-- 调料 -->
      <view class="acc card">
        <view class="acc-head" bindtap="toggleAccordion" data-key="seasonings" aria-label="展开/收起 调料">
          <view class="acc-left">
            <view class="acc-ico acc-ico-ok"><view class="ft-ico ft-ico-dish"></view></view>
            <view class="acc-meta">
              <view class="acc-title-row">
                <view class="acc-title">调料</view>
                <view class="acc-optional">可选</view>
              </view>
              <view class="acc-sub">已填 {{seasonings.length}} 项</view>
            </view>
          </view>
          <view class="acc-chev ft-ico ft-ico-chev-down ft-ico-sm {{accordion.seasonings ? 'acc-chev-up' : ''}}"></view>
        </view>
        <view class="acc-body {{accordion.seasonings ? 'acc-body-open' : ''}}">
          <block wx:for="{{seasonings}}" wx:key="index">
            <view class="pair-row">
              <view class="pair-left">
                <input class="pair-input" placeholder="调料名称" data-index="{{index}}" value="{{item.name}}" bindinput="onSeasoningNameInput" />
                <input class="pair-input pair-amt" placeholder="用量" data-index="{{index}}" value="{{item.amount}}" bindinput="onSeasoningAmountInput" />
              </view>
              <view class="remove-btn" bindtap="removeSeasoning" data-index="{{index}}" aria-label="删除">－</view>
            </view>
          </block>
          <view class="add-row-btn" bindtap="addSeasoning" aria-label="添加调料">＋ 添加调料</view>
        </view>
      </view>

      <!-- 备菜步骤 -->
      <view class="acc card" id="acc-prep">
        <view class="acc-head" bindtap="toggleAccordion" data-key="prep" aria-label="展开/收起 备菜步骤">
          <view class="acc-left">
            <view class="acc-ico acc-ico-neutral"><view class="ft-ico ft-ico-list"></view></view>
            <view class="acc-meta">
              <view class="acc-title-row">
                <view class="acc-title">备菜步骤</view>
                <view class="pill {{m.filled(prepareSteps) ? 'pill-ok' : 'pill-warn'}}">{{m.filled(prepareSteps) ? "已填 " + m.filled(prepareSteps) + " 步" : "至少 1"}}</view>
              </view>
              <view class="acc-sub">已填 {{prepareSteps.length}} 步</view>
            </view>
          </view>
          <view class="acc-chev ft-ico ft-ico-chev-down ft-ico-sm {{accordion.prep ? 'acc-chev-up' : ''}}"></view>
        </view>
        <view class="acc-body {{accordion.prep ? 'acc-body-open' : ''}}">
          <view class="step-drag-tip">长按步骤卡片拖动可调整顺序</view>
          <block wx:for="{{prepareSteps}}" wx:key="id">
            <view
              id="step-row-prepareSteps-{{index}}"
              class="step-row js-prep-step {{stepDrag.active && stepDrag.listKey === 'prepareSteps' && stepDrag.index === index ? 'step-row-dragging' : ''}}"
              style="{{stepDrag.active && stepDrag.listKey === 'prepareSteps' ? (stepDrag.index === index ? 'transform: translateY(' + stepDrag.offsetY + 'px) scale(1.02);' : 'transform: translateY(' + ((stepDrag.shiftY && stepDrag.shiftY[index]) || 0) + 'px);') : ''}}"
              bindlongpress="onStepDragStart"
              bindtouchmove="onStepDragMove"
              bindtouchend="onStepDragEnd"
              bindtouchcancel="onStepDragEnd"
              data-list="prepareSteps"
              data-index="{{index}}"
            >
              <view
                wx:if="{{stepFocusKey !== 'prepareSteps-' + index}}"
                class="step-input step-input-view {{item.text ? '' : 'is-placeholder'}}"
                data-list="prepareSteps"
                data-index="{{index}}"
                bindtap="onStepFocus"
              >
                <text class="step-num">{{index + 1}}</text>
                <text class="step-text">{{item.text || "输入备菜步骤"}}</text>
              </view>
              <view class="step-input-wrap" wx:else>
                <textarea
                  class="step-input step-input-open"
                  style="height: {{stepFocusHeight}}px; width: 100%;"
                  focus="{{true}}"
                  adjust-position="{{false}}"
                  show-confirm-bar="{{false}}"
                  cursor-spacing="24"
                  data-index="{{index}}"
                  value="{{item.text}}"
                  bindinput="onPrepareStepInput"
                  bindblur="onStepBlur"
                />
              </view>
              <view class="remove-btn" bindtap="removePrepareStep" data-index="{{index}}" aria-label="删除">－</view>
            </view>
          </block>
          <view class="add-row-btn" bindtap="addPrepareStep" aria-label="添加步骤">＋ 添加步骤</view>
        </view>
      </view>

      <!-- 做菜步骤 -->
      <view class="acc card" id="acc-cook">
        <view class="acc-head" bindtap="toggleAccordion" data-key="cook" aria-label="展开/收起 做菜步骤">
          <view class="acc-left">
            <view class="acc-ico acc-ico-neutral"><view class="ft-ico ft-ico-cook"></view></view>
            <view class="acc-meta">
              <view class="acc-title-row">
                <view class="acc-title">做菜步骤</view>
                <view class="pill {{m.filled(cookingSteps) ? 'pill-ok' : 'pill-warn'}}">{{m.filled(cookingSteps) ? "已填 " + m.filled(cookingSteps) + " 步" : "至少 1"}}</view>
              </view>
              <view class="acc-sub">已填 {{cookingSteps.length}} 步</view>
            </view>
          </view>
          <view class="acc-chev ft-ico ft-ico-chev-down ft-ico-sm {{accordion.cook ? 'acc-chev-up' : ''}}"></view>
        </view>
        <view class="acc-body {{accordion.cook ? 'acc-body-open' : ''}}">
          <view class="step-drag-tip">长按步骤卡片拖动可调整顺序</view>
          <block wx:for="{{cookingSteps}}" wx:key="id">
            <view
              id="step-row-cookingSteps-{{index}}"
              class="step-row js-cook-step {{stepDrag.active && stepDrag.listKey === 'cookingSteps' && stepDrag.index === index ? 'step-row-dragging' : ''}}"
              style="{{stepDrag.active && stepDrag.listKey === 'cookingSteps' ? (stepDrag.index === index ? 'transform: translateY(' + stepDrag.offsetY + 'px) scale(1.02);' : 'transform: translateY(' + ((stepDrag.shiftY && stepDrag.shiftY[index]) || 0) + 'px);') : ''}}"
              bindlongpress="onStepDragStart"
              bindtouchmove="onStepDragMove"
              bindtouchend="onStepDragEnd"
              bindtouchcancel="onStepDragEnd"
              data-list="cookingSteps"
              data-index="{{index}}"
            >
              <view
                wx:if="{{stepFocusKey !== 'cookingSteps-' + index}}"
                class="step-input step-input-view {{item.text ? '' : 'is-placeholder'}}"
                data-list="cookingSteps"
                data-index="{{index}}"
                bindtap="onStepFocus"
              >
                <text class="step-num">{{index + 1}}</text>
                <text class="step-text">{{item.text || "输入做菜步骤"}}</text>
              </view>
              <view class="step-input-wrap" wx:else>
                <textarea
                  class="step-input step-input-open"
                  style="height: {{stepFocusHeight}}px; width: 100%;"
                  focus="{{true}}"
                  adjust-position="{{false}}"
                  show-confirm-bar="{{false}}"
                  cursor-spacing="24"
                  data-index="{{index}}"
                  value="{{item.text}}"
                  bindinput="onCookingStepInput"
                  bindblur="onStepBlur"
                />
              </view>
              <view class="remove-btn" bindtap="removeCookingStep" data-index="{{index}}" aria-label="删除">－</view>
            </view>
          </block>
          <view class="add-row-btn" bindtap="addCookingStep" aria-label="添加步骤">＋ 添加步骤</view>
        </view>
      </view>

      <!-- 键盘弹出时撑开底部，保证最后几步能滚动到键盘上方 -->
      <view class="bottom-spacer" style="{{keyboardHeight > 0 ? 'height: ' + keyboardHeight + 'px;' : ''}}" aria-hidden="true"></view>
    </view>
  </scroll-view>

  <!-- Sticky submit bar -->
  <view class="ft-bottom-bar">
    <view class="ft-btn ft-btn-primary" bindtap="onSubmit">提交保存</view>
  </view>

  <ft-image-cropper id="cropper" bind:confirm="onCropConfirm" bind:cancel="onCropCancel" />
</view>

