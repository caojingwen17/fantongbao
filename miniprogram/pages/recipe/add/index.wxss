.recipe-add-page {
  min-height: 100vh;
  position: relative;
  overflow: hidden;
}

.blob {
  position: absolute;
  border-radius: 9999rpx;
  pointer-events: none;
  filter: blur(60rpx);
}
.blob-a {
  width: 520rpx;
  height: 520rpx;
  right: -200rpx;
  top: -220rpx;
  background: var(--ft-secondary-fixed, #f9e534);
  opacity: 0.18;
}
.blob-b {
  width: 520rpx;
  height: 520rpx;
  left: -240rpx;
  top: 420rpx;
  background: var(--ft-tertiary-fixed, #91f78e);
  opacity: 0.12;
}

.topbar {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  z-index: 50;
  padding: 70rpx 40rpx 0rpx;
  padding-top: calc(80rpx + constant(safe-area-inset-top));
  padding-top: calc(80rpx + env(safe-area-inset-top));
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: rgba(255, 247, 237, 0.82);
  backdrop-filter: blur(12rpx);
}
.top-left {
  display: flex;
  align-items: center;
  gap: 18rpx;
  min-width: 0;
}
.icon-btn {
  width: 80rpx;
  height: 80rpx;
  border-radius: 9999rpx;
  background: var(--ft-surface-container-lowest);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--ft-on-surface-variant);
}
.icon-btn:active {
  transform: scale(0.90);
}
.ico {
  font-size: 42rpx;
  font-weight: 900;
  line-height: 1;
  transform: translateY(-2rpx);
}
.top-title {
  font-size: 32rpx;
  font-weight: 900;
  letter-spacing: -0.5rpx;
  white-space: nowrap;
}
.top-spacer {
  width: 80rpx;
  height: 80rpx;
}

.main {
  position: relative;
  z-index: 1;
  height: 100vh;
  padding-top: calc(246rpx + constant(safe-area-inset-top));
  padding-top: calc(246rpx + env(safe-area-inset-top));
}
.main::-webkit-scrollbar {
  display: none;
}
.main-inner {
  padding: 0 40rpx 0;
  padding-bottom: calc(200rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(200rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.card {
  background: var(--ft-surface-container-lowest);
  border-radius: 64rpx; /* rounded-lg = 2rem */
}
.base-card {
  padding: 40rpx;
  display: flex;
  flex-direction: column;
  gap: 40rpx;
}
.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.card-title {
  font-size: 32rpx;
  font-weight: 900;
}
.pill {
  border-radius: 9999rpx;
  padding: 8rpx 18rpx;
  font-size: 18rpx;
  font-weight: 900;
  letter-spacing: 1.6rpx;
}
.pill-warn { background: #f9e534; color: #5b5300; }
.pill-muted { background: var(--ft-surface-container); color: var(--ft-on-surface-variant); }

.field { display: flex; flex-direction: column; gap: 16rpx; }
.field-head { display: flex; align-items: center; justify-content: space-between; }
.field-label { font-size: 24rpx; font-weight: 900; }

.input-wrap { position: relative; }
.input-ico {
  position: absolute;
  left: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  opacity: 0.65;
}
.input {
  width: 100%;
  height: 112rpx;
  border-radius: 64rpx;
  background: var(--ft-surface-container);
  padding: 0 24rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  color: var(--ft-on-surface);
}
.input-name { padding-left: 84rpx; }

.cover-upload {
  border-radius: 64rpx;
  background: var(--ft-surface-container);
  padding: 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}
.cover-left { min-width: 0; }
.cover-title { font-weight: 900; }
.cover-sub { margin-top: 6rpx; font-size: 22rpx; font-weight: 700; color: var(--ft-on-surface-variant); }
.cover-btn {
  height: 96rpx;
  padding: 0 28rpx;
  border-radius: 9999rpx;
  background: linear-gradient(135deg, var(--ft-primary) 0%, var(--ft-primary-container) 100%);
  color: var(--ft-on-primary);
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 24rpx 48rpx rgba(135, 78, 0, 0.14);
}
.cover-btn:active { transform: scale(0.95); }

.cover-preview {
  border-radius: 64rpx;
  overflow: hidden;
  background: var(--ft-surface-container);
  position: relative;
  height: 0;
  padding-bottom: 62.5%; /* 16/10 */
}
.cover-img { position: absolute; left: 0; top: 0; width: 100%; height: 100%; }
.cover-grad { position: absolute; inset: 0; background: linear-gradient(to top, rgba(0,0,0,0.35), rgba(0,0,0,0)); }
.cover-bottom {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  bottom: 24rpx;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 18rpx;
}
.cover-btm-left { min-width: 0; }
.cover-state { font-size: 18rpx; font-weight: 900; letter-spacing: 1.6rpx; color: rgba(255,255,255,0.82); }
.cover-tip { margin-top: 8rpx; font-size: 24rpx; font-weight: 900; color: #fff; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.reupload-btn {
  height: 88rpx;
  padding: 0 26rpx;
  border-radius: 9999rpx;
  background: rgba(255,255,255,0.25);
  color: #fff;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}
.reupload-btn:active { transform: scale(0.95); }
.reupload-ico { opacity: 0.9; transform: translateY(-1rpx); }

.import-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 8rpx;
}
.import-title { font-size: 32rpx; font-weight: 900; }
.import-status { font-size: 24rpx; font-weight: 900; color: var(--ft-on-surface-variant); }
.import-status-ok { color: var(--ft-primary); }

.import-card { padding: 40rpx; display: flex; flex-direction: column; gap: 24rpx; }
.import-row { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; }
.import-name { font-weight: 900; }
.import-dev {
  margin-top: 18rpx;
  background: var(--ft-surface-container);
  border-radius: 64rpx;
  padding: 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}
.import-dev-title { font-size: 26rpx; font-weight: 900; }
.import-dev-sub { margin-top: 6rpx; font-size: 22rpx; font-weight: 700; color: var(--ft-on-surface-variant); }
.import-dev-ico {
  width: 96rpx;
  height: 96rpx;
  border-radius: 9999rpx;
  background: var(--ft-surface-container-lowest);
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgba(149,112,60,0.7);
  font-size: 34rpx;
}
.divider { height: 2rpx; background: var(--ft-surface-container); opacity: 1; }
.import-actions { margin-top: 18rpx; display: flex; align-items: center; justify-content: space-between; gap: 18rpx; }
.import-hint { font-size: 22rpx; font-weight: 700; color: var(--ft-on-surface-variant); }
.import-hint-extra { margin-top: 10rpx; }
.import-hint-below-title {
  margin-top: 10rpx;
  line-height: 1.45;
}
.paste-textarea {
  margin-top: 18rpx;
  min-height: 220rpx;
  padding: 24rpx 28rpx;
  border-radius: 24rpx;
  background: var(--ft-surface-container);
  font-size: 28rpx;
  line-height: 1.5;
  width: 100%;
  box-sizing: border-box;
  color: var(--ft-on-surface);
}
.import-actions-paste {
  margin-top: 14rpx;
}
.pick-btn {
  height: 96rpx;
  padding: 0 28rpx;
  border-radius: 9999rpx;
  background: #f9e534;
  color: #5b5300;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
}
.pick-btn:active { transform: scale(0.95); }

.acc { overflow: hidden; }
.acc-head {
  padding: 32rpx 40rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}
.acc-head:active { transform: scale(0.995); }
.acc-left { display: flex; align-items: center; gap: 18rpx; min-width: 0; }
.acc-ico {
  width: 80rpx;
  height: 80rpx;
  border-radius: 9999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.acc-ico-warn { background: #f9e534; color: #5b5300; }
.acc-ico-ok { background: #91f78e; color: #005e17; }
.acc-ico-neutral { background: var(--ft-surface-container); color: var(--ft-on-surface-variant); }
.acc-meta { min-width: 0; }
.acc-title-row { display: flex; align-items: center; gap: 12rpx; }
.acc-title { font-size: 32rpx; font-weight: 900; }
.acc-optional { font-size: 24rpx; font-weight: 900; color: var(--ft-on-surface-variant); }
.acc-sub { margin-top: 6rpx; font-size: 22rpx; font-weight: 700; color: var(--ft-on-surface-variant); }
.acc-chev { color: rgba(149,112,60,0.7); font-size: 34rpx; font-weight: 900; }

.acc-body { padding: 0 40rpx 40rpx; display: flex; flex-direction: column; gap: 18rpx; }
.pair-row, .step-row { display: flex; align-items: center; gap: 18rpx; }
.pair-left { flex: 1 1 auto; min-width: 0; display: flex; gap: 18rpx; }
.pair-input, .step-input {
  height: 96rpx;
  border-radius: 64rpx;
  background: var(--ft-surface-container);
  padding: 0 24rpx;
  font-size: 26rpx;
  box-sizing: border-box;
  flex: 1 1 auto;
  min-width: 0;
}
.pair-amt { flex: 0 0 160rpx; }
.remove-btn {
  width: 96rpx;
  height: 96rpx;
  border-radius: 9999rpx;
  background: var(--ft-surface-container);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--ft-on-surface-variant);
  font-weight: 900;
  font-size: 34rpx;
}
.remove-btn:active { transform: scale(0.90); }
.add-row-btn {
  height: 96rpx;
  border-radius: 9999rpx;
  background: var(--ft-surface-container);
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 900;
}
.add-row-btn:active { transform: scale(0.95); }

.submit-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 55;
  padding: 24rpx 40rpx 40rpx;
  padding-bottom: calc(40rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
  background: rgba(255, 245, 236, 0.88);
  backdrop-filter: blur(14rpx);
  border-top: 2rpx solid var(--ft-surface-container);
}
.submit-btn {
  height: 112rpx;
  border-radius: 9999rpx;
  background: linear-gradient(135deg, var(--ft-primary) 0%, var(--ft-primary-container) 100%);
  color: var(--ft-on-primary);
  font-weight: 900;
  font-size: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  box-shadow: 0 24rpx 48rpx rgba(135, 78, 0, 0.18);
}
.submit-btn:active { transform: scale(0.95); }

.bottom-spacer { height: 40rpx; }
.disabled { opacity: 0.45; filter: grayscale(0.2); pointer-events: none; }

