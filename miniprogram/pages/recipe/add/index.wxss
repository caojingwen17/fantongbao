.page{
  padding: 24rpx;
}
.p-card{
  padding: 22rpx;
}
.hero{
  margin-bottom: 18rpx;
}
.hero-title{
  font-size: 40rpx;
}
.hero-sub{
  margin-top: 8rpx;
  font-size: 24rpx;
}
.section{
  margin-bottom: 18rpx;
}
.label{
  font-size: 28rpx;
  margin-bottom: 12rpx;
}
.input{
  width: 100%;
}
.btn{
  margin-top: 12rpx;
}
.subtip{
  margin-top: 10rpx;
  font-size: 24rpx;
}
.submit{
  margin-top: 18rpx;
}
.tip{
  margin-top: 30rpx;
  font-size: 24rpx;
}

.img-row{
  display: flex;
  gap: 16rpx;
  align-items: flex-start;
}
.preview{
  width: 160rpx;
  height: 120rpx;
  border-radius: var(--ft-r-lg);
  background: var(--ft-surface-container-high);
}
.img-actions{
  flex: 1;
}
.listRow{
  display: flex;
  gap: 12rpx;
  align-items: center;
  margin-bottom: 14rpx;
}
.danger{
  font-size: 22rpx;
  height: 56rpx;
  padding: 0 18rpx;
}

.stepRow{
  margin-bottom: 16rpx;
}
.stepBtns{
  display: flex;
  gap: 12rpx;
  margin-top: 10rpx;
  flex-wrap: wrap;
}
.small{
  font-size: 22rpx;
  height: 56rpx;
  padding: 0 18rpx;
}

