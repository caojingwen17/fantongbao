<view class="ft-loading-mask" wx:if="{{pageLoading}}">
  <view class="ft-loading-mark"><view class="ft-ico ft-ico-cook"></view></view>
  <view class="ft-loading-dots">
    <view class="ft-loading-dot"></view>
    <view class="ft-loading-dot"></view>
    <view class="ft-loading-dot"></view>
  </view>
  <text class="ft-loading-text">加载菜谱…</text>
</view>
<view class="ft-page recipe-detail-page" wx:else>
  <ft-loading id="ft-loading" />
  <view class="blob blob-a"></view>
  <view class="blob blob-b"></view>

  <!-- Top App Bar -->
  <ft-topbar title="菜谱详情" custom-back bind:back="onBack" />

  <scroll-view scroll-y="true" class="main" show-scrollbar="false" scrollbar-hidden="true" enhanced="true">
    <view class="main-inner">
      <!-- Hero -->
      <view class="card hero-card">
        <view class="hero-media">
          <image class="hero-img" wx:if="{{recipeImgDisplay}}" mode="aspectFill" src="{{recipeImgDisplay}}" />
          <view class="hero-grad" aria-hidden="true"></view>
          <view class="hero-edit-btn ft-btn ft-btn-sm" bindtap="goEdit">修改</view>
          <view class="hero-bottom">
            <view class="hero-kicker">家常快手</view>
            <view class="hero-title">{{recipeName}}</view>
          </view>
        </view>
      </view>

      <!-- 食材 -->
      <view class="card section-card">
        <view class="section-head">
          <view class="section-title">食材</view>
          <view class="count-pill">{{ingredients ? ingredients.length : 0}} 项</view>
        </view>
        <view class="list" wx:if="{{ingredients && ingredients.length}}">
          <block wx:for="{{ingredients}}" wx:key="index">
            <view class="row">
              <view class="row-name">{{item.name}}</view>
              <view class="row-amt">{{item.amount}}</view>
            </view>
          </block>
        </view>
        <view class="empty" wx:if="{{!ingredients || ingredients.length===0}}">暂无食材</view>
      </view>

      <!-- 调料 -->
      <view class="card section-card">
        <view class="section-head">
          <view class="section-title">调料</view>
          <view class="count-pill">{{seasonings ? seasonings.length : 0}} 项</view>
        </view>
        <view class="list" wx:if="{{seasonings && seasonings.length}}">
          <block wx:for="{{seasonings}}" wx:key="index">
            <view class="row">
              <view class="row-name">{{item.name}}</view>
              <view class="row-amt">{{item.amount}}</view>
            </view>
          </block>
        </view>
        <view class="empty" wx:if="{{!seasonings || seasonings.length===0}}">暂无调料</view>
      </view>

      <!-- 备菜步骤 -->
      <view class="card section-card">
        <view class="section-head">
          <view class="section-title">备菜步骤</view>
          <view class="count-pill">{{prepareSteps ? prepareSteps.length : 0}} 步</view>
        </view>
        <view class="steps" wx:if="{{prepareSteps && prepareSteps.length}}">
          <block wx:for="{{prepareSteps}}" wx:key="index">
            <view class="step-item">
              <view class="step-num">{{index+1}}</view>
              <view class="step-text">{{item}}</view>
            </view>
          </block>
        </view>
        <view class="empty" wx:if="{{!prepareSteps || prepareSteps.length===0}}">暂无备菜步骤</view>
      </view>

      <!-- 做菜步骤 -->
      <view class="card section-card">
        <view class="section-head">
          <view class="section-title">做菜步骤</view>
          <view class="count-pill">{{cookingSteps ? cookingSteps.length : 0}} 步</view>
        </view>
        <view class="steps" wx:if="{{cookingSteps && cookingSteps.length}}">
          <block wx:for="{{cookingSteps}}" wx:key="index">
            <view class="step-item">
              <view class="step-num">{{index+1}}</view>
              <view class="step-text">{{item}}</view>
            </view>
          </block>
        </view>
        <view class="empty" wx:if="{{!cookingSteps || cookingSteps.length===0}}">暂无做菜步骤</view>
      </view>

      <view class="bottom-spacer" aria-hidden="true"></view>
    </view>
  </scroll-view>

  <canvas type="2d" id="sharePosterCanvas" class="share-poster-hidden" aria-hidden="true"></canvas>

  <view class="ft-bottom-bar" wx:if="{{recipeId}}">
    <view class="ft-btn ft-btn-primary" bindtap="onShareAsImage">分享图片</view>
    <view class="ft-btn ft-btn-danger" bindtap="onAskDeleteRecipe">删除</view>
  </view>

  <ft-modal
    visible="{{confirmModal.visible}}"
    kicker="{{confirmModal.kicker}}"
    title="{{confirmModal.title}}"
    content="{{confirmModal.content}}"
    confirm-text="{{confirmModal.confirmText}}"
    danger="{{confirmModal.danger}}"
    bind:confirm="onConfirmModalOk"
    bind:cancel="onConfirmModalCancel"
  />
</view>

