.page{
  padding: 20rpx;
}
.p-card{
  padding: 22rpx;
}
.hero{
  margin-bottom: 16rpx;
}
.img{
  width: 100%;
  height: 320rpx;
  border-radius: var(--ft-r-xl);
  background: var(--ft-surface-container-high);
}
.name{
  font-size: 40rpx;
  margin-top: 16rpx;
}
.section-title{
  font-size: 28rpx;
  margin-bottom: 12rpx;
}
.section{
  margin-bottom: 16rpx;
}
.order-btn{
  margin-top: 10rpx;
}

.line{
  font-size: 26rpx;
  padding: 14rpx 16rpx;
  border-radius: var(--ft-r-lg);
  background: var(--ft-surface-container-lowest);
  margin-bottom: 10rpx;
}
.empty{
  padding: 22rpx 0;
  text-align: center;
  color: rgba(0,0,0,0.35);
}

