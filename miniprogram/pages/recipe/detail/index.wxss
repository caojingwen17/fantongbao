.page{
  padding: 20rpx;
}
.img{
  width: 100%;
  height: 320rpx;
  border-radius: 16rpx;
  background: rgba(0,0,0,0.03);
}
.name{
  font-size: 40rpx;
  font-weight: 700;
  margin-top: 18rpx;
}
.section-title{
  margin-top: 22rpx;
  font-size: 26rpx;
  color: rgba(0,0,0,0.4);
}
.section{
  margin-top: 12rpx;
  font-size: 26rpx;
  line-height: 1.5;
  color: rgba(0,0,0,0.6);
}
.order-btn{
  margin-top: 24rpx;
}

.line{
  font-size: 26rpx;
  padding: 10rpx 0;
  border-bottom: 1px solid rgba(0,0,0,0.06);
}
.empty{
  padding: 22rpx 0;
  text-align: center;
  color: rgba(0,0,0,0.35);
}

