.recipe-detail-page {
  min-height: 100vh;
  position: relative;
  overflow: hidden;
}

.blob {
  position: absolute;
  border-radius: 9999rpx;
  pointer-events: none;
  filter: blur(60rpx);
}
.blob-a {
  width: 520rpx;
  height: 520rpx;
  right: -200rpx;
  top: -220rpx;
  background: var(--ft-secondary-fixed, #f9e534);
  opacity: 0.18;
}
.blob-b {
  width: 520rpx;
  height: 520rpx;
  left: -240rpx;
  top: 480rpx;
  background: var(--ft-tertiary-fixed, #91f78e);
  opacity: 0.12;
}

/* topbar: keep unified height rule */
.topbar {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  z-index: 50;
  padding: 70rpx 40rpx 0rpx;
  padding-top: calc(80rpx + constant(safe-area-inset-top));
  padding-top: calc(80rpx + env(safe-area-inset-top));
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: rgba(255, 247, 237, 0.82);
  backdrop-filter: blur(12rpx);
}
.top-left {
  display: flex;
  align-items: center;
  gap: 18rpx;
  min-width: 0;
}
.icon-btn {
  width: 80rpx;
  height: 80rpx;
  border-radius: 9999rpx;
  background: var(--ft-surface-container-lowest);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--ft-on-surface-variant);
}
.icon-btn:active { transform: scale(0.90); }
.ico { font-size: 42rpx; font-weight: 900; line-height: 1; transform: translateY(-2rpx); }
.top-title { font-size: 32rpx; font-weight: 900; letter-spacing: -0.5rpx; }
.top-spacer { width: 80rpx; height: 80rpx; }

.main {
  position: relative;
  z-index: 1;
  height: 100vh;
  padding-top: calc(246rpx + constant(safe-area-inset-top));
  padding-top: calc(246rpx + env(safe-area-inset-top));
}
.main::-webkit-scrollbar { display: none; }
.main-inner {
  padding: 0 40rpx 0;
  padding-bottom: calc(200rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(200rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  gap: 20rpx; /* space-y-5 */
}

.recipe-detail-footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 55;
  padding: 12rpx 40rpx 20rpx;
  padding-bottom: calc(20rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(255, 245, 236, 0.88);
  backdrop-filter: blur(14rpx);
  border-top: 2rpx solid var(--ft-surface-container);
}
.recipe-del-btn {
  height: 88rpx;
  border-radius: 9999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 900;
  background: var(--ft-error-container, #fce8e8);
  color: var(--ft-on-error-container, #b00020);
}
.recipe-del-btn:active {
  opacity: 0.92;
  transform: scale(0.98);
}

.card { background: var(--ft-surface-container-lowest); border-radius: 64rpx; }

.hero-card { overflow: hidden; }
.hero-media {
  position: relative;
  width: 100%;
  height: 0;
  padding-bottom: 62.5%; /* 16/10 */
  background: var(--ft-surface-container);
}
.hero-img { position: absolute; left: 0; top: 0; width: 100%; height: 100%; }
.hero-grad {
  position: absolute;
  inset: 0;
  background: linear-gradient(to top, rgba(0,0,0,0.45), rgba(0,0,0,0));
}
.hero-edit-btn {
  position: absolute;
  right: 24rpx;
  bottom: 24rpx;
  z-index: 2;
  height: 72rpx;
  padding: 0 24rpx;
  border-radius: 9999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 900;
  color: #fff;
  background: rgba(0, 0, 0, 0.35);
  backdrop-filter: blur(8rpx);
}
.hero-edit-btn:active { transform: scale(0.95); }
.hero-bottom {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  bottom: 24rpx;
}
.hero-kicker {
  font-size: 18rpx;
  font-weight: 900;
  letter-spacing: 1.6rpx;
  color: rgba(255,255,255,0.82);
}
.hero-title {
  margin-top: 8rpx;
  font-size: 44rpx;
  font-weight: 900;
  color: #fff;
  letter-spacing: -0.5rpx;
}

.section-card { padding: 40rpx; display: flex; flex-direction: column; gap: 18rpx; }
.section-head { display: flex; align-items: center; justify-content: space-between; }
.section-title { font-size: 32rpx; font-weight: 900; letter-spacing: -0.5rpx; }
.count-pill {
  font-size: 22rpx;
  font-weight: 900;
  color: var(--ft-primary);
  background: var(--ft-surface-container-high);
  padding: 10rpx 20rpx;
  border-radius: 9999rpx;
}

.list { display: flex; flex-direction: column; gap: 14rpx; }
.row {
  background: var(--ft-surface-container);
  border-radius: 64rpx;
  padding: 24rpx 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}
.row-name { font-weight: 900; color: var(--ft-on-surface); }
.row-amt { font-size: 26rpx; font-weight: 900; color: var(--ft-on-surface-variant); }

.steps { display: flex; flex-direction: column; gap: 14rpx; }
.step-item {
  background: var(--ft-surface-container);
  border-radius: 64rpx;
  padding: 24rpx 28rpx;
  display: flex;
  gap: 18rpx;
}
.step-num {
  width: 56rpx;
  height: 56rpx;
  border-radius: 9999rpx;
  background: #f9e534;
  color: #5b5300;
  font-weight: 900;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 56rpx;
  margin-top: 2rpx;
}
.step-text {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--ft-on-surface);
  line-height: 1.5;
  flex: 1 1 auto;
  min-width: 0;
}

.empty {
  padding: 28rpx 0;
  text-align: center;
  font-size: 26rpx;
  font-weight: 700;
  color: rgba(118, 85, 36, 0.75);
}

.bottom-spacer { height: 20rpx; }

