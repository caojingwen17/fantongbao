.share-page {
  min-height: 100vh;
  padding: 32rpx;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
  background: #fff7ed;
  box-sizing: border-box;
}

.share-loading,
.share-error {
  padding: 120rpx 32rpx;
  text-align: center;
  font-size: 28rpx;
  color: #78716c;
}

.share-error-text {
  display: block;
  margin-bottom: 40rpx;
  color: #b45309;
  font-weight: 700;
}

.card {
  background: #fff;
  border-radius: 28rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(120, 53, 15, 0.06);
}

.preview-img {
  width: 100%;
  height: 0;
  padding-bottom: 75%; /* 4:3，与裁切一致 */
  border-radius: 20rpx;
  background: #fde68a;
  display: block;
  box-sizing: border-box;
}

.preview-img.ph {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #92400e;
  font-weight: 700;
}

.preview-name {
  margin-top: 24rpx;
  font-size: 36rpx;
  font-weight: 900;
  color: #1c1917;
}

.preview-hint {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #a8a29e;
  font-weight: 600;
  line-height: 1.45;
}

.fold-card {
  padding: 0;
  overflow: hidden;
}

.fold-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx;
  gap: 16rpx;
}

.fold-head-hover {
  background: rgba(254, 243, 199, 0.45);
}

.fold-head-main {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  gap: 12rpx 20rpx;
  flex: 1;
  min-width: 0;
}

.fold-title {
  font-size: 30rpx;
  font-weight: 900;
  color: #44403c;
}

.fold-meta {
  font-size: 24rpx;
  font-weight: 700;
  color: #a8a29e;
}

.fold-chev {
  flex-shrink: 0;
  transform: rotate(-90deg);
  transition: transform 0.2s ease;
}

.fold-head.open .fold-chev {
  transform: rotate(0deg);
}

.fold-body {
  padding: 0 28rpx 28rpx;
  border-top: 2rpx solid rgba(120, 53, 15, 0.06);
}

.fold-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
  padding: 16rpx 0;
  border-bottom: 2rpx solid rgba(120, 53, 15, 0.06);
  font-size: 28rpx;
}

.fold-row-name {
  flex: 1;
  min-width: 0;
  color: #1c1917;
  font-weight: 600;
  line-height: 1.5;
}

.fold-row-amt {
  flex-shrink: 0;
  color: #78716c;
  font-weight: 600;
  max-width: 45%;
  text-align: right;
  line-height: 1.5;
}

.fold-subtitle {
  margin-top: 20rpx;
  margin-bottom: 8rpx;
  font-size: 26rpx;
  font-weight: 800;
  color: #78716c;
}

.fold-step {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 18rpx 0;
  border-bottom: 2rpx solid rgba(120, 53, 15, 0.06);
}

.fold-step-num {
  flex-shrink: 0;
  width: 40rpx;
  height: 40rpx;
  border-radius: 12rpx;
  background: #f9e534;
  color: #422006;
  font-size: 22rpx;
  font-weight: 900;
  text-align: center;
  line-height: 40rpx;
}

.fold-step-txt {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: #292524;
  font-weight: 600;
  line-height: 1.55;
}

.fold-empty {
  padding: 20rpx 0 8rpx;
  font-size: 26rpx;
  color: #a8a29e;
  font-weight: 600;
}

.family-title {
  font-size: 30rpx;
  font-weight: 900;
  color: #44403c;
  margin-bottom: 20rpx;
}

.hint {
  font-size: 26rpx;
  color: #78716c;
  display: block;
  margin-bottom: 28rpx;
}

.family-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 28rpx;
  background: #fff7ed;
  border-radius: 20rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #1c1917;
}

.actions {
  margin-top: 8rpx;
}
