.note-page {
  height: 100vh;
  position: relative;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}
.main {
  position: relative;
  z-index: 1;
  flex: 1;
  height: auto;
}
.main-inner {
  padding: 20rpx;
}
.dish{
  display: flex;
  gap: 18rpx;
  align-items: center;
  border-radius: var(--ft-r-xl);
  padding: 18rpx;
  margin-bottom: 16rpx;
}
.img{
  width: 140rpx;
  height: 110rpx;
  border-radius: var(--ft-r-lg);
  background: var(--ft-surface-container-high);
}
.dish-meta{
  flex: 1;
}
.dish-name{
  font-size: 34rpx;
  word-break: break-all;
}
.dish-sub{
  margin-top: 8rpx;
  font-size: 24rpx;
}
.section-title{
  font-size: 28rpx;
  margin-bottom: 14rpx;
}
.textarea{
  width: 100%;
  min-height: 220rpx;
}
.btn{
  margin-top: 16rpx;
}
.section{
  border-radius: var(--ft-r-xl);
  padding: 18rpx;
}

