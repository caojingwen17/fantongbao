.invite-page {
  min-height: 100vh;
  padding: 80rpx 48rpx calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: var(--ft-surface, #fff7ed);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.invite-loading,
.invite-main,
.invite-error {
  width: 100%;
  max-width: 640rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  gap: 20rpx;
}

.invite-spinner {
  width: 56rpx;
  height: 56rpx;
  border: 4rpx solid rgba(0, 0, 0, 0.08);
  border-top-color: #07c160;
  border-radius: 50%;
  animation: invite-spin 0.8s linear infinite;
}

@keyframes invite-spin {
  to {
    transform: rotate(360deg);
  }
}

.invite-icon {
  width: 120rpx;
  height: 120rpx;
  border-radius: 9999rpx;
  background: #f9e534;
  color: #5b5300;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  font-weight: 900;
}

.invite-kicker {
  font-size: 22rpx;
  font-weight: 900;
  letter-spacing: 2rpx;
  color: rgba(0, 0, 0, 0.45);
  text-transform: uppercase;
}

.invite-title {
  font-size: 44rpx;
  font-weight: 900;
  line-height: 1.35;
  color: rgba(0, 0, 0, 0.88);
}

.invite-sub {
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.55;
  color: rgba(0, 0, 0, 0.55);
  margin-bottom: 12rpx;
}

.invite-error-title {
  font-size: 40rpx;
  font-weight: 900;
}

.invite-error-text {
  font-size: 28rpx;
  color: rgba(0, 0, 0, 0.55);
  line-height: 1.5;
}

.invite-btn {
  width: 100%;
  height: 96rpx;
  margin-top: 8rpx;
  border-radius: 9999rpx;
  background: linear-gradient(135deg, #874e00 0%, #ff9800 100%);
  color: #fff;
  font-size: 30rpx;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
}

.invite-btn.secondary {
  background: rgba(0, 0, 0, 0.06);
  color: rgba(0, 0, 0, 0.72);
}

.invite-btn:active {
  opacity: 0.88;
  transform: scale(0.98);
}
