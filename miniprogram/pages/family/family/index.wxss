.page-boot{
  min-height: 60vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  padding: 60rpx 30rpx;
}
.boot-spinner{
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid rgba(0,0,0,0.08);
  border-top-color: #07C160;
  border-radius: 50%;
  animation: boot-spin 0.8s linear infinite;
}
@keyframes boot-spin{
  to { transform: rotate(360deg); }
}
.boot-text{
  font-size: 28rpx;
  color: rgba(0,0,0,0.45);
}
.members-loading{
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  padding: 32rpx 0;
  font-size: 26rpx;
  color: rgba(0,0,0,0.45);
}
.members-loading-dot{
  width: 28rpx;
  height: 28rpx;
  border: 3rpx solid rgba(0,0,0,0.08);
  border-top-color: #07C160;
  border-radius: 50%;
  animation: boot-spin 0.75s linear infinite;
}

.page{
  padding: 0;
}
.content{
  padding: 24rpx;
  box-sizing: border-box;
}
.p-card{
  padding: 22rpx;
}
.title{
  font-size: 40rpx;
  margin-bottom: 18rpx;
}
.family-list{
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin-bottom: 18rpx;
}
.family-card{
  padding: 18rpx;
  border-radius: var(--ft-r-xl);
}
.family-top{
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}
.family-name{
  font-size: 34rpx;
}
.family-sub{
  margin-top: 10rpx;
  font-size: 26rpx;
}
.family-current{
  font-size: 22rpx;
}

.detail-title-only{
  font-size: 40rpx;
  margin: 6rpx 0 14rpx;
}

.card{
  margin-bottom: 16rpx;
}
.recipes-head{
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}
.recipes-loading{
  padding: 16rpx 0 6rpx;
}
.recipe-grid{
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 12rpx;
}
.recipe-card{
  width: calc(50% - 7rpx);
  border-radius: var(--ft-r-xl);
  padding: 14rpx;
  box-sizing: border-box;
}
.recipe-img{
  width: 100%;
  height: 180rpx;
  border-radius: var(--ft-r-lg);
  background: var(--ft-surface-container-high);
}
.recipe-name{
  margin-top: 12rpx;
  font-size: 26rpx;
  line-height: 1.2;
  word-break: break-all;
}
.mt{
  margin-top: 22rpx;
}

.bottom-actions{
  position: sticky;
  bottom: 0;
  padding: 18rpx 0 10rpx;
  display: flex;
  gap: 14rpx;
  background: linear-gradient(180deg, rgba(255,245,236,0) 0%, rgba(255,245,236,0.9) 35%, rgba(255,245,236,1) 100%);
}
.actionBtn{
  flex: 1;
  height: 84rpx;
}

.dialog-mask{
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 980;
  background: rgba(67, 41, 0, 0.22);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 30rpx;
  box-sizing: border-box;
}
.dialog{
  width: 100%;
  max-width: 640rpx;
  border-radius: var(--ft-r-xl);
  padding: 22rpx;
  box-sizing: border-box;
}
.dialog-title{
  font-size: 34rpx;
  margin-bottom: 14rpx;
}
.dialog-input{
  border: 1px solid var(--ft-outline-variant);
  border-radius: var(--ft-r-xl);
  background: var(--ft-surface-container-lowest);
  padding: 16rpx 18rpx;
  margin-bottom: 18rpx;
}
.dialog-actions{
  display: flex;
  gap: 12rpx;
}
.dialogBtn{
  flex: 1;
  height: 76rpx;
}

.section-title{
  font-size: 32rpx;
  margin-bottom: 20rpx;
}
.card{
  border-radius: var(--ft-r-xl);
}
.input{
  border: 1px solid var(--ft-outline-variant);
  border-radius: var(--ft-r-xl);
  background: var(--ft-surface-container-lowest);
  padding: 16rpx 18rpx;
  margin-bottom: 16rpx;
}
.empty{
  padding: 40rpx 0;
  text-align: center;
  color: rgba(0,0,0,0.35);
  margin-bottom: 30rpx;
}
.row{
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.label{
  font-size: 26rpx;
  color: rgba(0,0,0,0.45);
}
.invite{
  flex: 1;
  font-size: 28rpx;
  font-weight: 700;
}
.copy-btn{
  height: 56rpx;
}
.members{
  margin-top: 18rpx;
}
.member-row{
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 14rpx 0;
  border-bottom: 0;
}
.avatar{
  width: 64rpx;
  height: 64rpx;
  border-radius: 32rpx;
  background: rgba(0,0,0,0.03);
}
.member-info{
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
.member-name{
  font-size: 28rpx;
}
.member-role{
  font-size: 22rpx;
}
.members-empty{
  margin-top: 18rpx;
  color: rgba(0,0,0,0.35);
  text-align: center;
}
.exit-btn{
  margin-top: 18rpx;
  width: 100%;
}

