.members-loading{
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  padding: 32rpx 0;
  font-size: 26rpx;
  color: var(--ft-on-surface-variant);
}
.members-loading-dot{
  width: 28rpx;
  height: 28rpx;
  border: 3rpx solid rgba(135, 78, 0, 0.12);
  border-top-color: var(--ft-primary);
  border-radius: 50%;
  animation: boot-spin 0.75s linear infinite;
}
@keyframes boot-spin{
  to { transform: rotate(360deg); }
}

.family-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  position: relative;
  overflow: hidden;
}
.blob {
  position: absolute;
  border-radius: 9999rpx;
  pointer-events: none;
  filter: blur(60rpx);
}
.blob-a {
  width: 520rpx;
  height: 520rpx;
  right: -200rpx;
  top: -220rpx;
  background: #f9e534;
  opacity: 0.2;
}
.blob-b {
  width: 520rpx;
  height: 520rpx;
  left: -240rpx;
  top: 220rpx;
  background: #91f78e;
  opacity: 0.12;
}

.main {
  position: relative;
  z-index: 1;
  flex: 1;
  min-height: 0;
}
.main-inner {
  padding: 20rpx 40rpx calc(160rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.list-mode,
.detail-mode {
  display: flex;
  flex-direction: column;
  gap: 36rpx;
}

.intro-card,
.detail-head-card,
.panel,
.family-card {
  background: var(--ft-surface-container-lowest);
  border-radius: 48rpx;
}

.intro-card,
.detail-head-card {
  background: var(--ft-surface-container);
}

.intro-card,
.detail-head-card {
  padding: 34rpx;
}

.intro-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 14rpx;
}
.intro-kicker {
  font-size: 24rpx;
  font-weight: 900;
  line-height: 1.35;
  letter-spacing: 2rpx;
  color: var(--ft-on-surface-variant);
  text-transform: uppercase;
}
.intro-title {
  margin-top: 8rpx;
  font-size: 48rpx;
  font-weight: 900;
  line-height: 1.3;
  letter-spacing: -0.5rpx;
}
.intro-sub {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: var(--ft-on-surface-variant);
  font-weight: 700;
  line-height: 1.45;
}
.intro-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 9999rpx;
  background: #f9e534;
  display: flex;
  align-items: center;
  justify-content: center;
}

.family-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.family-card {
  padding: 34rpx;
}
.family-row { display: flex; align-items: flex-start; justify-content: space-between; gap: 10rpx; }
.family-left { flex: 1; min-width: 0; }
.family-line1 { display:flex; align-items:center; gap: 8rpx; }
.family-name { font-size: 40rpx; font-weight: 900; line-height: 1.3; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.family-current {
  padding: 6rpx 14rpx;
  border-radius: 9999rpx;
  font-size: 16rpx;
  font-weight: 900;
  background: #f9e534;
  color: #5b5300;
}
.family-sub {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--ft-on-surface-variant);
  font-weight: 700;
  line-height: 1.45;
}
.family-right {
  margin-top: 2rpx;
  font-size: 20rpx;
  color: var(--ft-outline);
  font-weight: 900;
  line-height: 1;
}
.family-right.current {
  color: #16a34a;
}

.empty-card {
  padding: 38rpx 24rpx;
  text-align: center;
}
.empty-ico {
  margin: 0 auto;
  width: 96rpx;
  height: 96rpx;
  border-radius: 9999rpx;
  background: var(--ft-surface-container);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: var(--ft-outline);
}
.empty-title {
  margin-top: 16rpx;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1.35;
}
.empty-sub {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--ft-on-surface-variant);
  font-weight: 700;
  line-height: 1.45;
}

.panel {
  padding: 34rpx;
}
.panel-head { display: flex; align-items: center; justify-content: space-between; }
.member-panel-head {
  width: 100%;
  gap: 12rpx;
}
.member-panel-head .panel-title {
  flex: 1;
  min-width: 0;
}
.member-invite-wrap {
  position: relative;
  flex-shrink: 0;
  margin-left: auto;
  display: inline-flex;
}
.member-invite-label {
  padding: 8rpx 20rpx;
  border-radius: 9999rpx;
  background: #f9e534;
  color: #5b5300;
  font-size: 26rpx;
  font-weight: 900;
  line-height: 1.2;
  white-space: nowrap;
}
.member-invite-hit {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  margin: 0;
  padding: 0;
  opacity: 0;
  min-width: 0;
  border: none;
  background: transparent;
}
.member-invite-hit::after {
  display: none;
}
.panel-title { font-size: 38rpx; font-weight: 900; line-height: 1.3; }
.panel-badge {
  font-size: 20rpx;
  font-weight: 900;
  color: var(--ft-primary);
  padding: 8rpx 14rpx;
  border-radius: 9999rpx;
  background: var(--ft-surface-container-high);
}

.member-scroll {
  margin-top: 16rpx;
  display: flex;
  gap: 14rpx;
  overflow-x: auto;
  padding-bottom: 2rpx;
}
.member-admin-hint {
  margin-top: 12rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: var(--ft-on-surface-variant);
  line-height: 1.45;
}
.member-chip {
  min-width: 144rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}
.member-avatar-wrap {
  position: relative;
  width: 120rpx;
  height: 120rpx;
  flex-shrink: 0;
}
.member-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 9999rpx;
  border: 6rpx solid var(--ft-surface-container);
  background: var(--ft-surface-container);
  box-sizing: border-box;
}
.member-avatar-placeholder {
  box-sizing: border-box;
  background: var(--ft-surface-container-high);
}
.member-name { font-size: 24rpx; font-weight: 900; text-align: center; line-height: 1.35; }
.member-role { font-size: 20rpx; font-weight: 700; color: var(--ft-on-surface-variant); text-align: center; line-height: 1.4; }
.members-empty { margin-top: 14rpx; text-align: center; color: var(--ft-on-surface-variant); font-size: 22rpx; line-height: 1.45; }

.recipe-grid {
  margin-top: 16rpx;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 8rpx;
}
.recipe-thumb {
  aspect-ratio: 1;
  border-radius: 12rpx;
  overflow: hidden;
  background: var(--ft-surface-container);
}
.recipe-img { width: 100%; height: 100%; }
.recipe-thumb.more {
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--ft-outline);
  font-size: 40rpx;
  font-weight: 900;
}
.recipes-loading { margin-top: 14rpx; color: var(--ft-on-surface-variant); line-height: 1.45; }

.invite-row {
  margin-top: 16rpx;
  background: var(--ft-surface-container);
  border-radius: 16rpx;
  padding: 18rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10rpx;
}
.invite-kicker { font-size: 20rpx; font-weight: 900; color: var(--ft-on-surface-variant); letter-spacing: 1.4rpx; text-transform: uppercase; line-height: 1.35; }
.invite-code { margin-top: 8rpx; font-size: 40rpx; font-weight: 900; letter-spacing: -0.4rpx; line-height: 1.3; }
.copy-btn {
  padding: 14rpx 24rpx;
  border-radius: 9999rpx;
  background: var(--ft-surface-container-lowest);
  color: var(--ft-primary);
  font-size: 24rpx;
  font-weight: 900;
  line-height: 1.3;
}
.exit-btn {
  margin-top: 16rpx;
  height: 96rpx;
  border-radius: 9999rpx;
  background: var(--ft-error-container);
  color: var(--ft-on-error-container);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1.3;
}

.meal-cal-panel { padding: 34rpx; }
.meal-cal-head { align-items: flex-start; flex-wrap: wrap; gap: 16rpx; }
.meal-cal-nav {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-left: auto;
}
.meal-cal-month {
  font-size: 26rpx;
  font-weight: 900;
  color: var(--ft-on-surface-variant);
  min-width: 168rpx;
  text-align: center;
  letter-spacing: 0.5rpx;
}
.meal-cal-nav-btn {
  width: 80rpx;
  height: 80rpx;
  border-radius: var(--ft-r-full);
  background: var(--ft-surface-container-lowest);
  border: 1rpx solid var(--ft-outline-variant);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 900;
  color: var(--ft-primary);
  line-height: 1;
  box-sizing: border-box;
}
.meal-cal-nav-btn:active { opacity: 0.82; transform: scale(0.96); }
.meal-cal-weekdays {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 8rpx;
  margin-top: 22rpx;
  padding: 0 2rpx;
}
.meal-cal-weekdays text {
  font-size: 20rpx;
  font-weight: 800;
  color: rgba(118, 85, 36, 0.55);
  text-align: center;
  letter-spacing: 1rpx;
}
.meal-cal-loading {
  margin-top: 24rpx;
  font-size: 26rpx;
  color: rgba(0, 0, 0, 0.45);
  text-align: center;
  padding: 24rpx 0;
}
/* 日历主体：白底细线框，与 Apricot 卡片体系统一 */
.meal-cal-frame {
  margin-top: 14rpx;
  padding: 16rpx 12rpx 18rpx;
  border-radius: var(--ft-r-xl);
  background: var(--ft-surface-container-lowest);
  border: 1rpx solid var(--ft-outline-variant);
  box-shadow: 0 4rpx 20rpx rgba(67, 41, 0, 0.05);
  box-sizing: border-box;
}
.meal-cal-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 8rpx;
}
.meal-cal-cell.is-pad {
  min-height: 0;
  background: transparent;
}
.meal-cal-cell.is-day {
  aspect-ratio: 1;
  min-width: 0;
  min-height: 0;
}
.meal-cal-day-inner {
  width: 100%;
  height: 100%;
  border-radius: var(--ft-r);
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: stretch;
  padding: 10rpx 8rpx 8rpx;
}
.meal-cal-day-inner.is-empty {
  background: rgba(255, 255, 255, 0.72);
  border: 1rpx solid rgba(208, 166, 109, 0.22);
}
.meal-cal-day-inner.has-orders {
  background: linear-gradient(165deg, rgba(255, 255, 255, 0.98) 0%, rgba(255, 244, 230, 0.92) 100%);
  border: 1rpx solid rgba(135, 78, 0, 0.14);
  box-shadow: 0 2rpx 8rpx rgba(67, 41, 0, 0.06);
}
.meal-cal-day-inner.has-orders:active {
  opacity: 0.92;
  transform: scale(0.98);
}
.meal-cal-daynum {
  font-size: 24rpx;
  font-weight: 900;
  color: rgba(118, 85, 36, 0.72);
  line-height: 1.2;
  align-self: flex-start;
}
.meal-cal-day-inner.has-orders .meal-cal-daynum {
  color: var(--ft-on-surface);
}
.meal-cal-day-inner.is-empty .meal-cal-daynum {
  color: rgba(118, 85, 36, 0.38);
}
.meal-cal-day-spacer {
  flex: 1;
  min-height: 4rpx;
}
/* 与年月同系但更轻：小胶囊数字，替代 ①② 字符 */
.meal-cal-expense-pill {
  align-self: center;
  max-width: 100%;
  min-width: 0;
  height: 34rpx;
  padding: 0 8rpx;
  border-radius: var(--ft-r-full);
  font-size: 18rpx;
  font-weight: 900;
  line-height: 34rpx;
  text-align: center;
  color: var(--ft-primary);
  background: rgba(255, 152, 0, 0.14);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  box-sizing: border-box;
}
.meal-cal-expense-pill.is-zero {
  color: rgba(118, 85, 36, 0.55);
  background: rgba(0, 0, 0, 0.05);
}
.meal-cal-month-total {
  margin-top: 20rpx;
  padding: 22rpx 24rpx;
  border-radius: var(--ft-r-xl);
  background: rgba(255, 152, 0, 0.08);
  border: 1rpx solid rgba(135, 78, 0, 0.1);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
.meal-cal-month-total-k {
  font-size: 26rpx;
  font-weight: 800;
  color: rgba(118, 85, 36, 0.72);
}
.meal-cal-month-total-v {
  font-size: 34rpx;
  font-weight: 900;
  color: var(--ft-primary);
}

.meal-cal-modal-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 990;
  background: rgba(40, 28, 12, 0.38);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 28rpx;
  box-sizing: border-box;
}
.meal-cal-modal-sheet {
  width: 100%;
  max-width: 640rpx;
  max-height: 80vh;
  border-radius: 44rpx;
  overflow: hidden;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  background: linear-gradient(165deg, #fff9ee 0%, #fffdf8 28%, #ffffff 55%);
  box-shadow: 0 24rpx 64rpx rgba(120, 72, 0, 0.18), 0 0 0 1rpx rgba(255, 200, 120, 0.35);
}
.meal-cal-modal-hero {
  padding: 32rpx 32rpx 20rpx;
  background: linear-gradient(135deg, rgba(249, 229, 52, 0.35) 0%, rgba(145, 247, 142, 0.2) 100%);
  border-bottom: 1rpx solid rgba(135, 78, 0, 0.08);
}
.meal-cal-modal-kicker {
  font-size: 22rpx;
  font-weight: 900;
  letter-spacing: 3rpx;
  color: rgba(91, 83, 0, 0.75);
  text-transform: uppercase;
}
.meal-cal-modal-title {
  margin-top: 10rpx;
  font-size: 36rpx;
  font-weight: 900;
  line-height: 1.3;
  color: #3d2a0a;
}
.meal-cal-modal-scroll {
  max-height: 52vh;
  flex: 1;
  min-height: 0;
  padding: 20rpx 24rpx 8rpx;
  box-sizing: border-box;
}
.meal-cal-modal-card {
  padding: 24rpx 22rpx 22rpx;
  border-radius: 28rpx;
  margin-bottom: 18rpx;
  position: relative;
  overflow: hidden;
}
.meal-cal-modal-card--0 {
  background: linear-gradient(145deg, #fff8f0 0%, #fff 60%);
  box-shadow: 0 8rpx 24rpx rgba(255, 152, 0, 0.12);
  border: 1rpx solid rgba(255, 180, 100, 0.45);
}
.meal-cal-modal-card--1 {
  background: linear-gradient(145deg, #f4fff4 0%, #fff 60%);
  box-shadow: 0 8rpx 24rpx rgba(46, 160, 67, 0.1);
  border: 1rpx solid rgba(120, 200, 130, 0.45);
}
.meal-cal-modal-card-head {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  margin-bottom: 18rpx;
}
.meal-cal-modal-accent {
  width: 8rpx;
  min-height: 36rpx;
  border-radius: 9999rpx;
  margin-top: 6rpx;
  flex-shrink: 0;
}
.meal-cal-modal-card--0 .meal-cal-modal-accent {
  background: linear-gradient(180deg, #ff9800, #ffb74d);
}
.meal-cal-modal-card--1 .meal-cal-modal-accent {
  background: linear-gradient(180deg, #43a047, #91f78e);
}
.meal-cal-modal-head-main {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}
.meal-cal-modal-order-name {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1.4;
  color: #2c1f08;
}
.meal-cal-modal-order-expense {
  flex-shrink: 0;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1.4;
  color: var(--ft-primary);
  white-space: nowrap;
}
.meal-cal-modal-order-expense.is-zero {
  color: rgba(118, 85, 36, 0.55);
}
.meal-cal-modal-section {
  margin-bottom: 16rpx;
}
.meal-cal-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}
.meal-cal-tag {
  padding: 8rpx 16rpx;
  border-radius: 9999rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: #5d4a1a;
  background: rgba(255, 193, 7, 0.2);
  border: 1rpx solid rgba(255, 167, 38, 0.35);
}
.meal-cal-modal-card--1 .meal-cal-tag {
  background: rgba(76, 175, 80, 0.14);
  border-color: rgba(76, 175, 80, 0.35);
  color: #2e4a30;
}
.meal-cal-modal-muted {
  font-size: 24rpx;
  font-weight: 700;
  color: rgba(0, 0, 0, 0.38);
}
.meal-cal-modal-stats {
  display: flex;
  gap: 16rpx;
}
.meal-cal-stat {
  flex: 1;
  min-width: 0;
  padding: 16rpx 18rpx;
  border-radius: 20rpx;
}
.meal-cal-stat--time {
  background: linear-gradient(135deg, rgba(255, 183, 77, 0.22), rgba(255, 241, 220, 0.9));
}
.meal-cal-stat--range {
  background: linear-gradient(135deg, rgba(129, 199, 132, 0.22), rgba(236, 255, 236, 0.85));
}
.meal-cal-stat-k {
  display: block;
  font-size: 20rpx;
  font-weight: 800;
  color: rgba(60, 42, 10, 0.5);
  margin-bottom: 6rpx;
}
.meal-cal-stat-v {
  display: block;
  font-size: 26rpx;
  font-weight: 900;
  color: #3d2a0a;
  line-height: 1.35;
  word-break: break-all;
}
.meal-cal-modal-footer {
  padding: 16rpx 28rpx calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(255, 250, 240, 0.95);
  border-top: 1rpx solid rgba(135, 78, 0, 0.08);
}
.meal-cal-modal-btn {
  height: 92rpx;
  border-radius: 9999rpx;
  background: linear-gradient(135deg, #874e00 0%, #ff9800 100%);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 900;
  box-shadow: 0 8rpx 20rpx rgba(135, 78, 0, 0.25);
}
.meal-cal-modal-btn:active {
  opacity: 0.92;
}

.dialog-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 980;
  background: rgba(67, 41, 0, 0.22);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 30rpx;
  box-sizing: border-box;
}
.sheet {
  position: fixed;
  left: 50%;
  transform: translateX(-50%);
  bottom: 0;
  width: 100%;
  max-width: 750rpx;
  background: rgba(255,255,255,0.9);
  backdrop-filter: blur(14rpx);
  border-radius: 64rpx 64rpx 0 0;
  box-shadow: 0 -12rpx 24rpx rgba(67, 41, 0, 0.1);
  padding: 24rpx 40rpx calc(30rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}
.sheet-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 12rpx; }
.sheet-kicker { font-size: 18rpx; font-weight: 900; color: var(--ft-on-surface-variant); letter-spacing: 2rpx; text-transform: uppercase; }
.sheet-title { margin-top: 8rpx; font-size: 38rpx; font-weight: 900; letter-spacing: -0.5rpx; }
.sheet-close {
  width: 80rpx;
  height: 80rpx;
  border-radius: 9999rpx;
  background: var(--ft-surface-container);
  color: var(--ft-on-surface-variant);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
}
.sheet-input {
  margin-top: 20rpx;
  height: 112rpx;
  border-radius: 20rpx;
  background: var(--ft-surface-container-lowest);
  padding: 0 24rpx;
  font-size: 28rpx;
}
.sheet-actions { margin-top: 18rpx; display: grid; grid-template-columns: 1fr 1fr; gap: 12rpx; }
.sheet-btn {
  height: 92rpx;
  border-radius: 9999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 900;
}
.sheet-btn.cancel { background: var(--ft-surface-container); color: var(--ft-on-surface); }
.sheet-btn.ok {
  background: linear-gradient(135deg, #874e00 0%, #ff9800 100%);
  color: var(--ft-on-primary);
}

