.page{
  padding: 20rpx;
}
.pending{
  padding: 22rpx;
  border-radius: var(--ft-r-xl);
  background: var(--ft-surface-container-low);
  margin-bottom: 18rpx;
}
.pending-header{
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}
.pending-title{
  font-size: 28rpx;
}
.pending-badge{
  font-size: 22rpx;
}
.pending-sub{
  margin-top: 8rpx;
  font-size: 22rpx;
}
.pending-list{
  margin-top: 12rpx;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}
.pending-row{
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 14rpx 16rpx;
  border-radius: var(--ft-r-lg);
  background: var(--ft-surface-container-lowest);
}
.pending-name{
  flex: 1;
  font-size: 26rpx;
}
.pending-by{
  font-size: 22rpx;
}
.pending-remove{
  height: 56rpx;
  font-size: 22rpx;
  padding: 0 22rpx;
}
.pending-empty{
  margin-top: 12rpx;
  font-size: 24rpx;
  color: rgba(0,0,0,0.35);
}
.search{
  margin-bottom: 18rpx;
}
.search-input{
  width: 100%;
}
.list{
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.card{
  display: flex;
  gap: 16rpx;
  align-items: center;
  padding: 16rpx;
}
.img{
  width: 120rpx;
  height: 90rpx;
  border-radius: var(--ft-r-lg);
}
.meta{
  flex: 1;
}
.name{
  font-size: 30rpx;
}
.btn{
  font-size: 24rpx;
  height: 64rpx;
  padding: 0 22rpx;
  margin-left: 10rpx;
}
.empty{
  padding: 60rpx 0;
  text-align: center;
  color: rgba(0,0,0,0.35);
}

