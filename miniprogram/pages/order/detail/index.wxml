<view class="ft-page order-detail-page">
  <ft-loading id="ft-loading" />
  <view class="blob blob-a"></view>
  <view class="blob blob-b"></view>

  <ft-topbar title="点菜单详情" custom-back bind:back="onBack" />

  <view class="ft-loading-mask" wx:if="{{pageLoading}}">
    <view class="ft-loading-mark"><view class="ft-ico ft-ico-cook"></view></view>
    <view class="ft-loading-dots">
      <view class="ft-loading-dot"></view>
      <view class="ft-loading-dot"></view>
      <view class="ft-loading-dot"></view>
    </view>
    <text class="ft-loading-text">加载点菜单…</text>
  </view>

  <scroll-view scroll-y="true" class="main" wx:else show-scrollbar="false" scrollbar-hidden="true" enhanced="true">
    <view class="main-inner">
      <view class="header-card">
        <view>
          <view class="head-kicker">点菜单名</view>
          <view class="head-name">{{order.orderName || "未命名点菜单"}}</view>
          <view class="head-status">状态：<text class="head-status-text {{statusText==='待点菜' ? 'head-status-muted' : ''}}">{{statusText || order.status || ""}}</text></view>
        </view>
        <view class="head-icon" aria-hidden="true">
          <view class="ft-ico ft-ico-list"></view>
        </view>
      </view>

      <view class="order-empty-cta" wx:if="{{recipeCount===0 && order.status!=='completed'}}">
        <view class="order-empty-cta-hint">还没有点菜</view>
        <view class="order-empty-cta-btns">
          <view class="ft-btn ft-btn-primary order-empty-cta-btn" bindtap="goOrder">点菜</view>
          <view class="ft-btn ft-btn-secondary order-empty-cta-btn" bindtap="onOpenRandom">随机一道</view>
        </view>
      </view>

      <view class="dish-section" wx:if="{{recipeCount > 0}}">
        <view class="dish-head">
          <view class="dish-title">已点菜品</view>
          <view class="dish-head-right">
            <view class="dish-random" wx:if="{{order.status==='pending_shopping' || order.status==='pending_cooking'}}" bindtap="onOpenRandom">随机</view>
            <view class="dish-count">{{recipeCount}} 道</view>
          </view>
        </view>

        <view class="dish-list" wx:if="{{order.recipes && order.recipes.length}}">
          <block wx:for="{{order.recipes || []}}" wx:key="recipeId">
            <view class="dish-card">
              <view class="dish-mid">
                <view class="dish-name">{{item.recipeName || item.recipeId}}</view>
                <view class="dish-owner">点菜人：{{item.creatorNickName || "未知用户"}}</view>
                <view class="dish-note" wx:if="{{item.note}}">备注：{{item.note}}</view>
              </view>
              <view
                class="dish-del ft-tap"
                wx:if="{{order.status==='pending_shopping'}}"
                data-recipeid="{{item.recipeId}}"
                bindtap="onRemoveRecipe"
              >
                <view class="ft-ico ft-ico-trash ft-ico-sm"></view>
              </view>
            </view>
          </block>
        </view>
      </view>

      <view class="expense-card" wx:if="{{order.status==='pending_cooking' || order.status==='completed'}}">
        <view class="expense-card-left">
          <view class="expense-card-kicker">买菜消费</view>
          <view class="expense-card-value" wx:if="{{order.shoppingExpense}}">¥{{order.shoppingExpense}}</view>
          <view class="expense-card-value is-empty" wx:else>未记录</view>
          <view class="expense-card-split" wx:if="{{order.expenseSplitInfo && order.expenseSplitInfo.count > 1}}">
            分摊 · 共 {{order.expenseSplitInfo.count}} 单（合计 ¥{{order.expenseSplitInfo.total}}）
          </view>
        </view>
        <view class="ft-btn ft-btn-sm expense-edit-btn" bindtap="openExpenseDialog">
          {{order.shoppingExpense ? "修改" : "补记金额"}}
        </view>
      </view>

      <view class="invite-order-panel" wx:if="{{canInviteOrder}}">
        <view class="invite-order-hint">邀请好友一起点餐时，对方将默认加入本家庭</view>
        <view class="invite-order-actions">
          <view class="btn btn-invite-order" bindtap="onTapUnlockShareOrder">邀请点餐</view>
        </view>
      </view>

      <view class="share-confirm-mask ft-anim-mask" wx:if="{{shareConfirmVisible}}" catchtap="onCloseShareConfirm">
        <view class="share-confirm-card ft-anim-card" catchtap="">
          <view class="share-confirm-title">邀请点餐</view>
          <view class="share-confirm-text">转发后，好友点击链接将默认加入你的家庭，并进入本点菜单一起点菜。</view>
          <button
            class="btn-share-order"
            open-type="share"
            wx:if="{{shareReady}}"
          >转发到聊天</button>
          <view class="share-confirm-preparing" wx:else>正在准备邀请…</view>
          <view class="share-confirm-cancel" bindtap="onCloseShareConfirm">取消</view>
        </view>
      </view>

      <view class="order-delete-panel" wx:if="{{order && order._id && order.status!=='completed'}}">
        <view class="ft-btn ft-btn-danger" bindtap="onAskDeleteOrder">删除点菜单</view>
      </view>

      <view class="bottom-safe-spacer" aria-hidden="true"></view>
    </view>
  </scroll-view>

  <view class="ft-bottom-bar" wx:if="{{order.status==='completed'}}">
    <view class="ft-btn btn-completed" bindtap="onCompletedToHome">已完成（返回首页）</view>
  </view>
  <view class="ft-bottom-bar" wx:elif="{{recipeCount > 0 && !pageLoading}}">
    <block wx:if="{{order.status==='pending_shopping'}}">
      <view class="ft-btn ft-btn-secondary" bindtap="goContinueAdd">继续加菜</view>
      <view class="ft-btn ft-btn-primary" bindtap="goShopping">去买菜</view>
    </block>
    <block wx:if="{{order.status==='pending_cooking'}}">
      <view class="ft-btn ft-btn-secondary" bindtap="goContinueAdd">继续加菜</view>
      <view class="ft-btn ft-btn-primary" bindtap="goCooking">去做菜</view>
    </block>
  </view>

  <view class="expense-mask ft-anim-mask" wx:if="{{expenseDialogVisible}}" catchtap="closeExpenseDialog">
    <view class="expense-sheet ft-anim-sheet" catchtap="noop">
      <view class="expense-head">
        <view>
          <view class="expense-kicker">买菜消费</view>
          <view class="expense-title">这次买菜花了多少钱？</view>
        </view>
        <view class="expense-close" bindtap="closeExpenseDialog">×</view>
      </view>
      <view class="expense-input-wrap">
        <text class="expense-yen">¥</text>
        <input
          class="expense-input"
          type="digit"
          placeholder="0.00"
          value="{{expenseInput}}"
          bindinput="onExpenseInput"
          focus="{{expenseDialogVisible}}"
        />
      </view>
      <view class="expense-hint">修改后会同步更新家庭干饭日历的消费统计</view>

      <view class="expense-actions">
        <view class="expense-btn skip" bindtap="closeExpenseDialog">取消</view>
        <view class="expense-btn ok" bindtap="onConfirmExpense">确认</view>
      </view>
    </view>
  </view>

  <!-- 随机一道：抽卡弹层 -->
  <view class="random-mask ft-anim-mask" wx:if="{{randomSheetVisible}}" catchtap="onCloseRandom"></view>
  <view class="random-sheet ft-anim-sheet" wx:if="{{randomSheetVisible}}" catchtap="noop">
    <view class="random-head">
      <view>
        <view class="random-kicker">不知道吃什么？</view>
        <view class="random-title">随机来一道</view>
      </view>
      <view class="random-close" bindtap="onCloseRandom">×</view>
    </view>

    <view class="random-card {{randomCardOut ? 'is-out' : (randomAnimFlip ? 'random-in-a' : 'random-in-b')}}" wx:if="{{randomRecipe}}">
      <view class="random-media">
        <ft-cloud-image imgClass="random-img" src="{{randomRecipe.recipeImg}}" />
      </view>
      <view class="random-name">{{randomRecipe.recipeName}}</view>
      <view class="random-meta">{{randomRecipe.ingredientCount}} 种食材 · {{randomRecipe.stepCount}} 个步骤</view>
    </view>
    <view class="random-empty" wx:if="{{!randomRecipe && !randomBusy}}">家庭菜谱都被点完啦</view>

    <view class="random-actions">
      <view class="ft-btn ft-btn-secondary" bindtap="onReroll">换一个</view>
      <view class="ft-btn ft-btn-primary {{(!randomRecipe || randomBusy) ? 'disabled' : ''}}" bindtap="onAddRandom">就它了，加菜</view>
    </view>
  </view>

  <ft-modal
    visible="{{confirmModal.visible}}"
    kicker="{{confirmModal.kicker}}"
    title="{{confirmModal.title}}"
    content="{{confirmModal.content}}"
    confirm-text="{{confirmModal.confirmText}}"
    danger="{{confirmModal.danger}}"
    bind:confirm="onConfirmModalOk"
    bind:cancel="onConfirmModalCancel"
  />
</view>
