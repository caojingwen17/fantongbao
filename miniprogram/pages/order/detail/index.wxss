.page{
  padding: 20rpx;
}
.title{
  font-size: 40rpx;
  font-weight: 800;
}
.sub{
  margin-top: 10rpx;
  font-size: 26rpx;
  color: rgba(0,0,0,0.45);
}
.section-title{
  margin-top: 22rpx;
  font-size: 32rpx;
  margin-bottom: 12rpx;
}
.recipe-row{
  padding: 16rpx;
  border-radius: var(--ft-r-xl);
  margin-bottom: 14rpx;
}
.recipe-row-top{
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
.recipe-name{
  font-size: 30rpx;
}
.recipe-name-wrap{
  flex: 1;
  display: flex;
  flex-direction: column;
}
.creator-text{
  margin-top: 6rpx;
  font-size: 22rpx;
  color: rgba(0,0,0,0.45);
}
.remove-btn{
  height: 56rpx;
  font-size: 22rpx;
  padding: 0 18rpx;
  min-width: 0;
}
.note{
  margin-top: 8rpx;
  font-size: 24rpx;
  color: rgba(0,0,0,0.55);
  word-break: break-all;
}
.btn{
  margin-top: 18rpx;
}

.footer{
  margin-top: 18rpx;
  display: flex;
  gap: 14rpx;
}
.footer-btn{
  flex: 1;
}

