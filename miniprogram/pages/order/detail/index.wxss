.order-detail-page { height: 100vh; position: relative; overflow: hidden; display: flex; flex-direction: column; }
.blob { position: absolute; border-radius: 9999rpx; pointer-events: none; filter: blur(60rpx); }
.blob-a { width: 512rpx; height: 512rpx; right: -192rpx; top: -192rpx; background: #f9e534; opacity: 0.18; }
.blob-b { width: 512rpx; height: 512rpx; left: -192rpx; top: 416rpx; background: #91f78e; opacity: 0.12; }

.main { position: relative; z-index: 1; flex: 1; min-height: 0; }
.main-inner { padding: 20rpx 40rpx calc(160rpx + env(safe-area-inset-bottom)); display: flex; flex-direction: column; gap: 20rpx; }

.header-card {
  background: var(--ft-surface-container-lowest);
  border-radius: 32rpx;
  padding: 40rpx 32rpx;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
}
.head-kicker { font-size: 18rpx; font-weight: 900; letter-spacing: 2rpx; text-transform: uppercase; color: var(--ft-on-surface-variant); }
.head-name { margin-top: 8rpx; font-size: 50rpx; font-weight: 900; letter-spacing: -0.6rpx; max-width: 420rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.head-status { margin-top: 8rpx; font-size: 24rpx; color: var(--ft-on-surface-variant); font-weight: 700; }
.head-status-text { color: var(--ft-primary); font-weight: 900; }
.head-status-muted { color: #5f5f5f; }
.head-icon { width: 96rpx; height: 96rpx; border-radius: 9999rpx; background: var(--ft-surface-container); display: flex; align-items: center; justify-content: center; }

.order-empty-cta {
  margin-top: 8rpx;
  background: var(--ft-surface-container-lowest);
  border-radius: 32rpx;
  padding: 72rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 28rpx;
}
.order-empty-cta-hint {
  font-size: 28rpx;
  font-weight: 800;
  color: var(--ft-on-surface-variant);
}
.order-empty-cta-btn {
  min-width: 360rpx;
}

.dish-section { display: flex; flex-direction: column; gap: 12rpx; }
.dish-head { display: flex; align-items: center; justify-content: space-between; padding: 0 4rpx; }
.dish-title { font-size: 26rpx; font-weight: 900; }
.dish-count { font-size: 20rpx; font-weight: 900; color: var(--ft-primary); padding: 8rpx 16rpx; border-radius: 9999rpx; background: var(--ft-surface-container-high); }
.dish-list { display: flex; flex-direction: column; gap: 12rpx; }
.dish-card { background: var(--ft-surface-container-lowest); border-radius: 32rpx; padding: 28rpx; display: flex; align-items: flex-start; justify-content: space-between; gap: 18rpx; }
.dish-mid { flex: 1; min-width: 0; }
.dish-name { font-size: 36rpx; font-weight: 900; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.dish-owner { margin-top: 8rpx; font-size: 20rpx; font-weight: 700; color: var(--ft-on-surface-variant); }
.dish-note { margin-top: 12rpx; font-size: 20rpx; font-weight: 700; line-height: 1.45; color: var(--ft-on-surface-variant); }
.dish-del { width: 80rpx; height: 80rpx; border-radius: 9999rpx; background: var(--ft-surface-container); color: var(--ft-error); display: flex; align-items: center; justify-content: center; font-size: 30rpx; }
.dish-del:active { transform: scale(0.9); }

.dish-empty { background: var(--ft-surface-container-lowest); border-radius: 32rpx; padding: 64rpx 32rpx; text-align: center; }
.dish-empty-ico { margin: 0 auto; width: 112rpx; height: 112rpx; border-radius: 9999rpx; background: var(--ft-surface-container); color: var(--ft-outline); display: flex; align-items: center; justify-content: center; font-size: 54rpx; font-weight: 700; }
.dish-empty-title { margin-top: 22rpx; font-size: 34rpx; font-weight: 900; }
.dish-empty-sub { margin-top: 8rpx; font-size: 24rpx; color: var(--ft-on-surface-variant); font-weight: 700; }

.btn { height: 96rpx; border-radius: 9999rpx; display: flex; align-items: center; justify-content: center; font-size: 30rpx; font-weight: 900; }
.btn:active { transform: scale(0.95); }
.btn-completed { background: var(--ft-surface-container); color: var(--ft-on-surface); }

.order-delete-panel {
  margin-top: 24rpx;
  padding: 0 4rpx;
}
.invite-order-panel {
  margin-top: 8rpx;
  background: var(--ft-surface-container-lowest);
  border-radius: 32rpx;
  padding: 28rpx 32rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.invite-order-hint {
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.5;
  color: var(--ft-on-surface-variant);
}
.invite-order-actions {
  display: flex;
  justify-content: stretch;
}
.btn-invite-order {
  flex: 1;
  height: 88rpx;
  border-radius: 9999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 900;
  background: #f9e534;
  color: #5b5300;
}
.btn-invite-order:active {
  transform: scale(0.98);
  opacity: 0.9;
}
.btn-share-order {
  flex: 1;
  height: 88rpx;
  margin: 0;
  border-radius: 9999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 900;
  background: linear-gradient(135deg, #874e00 0%, #ff9800 100%);
  color: #fff;
  line-height: 1.2;
}
.btn-share-order::after {
  border: none;
}

.share-confirm-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 1000;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  box-sizing: border-box;
}
.share-confirm-card {
  width: 100%;
  max-width: 620rpx;
  background: #fff;
  border-radius: 32rpx;
  padding: 48rpx 40rpx 36rpx;
  box-sizing: border-box;
}
.share-confirm-title {
  font-size: 34rpx;
  font-weight: 900;
  color: #1a1a1a;
  text-align: center;
  margin-bottom: 24rpx;
}
.share-confirm-text {
  font-size: 28rpx;
  line-height: 1.6;
  color: #666;
  text-align: center;
  margin-bottom: 40rpx;
}
.share-confirm-card .btn-share-order {
  width: 100%;
}
.share-confirm-cancel {
  margin-top: 24rpx;
  text-align: center;
  font-size: 28rpx;
  color: #999;
  padding: 16rpx;
}
.share-confirm-preparing {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #888;
}
.bottom-safe-spacer { height: 20rpx; }

.expense-mask {
  position: fixed;
  inset: 0;
  z-index: 80;
  background: rgba(0, 0, 0, 0.42);
  display: flex;
  align-items: flex-end;
  justify-content: center;
}
.expense-sheet {
  width: 100%;
  padding: 36rpx 40rpx calc(36rpx + env(safe-area-inset-bottom));
  border-radius: 32rpx 32rpx 0 0;
  background: var(--ft-surface-container-lowest);
  box-sizing: border-box;
}
.expense-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}
.expense-kicker {
  font-size: 22rpx;
  font-weight: 800;
  color: rgba(118, 85, 36, 0.55);
  letter-spacing: 1rpx;
}
.expense-title {
  margin-top: 8rpx;
  font-size: 34rpx;
  font-weight: 900;
  color: var(--ft-on-surface);
}
.expense-close {
  width: 56rpx;
  height: 56rpx;
  border-radius: 9999rpx;
  background: rgba(0, 0, 0, 0.06);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  line-height: 1;
  color: rgba(0, 0, 0, 0.45);
}
.expense-input-wrap {
  margin-top: 32rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 24rpx 28rpx;
  border-radius: var(--ft-r-xl);
  background: rgba(255, 152, 0, 0.08);
  border: 1rpx solid rgba(135, 78, 0, 0.12);
}
.expense-yen {
  font-size: 40rpx;
  font-weight: 900;
  color: var(--ft-primary);
}
.expense-input {
  flex: 1;
  font-size: 44rpx;
  font-weight: 900;
  color: var(--ft-on-surface);
  min-height: 56rpx;
}
.expense-hint {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: rgba(0, 0, 0, 0.42);
}
.expense-actions {
  margin-top: 32rpx;
  display: flex;
  gap: 20rpx;
}
.expense-btn {
  flex: 1;
  height: 88rpx;
  border-radius: 9999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 900;
}
.expense-btn.skip {
  background: rgba(0, 0, 0, 0.06);
  color: rgba(0, 0, 0, 0.55);
}
.expense-btn.ok {
  background: linear-gradient(135deg, #874e00 0%, #ff9800 100%);
  color: var(--ft-on-primary);
}

/* 买菜消费卡片 */
.expense-card {
  background: var(--ft-surface-container-lowest);
  border-radius: 32rpx;
  padding: 28rpx 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}
.expense-card-kicker {
  font-size: 20rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
  color: var(--ft-on-surface-variant);
}
.expense-card-value {
  margin-top: 6rpx;
  font-size: 40rpx;
  font-weight: 900;
  color: var(--ft-primary);
}
.expense-card-value.is-empty {
  font-size: 26rpx;
  color: var(--ft-on-surface-variant);
}
.expense-card-split {
  margin-top: 6rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: var(--ft-on-surface-variant);
}
.expense-edit-btn {
  flex-shrink: 0;
}

/* 随机一道 */
.order-empty-cta-btns {
  display: flex;
  gap: 20rpx;
}
.order-empty-cta-btns .order-empty-cta-btn {
  min-width: 260rpx;
}
.dish-head-right {
  display: flex;
  align-items: center;
  gap: 14rpx;
}
.dish-random {
  padding: 8rpx 20rpx;
  border-radius: 9999rpx;
  font-size: 22rpx;
  font-weight: 900;
  color: var(--ft-on-primary);
  background: linear-gradient(135deg, var(--ft-primary) 0%, var(--ft-primary-container) 100%);
}
.dish-random:active {
  transform: scale(0.94);
}

.random-mask {
  position: fixed;
  inset: 0;
  z-index: 300;
  background: rgba(67, 41, 0, 0.35);
}
.random-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 310;
  background: var(--ft-surface-container-lowest);
  border-radius: 48rpx 48rpx 0 0;
  padding: 36rpx 40rpx calc(40rpx + constant(safe-area-inset-bottom));
  padding: 36rpx 40rpx calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}
.random-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}
.random-kicker {
  font-size: 22rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
  color: var(--ft-on-surface-variant);
}
.random-title {
  margin-top: 6rpx;
  font-size: 36rpx;
  font-weight: 900;
  color: var(--ft-on-surface);
}
.random-close {
  width: 56rpx;
  height: 56rpx;
  border-radius: 9999rpx;
  background: var(--ft-surface-container);
  color: var(--ft-on-surface-variant);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  flex-shrink: 0;
}
.random-card {
  margin-top: 28rpx;
  background: var(--ft-surface-container-low);
  border-radius: 36rpx;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.random-media {
  width: 100%;
  height: 0;
  padding-bottom: 56.25%; /* 16:9，卡片内横幅 */
  border-radius: 24rpx;
  overflow: hidden;
  position: relative;
  background: var(--ft-surface-container);
}
.random-img {
  --ft-ci-pos: absolute;
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}
.random-name {
  margin-top: 20rpx;
  font-size: 38rpx;
  font-weight: 900;
  color: var(--ft-on-surface);
  text-align: center;
}
.random-meta {
  margin-top: 8rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: var(--ft-on-surface-variant);
}
.random-empty {
  margin-top: 28rpx;
  padding: 48rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: var(--ft-on-surface-variant);
}
.random-actions {
  margin-top: 28rpx;
  display: flex;
  gap: 20rpx;
}
.random-actions .ft-btn {
  flex: 1;
  height: 96rpx;
}

/* 换一道：当前卡片向左飞出（带旋转淡出） */
.random-card.is-out {
  animation: random-out 0.18s ease-in both;
}
@keyframes random-out {
  to {
    opacity: 0;
    transform: translateX(-140rpx) rotate(-6deg);
  }
}
/* 新卡片从右侧飞入（带回弹，两个关键帧交替触发重播） */
@keyframes random-in-a {
  from {
    opacity: 0;
    transform: translateX(180rpx) rotate(6deg);
  }
  to {
    opacity: 1;
    transform: translateX(0) rotate(0);
  }
}
@keyframes random-in-b {
  from {
    opacity: 0;
    transform: translateX(180rpx) rotate(4deg);
  }
  to {
    opacity: 1;
    transform: translateX(0) rotate(0);
  }
}
.random-in-a { animation: random-in-a 0.28s cubic-bezier(0.34, 1.3, 0.64, 1) both; }
.random-in-b { animation: random-in-b 0.28s cubic-bezier(0.34, 1.3, 0.64, 1) both; }
