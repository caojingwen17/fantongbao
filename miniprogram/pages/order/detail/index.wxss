.order-detail-page { min-height: 100vh; position: relative; overflow: hidden; }
.blob { position: absolute; border-radius: 9999rpx; pointer-events: none; filter: blur(60rpx); }
.blob-a { width: 512rpx; height: 512rpx; right: -192rpx; top: -192rpx; background: #f9e534; opacity: 0.18; }
.blob-b { width: 512rpx; height: 512rpx; left: -192rpx; top: 416rpx; background: #91f78e; opacity: 0.12; }

.topbar {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  z-index: 50;
  padding: 70rpx 40rpx 0rpx;
  padding-top: calc(80rpx + constant(safe-area-inset-top));
  padding-top: calc(80rpx + env(safe-area-inset-top));
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: rgba(255, 247, 237, 0.82);
  backdrop-filter: blur(12rpx);
}
.top-left { display: flex; align-items: center; gap: 16rpx; min-width: 0; }
.icon-btn { width: 80rpx; height: 80rpx; border-radius: 9999rpx; background: var(--ft-surface-container-lowest); display: flex; align-items: center; justify-content: center; color: var(--ft-on-surface-variant); }
.icon-btn:active { transform: scale(0.90); }
.ico { font-size: 42rpx; font-weight: 900; line-height: 1; transform: translateY(-2rpx); }
.top-title { font-size: 34rpx; font-weight: 900; letter-spacing: -0.4rpx; }
.top-spacer { width: 80rpx; height: 80rpx; }

.main { position: relative; z-index: 1; height: 100vh; padding-top: calc(198rpx + constant(safe-area-inset-top)); padding-top: calc(198rpx + env(safe-area-inset-top)); }
.main-inner { padding: 0 40rpx calc(160rpx + env(safe-area-inset-bottom)); display: flex; flex-direction: column; gap: 20rpx; }

.header-card {
  background: var(--ft-surface-container-lowest);
  border-radius: 32rpx;
  padding: 40rpx 32rpx;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
}
.head-kicker { font-size: 18rpx; font-weight: 900; letter-spacing: 2rpx; text-transform: uppercase; color: var(--ft-on-surface-variant); }
.head-name { margin-top: 8rpx; font-size: 50rpx; font-weight: 900; letter-spacing: -0.6rpx; max-width: 420rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.head-status { margin-top: 8rpx; font-size: 24rpx; color: var(--ft-on-surface-variant); font-weight: 700; }
.head-status-text { color: var(--ft-primary); font-weight: 900; }
.head-status-muted { color: #5f5f5f; }
.head-icon { width: 96rpx; height: 96rpx; border-radius: 9999rpx; background: #f9e534; display: flex; align-items: center; justify-content: center; }
.head-icon-glyph { color: #5b5300; font-size: 40rpx; font-weight: 900; }

.order-empty-cta {
  margin-top: 8rpx;
  background: var(--ft-surface-container-lowest);
  border-radius: 32rpx;
  padding: 72rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 28rpx;
}
.order-empty-cta-hint {
  font-size: 28rpx;
  font-weight: 800;
  color: var(--ft-on-surface-variant);
}
.order-empty-cta-btn {
  min-width: 360rpx;
}

.dish-section { display: flex; flex-direction: column; gap: 12rpx; }
.dish-head { display: flex; align-items: center; justify-content: space-between; padding: 0 4rpx; }
.dish-title { font-size: 26rpx; font-weight: 900; }
.dish-count { font-size: 20rpx; font-weight: 900; color: var(--ft-primary); padding: 8rpx 16rpx; border-radius: 9999rpx; background: var(--ft-surface-container-high); }
.dish-list { display: flex; flex-direction: column; gap: 12rpx; }
.dish-card { background: var(--ft-surface-container-lowest); border-radius: 32rpx; padding: 28rpx; display: flex; align-items: flex-start; justify-content: space-between; gap: 18rpx; }
.dish-mid { flex: 1; min-width: 0; }
.dish-name { font-size: 36rpx; font-weight: 900; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.dish-owner { margin-top: 8rpx; font-size: 20rpx; font-weight: 700; color: var(--ft-on-surface-variant); }
.dish-note { margin-top: 12rpx; font-size: 20rpx; font-weight: 700; line-height: 1.45; color: var(--ft-on-surface-variant); }
.dish-del { width: 80rpx; height: 80rpx; border-radius: 9999rpx; background: var(--ft-surface-container); color: var(--ft-error); display: flex; align-items: center; justify-content: center; font-size: 30rpx; }
.dish-del:active { transform: scale(0.9); }

.dish-empty { background: var(--ft-surface-container-lowest); border-radius: 32rpx; padding: 64rpx 32rpx; text-align: center; }
.dish-empty-ico { margin: 0 auto; width: 112rpx; height: 112rpx; border-radius: 9999rpx; background: var(--ft-surface-container); color: var(--ft-outline); display: flex; align-items: center; justify-content: center; font-size: 54rpx; font-weight: 700; }
.dish-empty-title { margin-top: 22rpx; font-size: 34rpx; font-weight: 900; }
.dish-empty-sub { margin-top: 8rpx; font-size: 24rpx; color: var(--ft-on-surface-variant); font-weight: 700; }

.bottom-actions {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 55;
  padding: 12rpx 40rpx 20rpx;
  padding-bottom: calc(20rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(255, 245, 236, 0.88);
  backdrop-filter: blur(14rpx);
  border-top: 2rpx solid var(--ft-surface-container);
}
.actions-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12rpx; }
.actions-single { display: block; }
.btn { height: 96rpx; border-radius: 9999rpx; display: flex; align-items: center; justify-content: center; font-size: 30rpx; font-weight: 900; }
.btn:active { transform: scale(0.95); }
.btn-primary { background: linear-gradient(135deg, #874e00 0%, #ff9800 100%); color: var(--ft-on-primary); box-shadow: 0 12rpx 24rpx rgba(135, 78, 0, 0.16); }
.btn-secondary { background: #f9e534; color: #5b5300; }
.btn-cooking { background: #91f78e; color: #005e17; }
.btn-completed { background: var(--ft-surface-container); color: var(--ft-on-surface); }

.order-delete-panel {
  margin-top: 24rpx;
  padding: 0 4rpx;
}
.btn-delete-order {
  height: 88rpx;
  border-radius: 9999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 900;
  background: var(--ft-error-container, #fce8e8);
  color: var(--ft-on-error-container, #b00020);
}
.btn-delete-order:active { opacity: 0.92; transform: scale(0.98); }

.bottom-safe-spacer { height: 20rpx; }

