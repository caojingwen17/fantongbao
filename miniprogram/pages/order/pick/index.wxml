<view class="ft-page order-pick-page">
  <ft-loading id="ft-loading" />
  <view class="blob blob-a"></view>
  <view class="blob blob-b"></view>

  <ft-topbar title="点菜" custom-back bind:back="onBack" />

  <scroll-view
    scroll-y="true"
    class="main"
    show-scrollbar="false"
    scrollbar-hidden="true"
    enhanced="true"
    refresher-enabled
    refresher-triggered="{{refreshing}}"
    bindrefresherrefresh="onRefresh"
  >
    <view class="main-inner">
      <view class="search-wrap">
        <view class="search-icon ft-ico ft-ico-search ft-ico-sm"></view>
        <input class="search-input" placeholder="搜索菜名" value="{{keyword}}" bindinput="onKeywordInput" />
        <view class="clear-btn" wx:if="{{keyword}}" bindtap="onClearKeyword">×</view>
      </view>

      <view class="count-row">
        <view class="count-text">共 {{viewRecipes.length}} 个菜谱</view>
      </view>

      <view class="recipe-list" wx:if="{{viewRecipes.length}}">
        <block wx:for="{{viewRecipes}}" wx:key="id">
          <view class="recipe-item">
            <view class="recipe-row" bindtap="goRecipeDetail" data-recipeid="{{item.id}}">
              <view class="recipe-media">
                <ft-cloud-image imgClass="recipe-img" src="{{item.recipeImg}}" familyId="{{familyId}}" inviteToken="{{inviteToken}}" />
              </view>
              <view class="recipe-body">
                <view class="recipe-name">{{item.recipeName}}</view>
                <view class="recipe-date">添加于 {{item.createDateText}}</view>
              </view>
              <view
                class="recipe-add {{item.inOrder ? 'recipe-add-on' : ''}}"
                catchtap="onTapAdd"
                data-recipeid="{{item.id}}"
                data-inorder="{{item.inOrder}}"
              >{{item.inOrder ? "−" : "+"}}</view>
            </view>
          </view>
        </block>
      </view>

      <view class="ft-empty" wx:if="{{!viewRecipes.length && !listLoading}}">
        <view class="ft-ico ft-ico-dish ft-ico-lg"></view>
        <view class="ft-empty-title">暂无菜谱</view>
        <view class="ft-empty-sub">请先在家庭里添加常用菜谱</view>
      </view>
    </view>
  </scroll-view>

  <view class="pick-bottom" id="pick-bottom-bar">
    <view class="pick-bottom-inner">
      <view class="pick-count" bindtap="togglePickedSheet">
        <text class="pick-count-n">已点 {{pickedCount}} 道</text>
        <text class="pick-count-chev">›</text>
      </view>
      <view class="pick-submit ft-btn ft-btn-primary" bindtap="onSubmit">提交</view>
    </view>
  </view>

  <view class="picked-mask ft-anim-mask" wx:if="{{pickedSheetVisible}}" catchtap="closePickedSheet"></view>
  <view class="picked-sheet ft-anim-sheet" wx:if="{{pickedSheetVisible}}" catchtap="noop">
    <view class="picked-head">
      <view class="picked-title">已点菜品</view>
      <view class="picked-close" bindtap="closePickedSheet">×</view>
    </view>
    <scroll-view scroll-y="true" class="picked-scroll" show-scrollbar="false">
      <block wx:for="{{pickedRows}}" wx:key="recipeId">
        <view class="picked-row">
          <text class="picked-name">{{item.recipeName || item.recipeId}}</text>
          <view
            class="picked-remove"
            catchtap="onPickedRemove"
            data-recipeid="{{item.recipeId}}"
            aria-label="从已点中移除"
          >−</view>
        </view>
      </block>
      <view class="picked-empty" wx:if="{{!pickedRows || pickedRows.length===0}}">暂无</view>
    </scroll-view>
  </view>

  <view class="ft-loading-mask" wx:if="{{listLoading}}">
    <view class="ft-loading-mark"><view class="ft-ico ft-ico-cook"></view></view>
    <view class="ft-loading-dots">
      <view class="ft-loading-dot"></view>
      <view class="ft-loading-dot"></view>
      <view class="ft-loading-dot"></view>
    </view>
    <text class="ft-loading-text">加载菜谱…</text>
  </view>
</view>
