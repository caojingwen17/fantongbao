<view class="ft-page order-page">
  <view class="blob blob-a"></view>
  <view class="blob blob-b"></view>

  <ft-topbar title="点菜单" show-back="{{false}}" />

  <scroll-view
    scroll-y="true"
    class="main"
    show-scrollbar="false"
    scrollbar-hidden="true"
    enhanced="true"
    refresher-enabled
    refresher-triggered="{{refreshing}}"
    bindrefresherrefresh="onRefresh"
  >
    <view class="main-inner">
      <view class="state-card">
        <view class="state-left">
          <view class="state-chip">进行中订单</view>
          <view class="state-title">规划阶段</view>
          <view class="state-sub">状态：{{statusText}}</view>
        </view>
        <view class="avatar-stack" aria-hidden="true">
          <view class="avatar"></view>
          <view class="avatar"></view>
          <view class="avatar-more">+1</view>
        </view>
      </view>

      <view class="section">
        <view class="section-head">
          <view class="section-title">已选菜品</view>
          <view class="count-pill">{{orders.length}} 项</view>
        </view>
        <view class="dish-list {{listLoading ? 'ft-list-dim' : ''}}">
          <block wx:for="{{orders}}" wx:key="_id">
            <view class="dish-card" bindtap="onOrderTap" data-orderid="{{item._id}}">
              <view class="dish-img"></view>
              <view class="dish-mid">
                <view class="dish-name">{{item.orderName}}</view>
                <view class="dish-tags">
                  <view class="tag {{item.status==='completed' ? 'tag-completed' : (!item.recipeCount && item.status!=='completed' ? 'tag-pending' : 'tag-main')}}">{{!item.recipeCount && item.status!=='completed' ? '待点菜' : (item.status==='pending_cooking' ? '待制作' : (item.status==='pending_shopping' ? '待买菜' : '已完成'))}}</view>
                  <view class="tag tag-sub">进行中</view>
                </view>
              </view>
              <view class="dish-chev" aria-hidden="true">›</view>
            </view>
          </block>
          <view wx:if="{{!orders || orders.length===0}}" class="ft-empty">
            <view class="ft-ico ft-ico-list ft-ico-lg"></view>
            <view class="ft-empty-title">暂无点菜单</view>
            <view class="ft-empty-sub">先去首页挑选喜欢的菜谱吧</view>
            <view class="ft-btn ft-btn-primary ft-btn-sm" bindtap="onGoPick">去点菜</view>
          </view>
        </view>
      </view>

      <view class="collab-card">
        <view class="collab-title">
          <view class="ft-ico ft-ico-chat ft-ico-sm"></view>
          <text>协同规划</text>
        </view>
        <view class="collab-item">
          <view class="collab-avatar"></view>
          <view class="collab-text"><text class="collab-name">家庭成员</text> 刚刚更新了点菜单。</view>
        </view>
      </view>

      <view class="actions">
        <view class="ft-btn ft-btn-primary" bindtap="goFirstOrder">前往购物清单</view>
        <view class="ft-btn ft-btn-secondary" bindtap="goRecipeList">继续添加菜品</view>
      </view>
    </view>
  </scroll-view>
</view>
