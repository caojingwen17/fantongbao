.page{
  padding: 20rpx;
}
.p-card{
  padding: 22rpx;
}
.top{
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: flex-start;
  margin-bottom: 18rpx;
}
.family-title{
  font-size: 38rpx;
}
.family-sub{
  margin-top: 8rpx;
  font-size: 24rpx;
}
.new-btn{
  margin-left: 20rpx;
}
.tabs{
  display: flex;
  margin-bottom: 18rpx;
  padding: 10rpx;
  border-radius: var(--ft-r-full);
  gap: 10rpx;
}
.seg{
  flex: 1;
  height: 72rpx;
  border-radius: var(--ft-r-full);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 900;
  color: var(--ft-on-surface-variant);
}
.seg-on{
  background: linear-gradient(135deg, var(--ft-primary) 0%, var(--ft-primary-container) 100%);
  color: var(--ft-on-primary);
}
.list{
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.card{
  padding: 18rpx;
}
.card-top{
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.card-title{
  font-size: 30rpx;
  flex: 1;
}
.card-sub{
  margin-top: 8rpx;
  font-size: 22rpx;
}
.badge{
  font-size: 22rpx;
}
.empty{
  padding: 60rpx 0;
  text-align: center;
  color: rgba(0,0,0,0.35);
}

