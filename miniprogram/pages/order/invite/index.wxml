<view class="invite-page">
  <view class="invite-loading" wx:if="{{loading}}">
    <view class="invite-spinner"></view>
    <text>正在加载邀请…</text>
  </view>

  <view class="invite-error" wx:elif="{{errMsg}}">
    <view class="invite-error-title">无法加入点餐</view>
    <view class="invite-error-text">{{errMsg}}</view>
    <view class="invite-btn secondary" bindtap="goHome">回首页</view>
  </view>

  <view class="invite-main" wx:elif="{{joined}}">
    <view class="invite-icon">✓</view>
    <view class="invite-title">已加入家庭</view>
    <view class="invite-sub">正在进入「{{orderName}}」点菜页…</view>
  </view>

  <view class="invite-main" wx:else>
    <view class="invite-icon invite-icon-img">
      <view class="ft-ico ft-ico-list ft-ico-lg"></view>
    </view>
    <view class="invite-kicker">邀请点餐</view>
    <view class="invite-title">加入「{{familyName}}」一起点菜</view>
    <view class="invite-sub">点菜单：{{orderName}}</view>
    <view class="invite-warn">接受邀请将默认把你加入该家庭，加入后可一起点菜、查看家庭菜谱。</view>
    <view class="invite-btn {{joining ? 'disabled' : ''}}" bindtap="onConfirmJoin">
      {{joining ? "加入中…" : (needLogin ? "登录并加入" : "加入并开始点菜")}}
    </view>
    <view class="invite-btn secondary" bindtap="goHome">稍后再说</view>
  </view>
</view>
