/* Apricot Breeze tokens (V2 stitch) */

:root, page {
  /* surfaces */
  --ft-surface: #fff5ec;
  --ft-surface-container-low: #ffeedc;
  --ft-surface-container: #ffe4c4;
  --ft-surface-container-high: #ffddb3;
  --ft-surface-container-highest: #ffd6a2;
  --ft-surface-container-lowest: #ffffff;

  /* brand */
  --ft-primary: #874e00;
  --ft-primary-container: #ff9800;
  --ft-on-primary: #fff0e5;
  --ft-on-surface: #432900;
  --ft-on-surface-variant: #765524;
  --ft-outline-variant: rgba(208, 166, 109, 0.18);

  /* state */
  --ft-error: #b02500;
  --ft-error-bg: rgba(249, 86, 48, 0.16);
  --ft-success: #006b1b;
  --ft-success-bg: rgba(145, 247, 142, 0.25);

  /* radius */
  --ft-r: 16rpx;
  --ft-r-lg: 24rpx;
  --ft-r-xl: 36rpx;
  --ft-r-full: 9999rpx;
}

/* base */
.ft-page {
  background: var(--ft-surface);
  color: var(--ft-on-surface);
}

/* surfaces */
.ft-card {
  background: var(--ft-surface-container);
  border-radius: var(--ft-r-xl);
}
.ft-card-lowest {
  background: var(--ft-surface-container-lowest);
  border-radius: var(--ft-r-lg);
}
.ft-card-low {
  background: var(--ft-surface-container-low);
  border-radius: var(--ft-r-xl);
}
.ft-pill {
  border-radius: var(--ft-r-full);
}

/* text */
.ft-title {
  font-weight: 900;
  letter-spacing: 0.2rpx;
}
.ft-subtle {
  color: var(--ft-on-surface-variant);
  opacity: 0.9;
}
.ft-source {
  color: var(--ft-primary);
  font-style: italic;
}

/* buttons */
.ft-btn {
  box-sizing: border-box;
  border-radius: var(--ft-r-full);
  padding: 0 28rpx;
  height: 84rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 800;
  color: var(--ft-on-surface);
  background: var(--ft-surface-container-lowest);
}
.ft-btn-primary {
  color: var(--ft-on-primary);
  background: linear-gradient(135deg, var(--ft-primary) 0%, var(--ft-primary-container) 100%);
  box-shadow: 0 24rpx 48rpx rgba(67, 41, 0, 0.12);
}
.ft-btn-secondary {
  color: var(--ft-primary);
  background: var(--ft-surface-container-lowest);
  border: 1rpx solid var(--ft-outline-variant);
  box-shadow: none;
}
.ft-btn-danger {
  color: var(--ft-error);
  background: var(--ft-error-bg);
}
/* 页底主按钮（整宽） */
.ft-btn-block {
  width: 100%;
  height: 96rpx;
  font-size: 32rpx;
}
/* 行内小按钮 */
.ft-btn-sm {
  height: 64rpx;
  padding: 0 24rpx;
  font-size: 26rpx;
}
/* 文字按钮 */
.ft-btn-text {
  background: transparent;
  color: var(--ft-primary);
  height: auto;
  padding: 12rpx 16rpx;
  font-size: 26rpx;
}
/* 禁用态统一 */
.ft-btn.disabled,
.ft-btn-primary.disabled,
.ft-btn-secondary.disabled,
.ft-btn-danger.disabled {
  opacity: 0.45;
  pointer-events: none;
}

/* 底部固定操作栏（主流程页统一） */
.ft-bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  display: flex;
  gap: 20rpx;
  padding: 16rpx 40rpx calc(24rpx + constant(safe-area-inset-bottom));
  padding: 16rpx 40rpx calc(24rpx + env(safe-area-inset-bottom));
  background: linear-gradient(to top, var(--ft-surface) 70%, rgba(255, 245, 236, 0));
}
.ft-bottom-bar .ft-btn {
  flex: 1;
  height: 96rpx;
  font-size: 32rpx;
}

/* 统一空态 */
.ft-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 80rpx 40rpx;
  background: var(--ft-surface-container-lowest);
  border-radius: var(--ft-r-xl);
}
.ft-empty-title {
  font-size: 30rpx;
  font-weight: 900;
  color: var(--ft-on-surface);
}
.ft-empty-sub {
  font-size: 24rpx;
  color: var(--ft-on-surface-variant);
}

/* 通用按下反馈 */
.ft-tap {
  transition: transform 0.12s ease, opacity 0.12s ease;
}
.ft-tap:active {
  transform: scale(0.98);
  opacity: 0.9;
}

/* 骨架屏：模块加载中的占位（消除「暂无数据」闪烁） */
@keyframes ft-shimmer {
  0% { background-position: -400rpx 0; }
  100% { background-position: 400rpx 0; }
}
.ft-skeleton {
  border-radius: 24rpx;
  background: linear-gradient(
    90deg,
    var(--ft-surface-container-low, #ffeedc) 25%,
    var(--ft-surface-container-high, #ffddb3) 37%,
    var(--ft-surface-container-low, #ffeedc) 63%
  );
  background-size: 800rpx 100%;
  animation: ft-shimmer 1.2s linear infinite;
}

/* 菜谱图占位（未上传展示图时） */
.ft-img-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  box-sizing: border-box;
  border: 3rpx dashed var(--ft-outline-variant, rgba(208, 166, 109, 0.45));
  border-radius: inherit;
  background: var(--ft-surface-container-low, #ffeedc);
}
.ft-img-placeholder .ft-ico {
  opacity: 0.5;
}
.ft-img-placeholder-text {
  font-size: 22rpx;
  font-weight: 700;
  color: var(--ft-on-surface-variant, #765524);
  opacity: 0.85;
}

/* icon buttons */
.ft-icon-btn {
  width: 80rpx;
  height: 80rpx;
  border-radius: var(--ft-r-full);
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.6);
  color: var(--ft-primary);
}
.ft-icon-btn:active {
  transform: scale(0.96);
  opacity: 0.9;
}

/* inputs */
.ft-input {
  border: 1px solid var(--ft-outline-variant);
  border-radius: var(--ft-r-xl);
  background: var(--ft-surface-container-lowest);
  padding: 16rpx 18rpx;
  box-sizing: border-box;
}
.ft-textarea {
  border: 1px solid var(--ft-outline-variant);
  border-radius: var(--ft-r-xl);
  background: var(--ft-surface-container-lowest);
  padding: 16rpx 18rpx;
  box-sizing: border-box;
  width: 100%;
}

/* sections */
.ft-section-title {
  font-size: 32rpx;
  font-weight: 900;
}

/* badges */
.ft-badge {
  border-radius: var(--ft-r-full);
  padding: 8rpx 18rpx;
  font-size: 22rpx;
  font-weight: 900;
}
.ft-badge-success {
  color: var(--ft-success);
  background: var(--ft-success-bg);
}
.ft-badge-warn {
  color: var(--ft-primary);
  background: rgba(255, 152, 0, 0.18);
}
