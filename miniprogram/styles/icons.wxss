/* 统一 SVG 图标（data-uri，随主题色烘焙，替代 emoji） */

.ft-ico {
  display: inline-block;
  width: 40rpx;
  height: 40rpx;
  background-size: contain;
  background-repeat: no-repeat;
  background-position: center;
  flex-shrink: 0;
}
.ft-ico-sm { width: 28rpx; height: 28rpx; }
.ft-ico-lg { width: 72rpx; height: 72rpx; }

